PASS B1  [identity] actC A (actC B w) = actC (AB) w; actT A (actT B w) = actT (AB) w; actC A (actT B w) = actT B (actC A w)
PASS B2  [identity] actC M (prodState x y) = prodState (Mx) y; actT M (prodState x y) = prodState x (My)
PASS B3a  [identity] pairVal a b (actC M w) = pairVal (homMap(M)^T a) b w; pairVal a b (actT M w) = pairVal a (homMap(M)^T b) w
