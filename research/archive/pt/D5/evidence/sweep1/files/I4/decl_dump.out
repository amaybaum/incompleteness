SIG 793:     phaseQ i₀ ≠ heisQ Φ := by
=== QuasilocalCharacterization.lean:856 theorem quasilocal_characterization  HEADLINE
DOC 851: /-- **THE CHARACTERIZATION.** Any two systems of the target class are canonically isomorphic
DOC 852: compatibly with the stages, uniquely so; every consistent family of density matrices is a state
DOC 853: of every system; the canonical map intertwines the OI-induced dynamics, which preserves locality;
DOC 854: and the phase automorphism is a locality-preserving automorphism induced by no substratum
DOC 855: dynamics. -/
SIG 856: theorem quasilocal_characterization (S S' : QuasilocalSystem ι Q) (T : OISystem ι Q) :
SIG 857:     (∀ (Λ : Finset ι) (X : Matrix (Conf Λ Q) (Conf Λ Q) ℂ),
SIG 858:       systemEquiv S S' (S.st Λ X) = S'.st Λ X)
SIG 859:     ∧ (∀ g : S.A → S'.A, Continuous g →
SIG 860:         (∀ (Λ : Finset ι) (X : Matrix (Conf Λ Q) (Conf Λ Q) ℂ), g (S.st Λ X) = S'.st Λ X) →
SIG 861:         g = systemEquiv S S')
SIG 862:     ∧ (∀ (ρ : ∀ Λ : Finset ι, Matrix (Conf Λ Q) (Conf Λ Q) ℂ) (hρ : IsStateFamily ρ),
SIG 863:         IsState (systemState S hρ)
SIG 864:         ∧ ∀ (Λ : Finset ι) (X : Matrix (Conf Λ Q) (Conf Λ Q) ℂ),
SIG 865:           systemState S hρ (S.st Λ X) = (X * ρ Λ).trace)
SIG 866:     ∧ (∀ x : Quasilocal ι Q,
SIG 867:         canon T.toQuasilocalSystem (heisQ T.Φ x) = T.α (canon T.toQuasilocalSystem x))
SIG 868:     ∧ LocalityPreserving T.toQuasilocalSystem T.α
SIG 869:     ∧ (∀ i₀ : ι, LocalityPreserving (oiSystem (ι := ι) (Q := Q)) (phaseEquiv i₀))
SIG 870:     ∧ (∀ (i₀ : ι) (Φ : ReversibleDynamics ι Q), phaseQ i₀ ≠ heisQ Φ) :=
=== SecondOrderDrive.lean:88 theorem permOp_of_comp  HEADLINE
DOC 86: /-- **THE PERMUTATION OPERATOR IS COVARIANT.** If the dynamics `X` runs `S` and then `W` on
DOC 87: configurations, its permutation operator is the product in that same order. -/
SIG 88: theorem permOp_of_comp (h : X.φ = S.φ.trans W.φ) : permOp X = permOp W * permOp S := by
=== SecondOrderDrive.lean:96 theorem permOpInv_of_comp  HEADLINE
DOC 94: /-- **THE INVERSE PERMUTATION OPERATOR IS CONTRAVARIANT**, the inverse of a composite being the
DOC 95: composite of the inverses in the reverse order. -/
SIG 96: theorem permOpInv_of_comp (h : X.φ = S.φ.trans W.φ) : permOpInv X = permOpInv S * permOpInv W := by
=== SecondOrderDrive.lean:106 theorem heis_of_comp  HEADLINE
DOC 102: /-- **THE ORDER THEOREM.** If the dynamics runs `S` first and `W` second on configurations, then
DOC 103: its Heisenberg action runs `W`'s Heisenberg action first and `S`'s second. The two sandwiching
DOC 104: factors are covariant and contravariant respectively, and the reversal is what survives when they
DOC 105: are multiplied out. -/
SIG 106: theorem heis_of_comp (h : X.φ = S.φ.trans W.φ) (T : Module.End ℂ (Scaffold ι Q)) :
SIG 107:     heis X T = heis S (heis W T) := by
=== SecondOrderDrive.lean:112 theorem heisLoc_of_comp
DOC 111: /-- The order theorem on the local algebra. -/
SIG 112: theorem heisLoc_of_comp (h : X.φ = S.φ.trans W.φ) (a : localAlg ι Q) :
SIG 113:     heisLoc X a = heisLoc S (heisLoc W a) :=
=== SecondOrderDrive.lean:118 theorem heisQ_of_comp  HEADLINE
DOC 116: /-- **THE ORDER THEOREM ON THE QUASILOCAL ALGEBRA.** This is the statement a two-piece drive has to
DOC 117: match: the drive's outermost flow is the one whose configuration map runs *last*. -/
SIG 118: theorem heisQ_of_comp (h : X.φ = S.φ.trans W.φ) (x : Quasilocal ι Q) :
SIG 119:     heisQ X x = heisQ S (heisQ W x) := by
