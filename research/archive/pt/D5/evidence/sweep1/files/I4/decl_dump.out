SIG 596:     swapQ V 1 x = heisQ (swapDyn V) x := by
=== SecondOrderDrive.lean:620 def shearOnRegion  HEADLINE
DOC 618: /-- **THE SHEAR AT EVERY SITE OF A SET, COMPUTED INSIDE A REGION.** `gateOn` is the case of a
DOC 619: single site; this is what a finite product of gates amounts to, written as one map. -/
SIG 620: noncomputable def shearOnRegion (A : Finset ι) (x : Conf S (V × V)) : Conf S (V × V) :=
SIG 621:   fun u => if (u : ι) ∈ A then (rhs R S (u : ι) x - (x u).1, (x u).2) else x u
=== SecondOrderDrive.lean:625 theorem shearOnRegion_apply
SIG 625: theorem shearOnRegion_apply (A : Finset ι) (x : Conf S (V × V)) (u : ↥S) :
SIG 626:     shearOnRegion R S A x u
SIG 627:       = if (u : ι) ∈ A then (rhs R S (u : ι) x - (x u).1, (x u).2) else x u := rfl
=== SecondOrderDrive.lean:630 theorem curOn_shearOnRegion  HEADLINE
DOC 629: /-- **THE SET SHEAR DOES NOT TOUCH THE CURRENT SLICE** either. -/
SIG 630: theorem curOn_shearOnRegion (A : Finset ι) (x : Conf S (V × V)) :
SIG 631:     curOn S (shearOnRegion R S A x) = curOn S x := by
=== SecondOrderDrive.lean:641 theorem rhs_shearOnRegion
SIG 641: theorem rhs_shearOnRegion (A : Finset ι) (i : ι) (x : Conf S (V × V)) :
SIG 642:     rhs R S i (shearOnRegion R S A x) = rhs R S i x := by
=== SecondOrderDrive.lean:645 theorem shearOnRegion_involutive
SIG 645: theorem shearOnRegion_involutive (A : Finset ι) (x : Conf S (V × V)) :
SIG 646:     shearOnRegion R S A (shearOnRegion R S A x) = x := by
=== SecondOrderDrive.lean:657 def shearPerm
DOC 656: /-- The set shear as a permutation of the region's configurations. -/
SIG 657: noncomputable def shearPerm (A : Finset ι) : Conf S (V × V) ≃ Conf S (V × V) where
SIG 658:   toFun := shearOnRegion R S A
SIG 659:   invFun := shearOnRegion R S A
SIG 660:   left_inv := shearOnRegion_involutive A
SIG 661:   right_inv := shearOnRegion_involutive A
=== SecondOrderDrive.lean:665 theorem shearPerm_symm
SIG 665: theorem shearPerm_symm (A : Finset ι) : (shearPerm R S A).symm = shearPerm R S A := rfl
=== SecondOrderDrive.lean:667 theorem shearPerm_empty
SIG 667: theorem shearPerm_empty : shearPerm R S (∅ : Finset ι) = Equiv.refl _ := by
=== SecondOrderDrive.lean:674 theorem gateOn_shearOnRegion  HEADLINE
DOC 672: /-- **ADDING ONE SITE TO THE SET IS APPLYING THAT SITE'S GATE.** The gate reads only current
DOC 673: components, which the set shear leaves alone, so the two compose without interference. -/
SIG 674: theorem gateOn_shearOnRegion {A : Finset ι} {a : ι} (ha : a ∉ A) (x : Conf S (V × V)) :
SIG 675:     gateOn R S a (shearOnRegion R S A x) = shearOnRegion R S (insert a A) x := by
=== SecondOrderDrive.lean:690 theorem gateEquiv_trans_shearPerm
SIG 690: theorem gateEquiv_trans_shearPerm {A : Finset ι} {a : ι} (ha : a ∉ A) :
SIG 691:     (shearPerm R S A).trans (gateEquiv R S a) = shearPerm R S (insert a A) :=
=== SecondOrderDrive.lean:697 theorem layerU_one_eq_qGate  HEADLINE
DOC 694: /-- **THE LAYER'S TIME-ONE UNITARY IS ONE REGION'S PERMUTATION MATRIX.** The finite product of the
DOC 695: gates over `A` collapses into the permutation matrix of the shear at every site of `A`, read on any
DOC 696: region containing all those gates' regions. -/
SIG 697: theorem layerU_one_eq_qGate (A : Finset ι) :
SIG 698:     (∀ i ∈ A, gateRegion R i ⊆ S) → layerU R A 1 = qGate S (shearPerm R S A) := by
=== SecondOrderDrive.lean:715 theorem rhs_glob  HEADLINE
DOC 713: /-- **THE VALUE THE RULE WRITES IS THE SAME COMPUTED IN THE REGION OR GLOBALLY**, provided the
DOC 714: region carries the gate's own region. -/
SIG 715: theorem rhs_glob {i : ι} (hi : gateRegion R i ⊆ S) (t : ι → V × V) :
SIG 716:     rhs R S i (glob S t) = R.F (curOf t) i := by
=== SecondOrderDrive.lean:722 theorem localConf_shearPerm_of_mem
SIG 722: theorem localConf_shearPerm_of_mem {A : Finset ι} {i : ι} (hi : i ∈ A) (hiS : i ∈ S)
SIG 723:     (t : ι → V × V) :
SIG 724:     localConf S (shearPerm R S A) t i = (rhs R S i (glob S t) - (t i).1, (t i).2) := by
=== SecondOrderDrive.lean:730 theorem localConf_shearPerm_of_not_mem
SIG 730: theorem localConf_shearPerm_of_not_mem {A : Finset ι} {i : ι} (hi : i ∉ A) (t : ι → V × V) :
SIG 731:     localConf S (shearPerm R S A) t i = t i := by
=== SecondOrderDrive.lean:745 theorem heis_shearDyn_emb  HEADLINE
DOC 741: /-- **THE SHEAR LAYER'S HEISENBERG ACTION IS LOCAL CONJUGATION ON EVERY REGION.** The
DOC 742: region-supported replacement shears at every site of `affected R Λ`, not only of `Λ`: a gate whose
DOC 743: neighbourhood meets `Λ` does not commute with `Λ`'s observables. The off-region agreement matches
DOC 744: in both directions because a site outside the affected set has a gate region disjoint from `Λ`. -/
SIG 745: theorem heis_shearDyn_emb (Λ : Finset ι) (X : Matrix (Conf Λ (V × V)) (Conf Λ (V × V)) ℂ) :
SIG 746:     heis (shearDyn R) (emb Λ X)
SIG 747:       = heis (localDyn (gateSpan R (affected R Λ))
SIG 748:           (shearPerm R (gateSpan R (affected R Λ)) (affected R Λ))) (emb Λ X) := by
=== SecondOrderDrive.lean:804 theorem layerQ_one_eq_heisQ  HEADLINE
DOC 803: /-- **THE SHEAR LAYER'S ENDPOINT.** -/
SIG 804: theorem layerQ_one_eq_heisQ (x : Quasilocal ι (V × V)) :
SIG 805:     layerQ R 1 x = heisQ (shearDyn R) x := by
=== SecondOrderDrive.lean:829 theorem driveQ_one_eq_heisQ  HEADLINE
DOC 825: /-- **THE DRIVE ENDS AT THE UPDATE.** The two-piece path at time one is exactly the Heisenberg
DOC 826: action of the update's own reversible dynamics on the quasilocal algebra. With `driveQ_zero_time`
DOC 827: this says the update is joined to the identity by a norm-continuous path of `*`-automorphisms —
DOC 828: still not a one-parameter group, and still with no generator exhibited. -/
SIG 829: theorem driveQ_one_eq_heisQ (x : Quasilocal ι (V × V)) :
SIG 830:     driveQ R 1 x = heisQ (ruleDynamics R) x := by
=== JordanClassification.lean:74 theorem trace_mul_vecMulVec
DOC 73: /-- The trace against a rank-one dyad is the quadratic form. -/
SIG 74: theorem trace_mul_vecMulVec (A : Matrix n n ℂ) (v : n → ℂ) :
SIG 75:     Matrix.trace (A * Matrix.vecMulVec v (star v)) = star v ⬝ᵥ (A *ᵥ v) := by
=== JordanClassification.lean:84 theorem psd_iff_trace_nonneg  HEADLINE
DOC 81: /-- **Self-duality of the PSD cone**: a Hermitian matrix pairing nonnegatively with
DOC 82: every positive matrix is positive — test against the rank-one dyads. Together with
DOC 83: `psd_trace_mul_nonneg` this is the exact two-sided duality the assembly consumes. -/
SIG 84: theorem psd_iff_trace_nonneg {A : Matrix n n ℂ} (hAh : A.IsHermitian) :
SIG 85:     A.PosSemidef ↔ ∀ X : Matrix n n ℂ, X.PosSemidef → 0 ≤ Matrix.trace (A * X) := by
