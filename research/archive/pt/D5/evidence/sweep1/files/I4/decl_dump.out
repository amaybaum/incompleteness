=== QuasilocalCharacterization.lean:113 theorem kerOf_emb_mul_emb_of_disjoint
DOC 112: /-- The kernel of a product of observables of disjoint regions. -/
SIG 113: theorem kerOf_emb_mul_emb_of_disjoint {Λ Λ' : Finset ι} (hd : Disjoint Λ Λ')
SIG 114:     (X : Matrix (Conf Λ Q) (Conf Λ Q) ℂ) (Y : Matrix (Conf Λ' Q) (Conf Λ' Q) ℂ) (t s : ι → Q) :
SIG 115:     kerOf (emb Λ X * emb Λ' Y) t s
SIG 116:       = if AgreeOffG (Λ ∪ Λ') t s
SIG 117:           then X (glob Λ t) (glob Λ s) * Y (glob Λ' t) (glob Λ' s) else 0 := by
