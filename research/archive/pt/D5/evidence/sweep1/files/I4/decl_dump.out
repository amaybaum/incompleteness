=== PassiveQuotient.lean:410 theorem quotMeasure_branch
DOC 409: /-- The pushforward commutes with visible branch selection. -/
SIG 410: theorem quotMeasure_branch (φ : Equiv.Perm S) (vis : S → I) (i : I) (μ : S → ℝ) :
SIG 411:     quotMeasure φ vis (fun s => if vis s = i then μ s else 0)
SIG 412:       = fun q => if quotVis φ vis q = i then quotMeasure φ vis μ q else 0 := by
=== PassiveQuotient.lean:432 theorem quotient_transitive
DOC 431: /-- Transitivity descends to the quotient. -/
SIG 432: theorem quotient_transitive (φ : Equiv.Perm S) (vis : S → I)
SIG 433:     (htrans : ∀ s t : S, ∃ k : ℕ, (φ ^ k) s = t) :
SIG 434:     ∀ q1 q2 : MinimalCarrier φ vis, ∃ k : ℕ, (quotPerm φ vis ^ k) q1 = q2 := by
=== PassiveQuotient.lean:444 theorem passiveQuotient_glue_forces_G1  HEADLINE
DOC 441: /-- **THE CAPSTONE, HALF ONE.** On the canonical minimal passive carrier, the
DOC 442: domain-relative glue alone forces the full diagonal-sector glue — no separation
DOC 443: hypothesis remains, because the carrier is separating by construction. -/
SIG 444: theorem passiveQuotient_glue_forces_G1
SIG 445:     (φ : Equiv.Perm S) (vis : S → I)
SIG 446:     (U : Matrix (MinimalCarrier φ vis) (MinimalCarrier φ vis) ℂ)
SIG 447:     (hglue : CompatibilityDomainGlue U (quotPerm φ vis)
SIG 448:       {w | ClassicalBranchDomain (quotPerm φ vis) (quotVis φ vis) w}) :
SIG 449:     DiagonalSectorGlue U (quotPerm φ vis) :=
=== PassiveQuotient.lean:456 theorem passiveQuotient_glue_forces_monomial  HEADLINE
DOC 454: /-- **THE CAPSTONE, HALF TWO.** On the minimal passive carrier the glue-compatible
DOC 455: sampled dynamics is a phased permutation. -/
SIG 456: theorem passiveQuotient_glue_forces_monomial
SIG 457:     (φ : Equiv.Perm S) (vis : S → I)
SIG 458:     (U : Matrix (MinimalCarrier φ vis) (MinimalCarrier φ vis) ℂ)
SIG 459:     (hglue : CompatibilityDomainGlue U (quotPerm φ vis)
SIG 460:       {w | ClassicalBranchDomain (quotPerm φ vis) (quotVis φ vis) w}) :
SIG 461:     ∃ d : MinimalCarrier φ vis → ℂ, (∀ x, d x * conj' (d x) = 1)
SIG 462:       ∧ U = Matrix.diagonal d * permMatrix (quotPerm φ vis) :=
=== PassiveQuotient.lean:470 theorem ergodicShell_SRC_of_passiveQuotient  HEADLINE
DOC 467: /-- **THE FULL CAPSTONE.** On the minimal passive carrier of an ergodic shell, OI
DOC 468: compatibility — the domain glue on the classical branch domain — closes physical-flow
DOC 469: SRC with the canonical carrier, existence and uniqueness, with no separation premise. -/
SIG 470: theorem ergodicShell_SRC_of_passiveQuotient [Nonempty S]
SIG 471:     (φ : Equiv.Perm S) (vis : S → I)
SIG 472:     (U : Matrix (MinimalCarrier φ vis) (MinimalCarrier φ vis) ℂ)
SIG 473:     (htrans : ∀ s t : S, ∃ k : ℕ, (φ ^ k) s = t)
SIG 474:     (hglue : CompatibilityDomainGlue U (quotPerm φ vis)
SIG 475:       {w | ClassicalBranchDomain (quotPerm φ vis) (quotVis φ vis) w}) :
SIG 476:     (∃ ρ : Matrix (MinimalCarrier φ vis) (MinimalCarrier φ vis) ℂ,
SIG 477:         ρ.PosSemidef ∧ Matrix.trace ρ = 1
SIG 478:         ∧ U * ρ * Uᴴ = ρ
SIG 479:         ∧ ∀ i, Matrix.trace (fiberProj (quotVis φ vis) i * ρ)
SIG 480:             = ((countMarginal (quotVis φ vis) i : ℝ) : ℂ))
SIG 481:     ∧ ∀ ρ : Matrix (MinimalCarrier φ vis) (MinimalCarrier φ vis) ℂ,
SIG 482:         ρ.PosSemidef → Matrix.trace ρ = 1
SIG 483:         → U * ρ * Uᴴ = ρ
SIG 484:         → ∀ i, Matrix.trace (fiberProj (quotVis φ vis) i * ρ)
SIG 485:             = ((countMarginal (quotVis φ vis) i : ℝ) : ℂ) :=
=== PassiveQuotient.lean:498 def hiddenExt
DOC 495: /-- The hidden-fibre extension: attach a fibre `A` with arbitrary per-state fibre
DOC 496: dynamics `σ`, leaving the visible labelling blind to it. This is the enlargement the
DOC 497: corpus explicitly permits. -/
SIG 498: def hiddenExt (φ : Equiv.Perm S) (σ : S → Equiv.Perm A) : Equiv.Perm (S × A) where
SIG 499:   toFun p := (φ p.1, σ p.1 p.2)
SIG 500:   invFun p := (φ.symm p.1, (σ (φ.symm p.1)).symm p.2)
SIG 501:   left_inv p := by
SIG 502:     obtain ⟨s, a⟩ := p
SIG 503:     show (φ.symm (φ s), (σ (φ.symm (φ s))).symm (σ s a)) = (s, a)
SIG 504:     rw [Equiv.symm_apply_apply, Equiv.symm_apply_apply]
SIG 505:   right_inv p := by
SIG 506:     obtain ⟨s, a⟩ := p
SIG 507:     show (φ (φ.symm s), σ (φ.symm s) ((σ (φ.symm s)).symm a)) = (s, a)
SIG 508:     rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
=== PassiveQuotient.lean:512 theorem hiddenExt_pow_fst
DOC 511: /-- The extension projects onto the base dynamics. -/
SIG 512: theorem hiddenExt_pow_fst (φ : Equiv.Perm S) (σ : S → Equiv.Perm A) (k : ℕ)
SIG 513:     (p : S × A) : (((hiddenExt φ σ) ^ k) p).1 = (φ ^ k) p.1 := by
=== PassiveQuotient.lean:523 theorem hiddenExt_itiRelInf_fibre
DOC 521: /-- Every hidden fibre is glued: states differing only in the hidden coordinate have
DOC 522: identical visible itineraries. -/
SIG 523: theorem hiddenExt_itiRelInf_fibre (φ : Equiv.Perm S) (vis : S → I)
SIG 524:     (σ : S → Equiv.Perm A) (s : S) (a b : A) :
SIG 525:     itiRelInf (hiddenExt φ σ) (fun p => vis p.1) (s, a) (s, b) := by
=== PassiveQuotient.lean:534 theorem hiddenExt_not_separating  HEADLINE
DOC 532: /-- **RAW-CARRIER SEPARATION IS NOT DERIVABLE.** Any carrier extends, by an
DOC 533: observationally inert hidden fibre, to a carrier that is NOT itinerary-separating. -/
SIG 534: theorem hiddenExt_not_separating [Nonempty S] (φ : Equiv.Perm S) (vis : S → I)
SIG 535:     (σ : S → Equiv.Perm A) (hA : ∃ a b : A, a ≠ b) :
SIG 536:     ¬ItinerarySeparating (hiddenExt φ σ) (fun p => vis p.1) := by
=== PassiveQuotient.lean:545 theorem hiddenExt_itiIndicator
DOC 544: /-- The itinerary indicator of the extension reads only the base coordinate. -/
SIG 545: theorem hiddenExt_itiIndicator (φ : Equiv.Perm S) (vis : S → I)
SIG 546:     (σ : S → Equiv.Perm A) (T : ℕ) (c : ℕ → I) (p : S × A) :
SIG 547:     itiIndicator (hiddenExt φ σ) (fun p => vis p.1) T c p
SIG 548:       = itiIndicator φ vis T c p.1 := by
=== PassiveQuotient.lean:563 theorem hiddenExt_same_law  HEADLINE
DOC 560: /-- **THE PASSIVE LAW CANNOT SEE THE FIBRE.** For every prior on the extension with the
DOC 561: right base marginal, every finite visible trajectory probability agrees with the base —
DOC 562: the entire closed passive law is preserved while separation fails. -/
SIG 563: theorem hiddenExt_same_law [Fintype A] (φ : Equiv.Perm S) (vis : S → I)
SIG 564:     (σ : S → Equiv.Perm A) (ν : S × A → ℝ) (μ : S → ℝ)
SIG 565:     (hmarg : ∀ s, ∑ a, ν (s, a) = μ s) (T : ℕ) (c : ℕ → I) :
SIG 566:     trajProb (hiddenExt φ σ) (fun p => vis p.1) T c ν = trajProb φ vis T c μ := by
=== PassiveQuotient.lean:577 theorem hiddenExt_quotient_recovers_base
DOC 575: /-- The quotient strips exactly the hidden fibre: when the base is separating, the
DOC 576: minimal carrier of the extension is canonically the base carrier. -/
SIG 577: theorem hiddenExt_quotient_recovers_base [Fintype A] [DecidableEq A] [Nonempty A]
SIG 578:     (φ : Equiv.Perm S) (vis : S → I) (σ : S → Equiv.Perm A)
SIG 579:     (hsep : ItinerarySeparating φ vis) :
SIG 580:     Function.Bijective (realizationMap (hiddenExt φ σ) (fun p => vis p.1) φ vis
SIG 581:       Prod.fst (fun _ => rfl) (fun _ => rfl) hsep) :=
=== PassiveQuotient.lean:596 theorem addEquiv_pow_sub
DOC 594: /-- Powers of the permutation underlying an additive automorphism are additive:
DOC 595: subtraction passes through every iterate. -/
SIG 596: theorem addEquiv_pow_sub (step : M ≃+ M) (k : ℕ) (x y : M) :
SIG 597:     (step.toEquiv ^ k) (x - y) = (step.toEquiv ^ k) x - (step.toEquiv ^ k) y := by
=== PassiveQuotient.lean:611 theorem linear_itiRelInf_iff  HEADLINE
DOC 607: /-- **ITINERARY EQUIVALENCE IS THE UNOBSERVABLE COSET.** For linear passive dynamics
DOC 608: read through an additive map, two states share a visible itinerary exactly when their
DOC 609: difference lies in the unobservable subgroup — the joint kernel of the stacked readout
DOC 610: family. -/
SIG 611: theorem linear_itiRelInf_iff (step : M ≃+ M) (read : M →+ W) (x y : M) :
SIG 612:     itiRelInf step.toEquiv (⇑read) x y
SIG 613:       ↔ ∀ k : ℕ, read ((step.toEquiv ^ k) (x - y)) = 0 := by
=== PassiveQuotient.lean:627 theorem linear_separating_iff_observability  HEADLINE
DOC 623: /-- **ITINERARY SEPARATION IS CLASSICAL OBSERVABILITY.** The linear passive cut is
DOC 624: itinerary-separating exactly when the stacked readout family `x ↦ (C x, C A x, …)` has
DOC 625: trivial kernel — the Kalman observability condition, exactly as the SM reference
DOC 626: branch's component-complete site observer poses it. -/
SIG 627: theorem linear_separating_iff_observability (step : M ≃+ M) (read : M →+ W) :
SIG 628:     ItinerarySeparating step.toEquiv (⇑read)
SIG 629:       ↔ ∀ x : M, (∀ k : ℕ, read ((step.toEquiv ^ k) x) = 0) → x = 0 := by

