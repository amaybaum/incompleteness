DOC 255: determined — no state-side gauge survives the two-slot data. -/
SIG 256: theorem sameData_unique_state {n ι' : Type*} [Fintype n] [DecidableEq n]
SIG 257:     (V : Matrix n (Fin Dm) ℂ) (E : Fin Dm → ℝ) (A : ι' → Matrix n n ℂ)
SIG 258:     (ρ σ : Matrix n n ℂ) (hV : V * Vᴴ = 1) (hV' : Vᴴ * V = 1)
SIG 259:     (hgap : ∀ a b c d : Fin Dm, a ≠ b → c ≠ d → E b - E a = E d - E c → a = c ∧ b = d)
SIG 260:     (hcomplete : ∀ a b : Fin Dm, a ≠ b → ∃ j, (Vᴴ * A j * V) a b ≠ 0)
SIG 261:     (htr : Matrix.trace ρ = Matrix.trace σ)
SIG 262:     (h1 : ∀ (j : ι') (t : ℝ),
SIG 263:       Matrix.trace (Matrix.of (BohrFrequency.Umat V E t) * A j
SIG 264:         * (Matrix.of (BohrFrequency.Umat V E t))ᴴ * ρ)
SIG 265:       = Matrix.trace (Matrix.of (BohrFrequency.Umat V E t) * A j
SIG 266:         * (Matrix.of (BohrFrequency.Umat V E t))ᴴ * σ))
SIG 267:     (h2 : ∀ (j k : ι') (t s : ℝ),
SIG 268:       Matrix.trace (Matrix.of (BohrFrequency.Umat V E t) * A j
SIG 269:         * (Matrix.of (BohrFrequency.Umat V E t))ᴴ
SIG 270:         * (Matrix.of (BohrFrequency.Umat V E s) * A k
SIG 271:           * (Matrix.of (BohrFrequency.Umat V E s))ᴴ * ρ))
SIG 272:       = Matrix.trace (Matrix.of (BohrFrequency.Umat V E t) * A j
SIG 273:         * (Matrix.of (BohrFrequency.Umat V E t))ᴴ
SIG 274:         * (Matrix.of (BohrFrequency.Umat V E s) * A k
SIG 275:           * (Matrix.of (BohrFrequency.Umat V E s))ᴴ * σ))) :
SIG 276:     ρ = σ := by
