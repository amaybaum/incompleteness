=== CarrierGeneralOIPlus.lean:110 def ReversibleRichness  HEADLINE
DOC 109: /-- **REVERSIBLE RICHNESS** on a carrier `A`. -/
SIG 110: def ReversibleRichness : Prop :=
SIG 111:   (∀ (n : ℕ) (V : Matrix (A × Fin n) (A × Fin n) ℂ),
SIG 112:     T.availExt n Unit (fun _ => conjChannel V) → T.availExt n Unit (fun _ => conjChannel Vᴴ))
SIG 113:   ∧ ∀ n : ℕ, ∃ (G : Type) (H : Matrix (A × Fin n) (A × Fin n) ℂ)
SIG 114:       (U : G → Matrix (A × Fin n) (A × Fin n) ℂ),
SIG 115:       Hᴴ = H ∧ (∀ g, (U g)ᴴ * U g = 1) ∧ HControl H U
SIG 116:         ∧ (∀ t : ℝ, T.availExt n Unit (fun _ => conjChannel (flow H t)))
SIG 117:         ∧ (∀ g, T.availExt n Unit (fun _ => conjChannel (U g)))
