=== SecondOrderDrive.lean:392 def localEquiv
DOC 391: /-- The region-supported map as an equivalence of global configurations. -/
SIG 392: def localEquiv : (ι → Q) ≃ (ι → Q) where
SIG 393:   toFun := localConf Λ σ
SIG 394:   invFun := localConf Λ σ.symm
SIG 395:   left_inv _ := localConf_localConf _
SIG 396:   right_inv s := by
SIG 397:     have h := localConf_localConf (Λ := Λ) (σ := σ.symm) s
SIG 398:     rwa [Equiv.symm_symm] at h
=== SecondOrderDrive.lean:402 def localFiniteRange  HEADLINE
DOC 400: /-- **A REGION-SUPPORTED MAP HAS FINITE RANGE**, both cones being the region itself at the sites
DOC 401: it touches and singletons elsewhere. -/
SIG 402: def localFiniteRange : FiniteRange (localConf Λ σ) where
SIG 403:   nbhd i := if i ∈ Λ then Λ else {i}
SIG 404:   local_dep i := by
SIG 405:     intro s s' h
SIG 406:     show localConf Λ σ s i = localConf Λ σ s' i
SIG 407:     by_cases hi : i ∈ Λ
SIG 408:     · rw [if_pos hi] at h
SIG 409:       have hg : glob Λ s = glob Λ s' := funext fun u => h u.1 u.2
SIG 410:       rw [localConf_apply_of_mem hi, localConf_apply_of_mem hi, hg]
SIG 411:     · rw [if_neg hi] at h
SIG 412:       rw [localConf_apply_of_not_mem hi, localConf_apply_of_not_mem hi,
SIG 413:         h i (Finset.mem_singleton_self i)]
SIG 414:   infl i := if i ∈ Λ then Λ else {i}
SIG 415:   mem_infl i j hij := by
SIG 416:     by_cases hj : j ∈ Λ
SIG 417:     · rw [if_pos hj] at hij
SIG 418:       rw [if_pos hij]
SIG 419:       exact hj
SIG 420:     · rw [if_neg hj, Finset.mem_singleton] at hij
SIG 421:       subst hij
SIG 422:       rw [if_neg hj]
SIG 423:       exact Finset.mem_singleton_self _
=== SecondOrderDrive.lean:426 def localDyn  HEADLINE
