=== PassiveQuotient.lean:168 def quotPerm  HEADLINE
DOC 166: /-- **The dynamics descends to a permutation** of the minimal carrier: both the forward
DOC 167: and the backward step respect `∼_∞`. -/
SIG 168: def quotPerm (φ : Equiv.Perm S) (vis : S → I) : Equiv.Perm (MinimalCarrier φ vis) where
SIG 169:   toFun := Quotient.lift (fun s => Quotient.mk (itiSetoid φ vis) (φ s))
SIG 170:     fun _ _ h => Quotient.sound (itiRelInf_evolve h)
SIG 171:   invFun := Quotient.lift (fun s => Quotient.mk (itiSetoid φ vis) (φ.symm s))
SIG 172:     fun _ _ h => Quotient.sound (itiRelInf_symm_evolve h)
SIG 173:   left_inv := fun q => by
SIG 174:     obtain ⟨s⟩ := q
SIG 175:     show Quotient.mk (itiSetoid φ vis) (φ.symm (φ s)) = Quotient.mk (itiSetoid φ vis) s
SIG 176:     rw [Equiv.symm_apply_apply]
SIG 177:   right_inv := fun q => by
SIG 178:     obtain ⟨s⟩ := q
SIG 179:     show Quotient.mk (itiSetoid φ vis) (φ (φ.symm s)) = Quotient.mk (itiSetoid φ vis) s
SIG 180:     rw [Equiv.apply_symm_apply]
