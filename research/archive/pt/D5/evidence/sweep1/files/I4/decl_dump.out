DOC 289: /-- **THE POSITIVE ORBIT SPAN AS A LIE SUBALGEBRA.** -/
SIG 290: noncomputable def posLie [Nonempty S] (H : Matrix S S ℂ) (U : G → Matrix S S ℂ) (hH : Hᴴ = H) :
SIG 291:     LieSubalgebra ℝ (Matrix S S ℂ) :=
SIG 292:   { posSpan H U with
SIG 293:     lie_mem' := fun {X Y} hX hY => by
SIG 294:       show X * Y - Y * X ∈ posSpan H U
SIG 295:       induction hX using Submodule.span_induction with
SIG 296:       | mem X hX => exact bracket_mem_posSpan hH hX hY
SIG 297:       | zero => simp
SIG 298:       | add X₁ X₂ _ _ h1 h2 =>
SIG 299:         have := Submodule.add_mem _ h1 h2
SIG 300:         convert this using 1
SIG 301:         noncomm_ring
SIG 302:       | smul a X _ h =>
SIG 303:         have := Submodule.smul_mem _ a h
SIG 304:         convert this using 1
SIG 305:         rw [Matrix.smul_mul, Matrix.mul_smul, smul_sub] }
