=== JordanClassification.lean:128 theorem Eu_ne_zero
SIG 128: theorem Eu_ne_zero (i j : n) : Eu i j ≠ 0 := by
=== JordanClassification.lean:136 theorem herm_decomp
DOC 135: /-- Every matrix splits into Hermitian real and imaginary parts. -/
SIG 136: theorem herm_decomp (A : Matrix n n ℂ) :
SIG 137:     ∃ H K : Matrix n n ℂ, H.IsHermitian ∧ K.IsHermitian ∧ A = H + Complex.I • K := by
=== JordanClassification.lean:160 theorem jordan_complexify  HEADLINE
DOC 157: /-- **Complexification of the Jordan identity**: a ℂ-linear map satisfying the Jordan
DOC 158: identity on Hermitian pairs satisfies it on ALL pairs, by Hermitian decomposition and
DOC 159: bilinearity of the anticommutator. -/
SIG 160: theorem jordan_complexify (Φ : Matrix n n ℂ →ₗ[ℂ] Matrix n n ℂ)
SIG 161:     (h : ∀ A B : Matrix n n ℂ, A.IsHermitian → B.IsHermitian →
SIG 162:       Φ (A * B + B * A) = Φ A * Φ B + Φ B * Φ A)
SIG 163:     (A B : Matrix n n ℂ) :
SIG 164:     Φ (A * B + B * A) = Φ A * Φ B + Φ B * Φ A := by
=== JordanClassification.lean:186 theorem jordan_sq
DOC 185: /-- The Jordan identity preserves squares. -/
SIG 186: theorem jordan_sq (Φ : Matrix n n ℂ →ₗ[ℂ] Matrix n n ℂ)
SIG 187:     (hj : ∀ A B : Matrix n n ℂ, Φ (A * B + B * A) = Φ A * Φ B + Φ B * Φ A)
SIG 188:     (A : Matrix n n ℂ) : Φ (A * A) = Φ A * Φ A := by
=== JordanClassification.lean:198 theorem proj_anticommute
DOC 197: /-- Idempotents with vanishing anticommutator have vanishing products. -/
SIG 198: theorem proj_anticommute {p q : Matrix n n ℂ} (hp : p * p = p) (_hq : q * q = q)
SIG 199:     (h : p * q + q * p = 0) : p * q = 0 := by
=== JordanClassification.lean:217 theorem image_diag_proj
DOC 216: /-- The images of the diagonal units: Hermitian projections. -/
SIG 217: theorem image_diag_proj (Φ : Matrix n n ℂ →ₗ[ℂ] Matrix n n ℂ)
SIG 218:     (hstar : ∀ X : Matrix n n ℂ, Φ Xᴴ = (Φ X)ᴴ)
