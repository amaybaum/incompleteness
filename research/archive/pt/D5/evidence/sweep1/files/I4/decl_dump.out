=== ReferenceExtension.lean:422 def withSpectator  HEADLINE
DOC 420: /-- **AN OPERATION WITH AN UNTOUCHED SPECTATOR APPENDED**, carried back to the theory's own
DOC 421: carriers by an explicit reindexing `e`. -/
SIG 422: def withSpectator (R : Type*) [Fintype R] [DecidableEq R] {n m : ℕ}
SIG 423:     (e : R × (A × Fin n) ≃ A × Fin m)
SIG 424:     (Φ : Matrix (A × Fin n) (A × Fin n) ℂ →ₗ[ℂ] Matrix (A × Fin n) (A × Fin n) ℂ) :
SIG 425:     Matrix (A × Fin m) (A × Fin m) ℂ →ₗ[ℂ] Matrix (A × Fin m) (A × Fin m) ℂ :=
SIG 426:   (Matrix.reindexLinearEquiv ℂ ℂ e e).toLinearMap ∘ₗ amplRefL R Φ
SIG 427:     ∘ₗ (Matrix.reindexLinearEquiv ℂ ℂ e.symm e.symm).toLinearMap
=== ReferenceExtension.lean:429 theorem withSpectator_apply
SIG 429: theorem withSpectator_apply (R : Type*) [Fintype R] [DecidableEq R] {n m : ℕ}
SIG 430:     (e : R × (A × Fin n) ≃ A × Fin m)
SIG 431:     (Φ : Matrix (A × Fin n) (A × Fin n) ℂ →ₗ[ℂ] Matrix (A × Fin n) (A × Fin n) ℂ)
SIG 432:     (N : Matrix (A × Fin m) (A × Fin m) ℂ) :
SIG 433:     withSpectator R e Φ N = Matrix.reindex e e (amplRef R Φ (Matrix.reindex e.symm e.symm N)) :=
=== ReferenceExtension.lean:437 theorem withSpectator_reindex
DOC 436: /-- On a reindexed input the spectator extension is the reindexed amplification. -/
SIG 437: theorem withSpectator_reindex (R : Type*) [Fintype R] [DecidableEq R] {n m : ℕ}
SIG 438:     (e : R × (A × Fin n) ≃ A × Fin m)
SIG 439:     (Φ : Matrix (A × Fin n) (A × Fin n) ℂ →ₗ[ℂ] Matrix (A × Fin n) (A × Fin n) ℂ)
SIG 440:     (X : Matrix (R × (A × Fin n)) (R × (A × Fin n)) ℂ) :
SIG 441:     withSpectator R e Φ (Matrix.reindex e e X) = Matrix.reindex e e (amplRef R Φ X) := by
=== ReferenceExtension.lean:447 def HasParallelReferenceExtension  HEADLINE
DOC 444: /-- **PARALLEL REFERENCE EXTENSION**, as a property of a theory and not a structure field:
DOC 445: every available composite family stays available with any untouched finite spectator
DOC 446: appended, after the explicit reindexing. -/
SIG 447: def HasParallelReferenceExtension (T : FiniteOperationalTheory A) : Prop :=
SIG 448:   ∀ (R : Type) [Fintype R] [DecidableEq R] (n m : ℕ) (e : R × (A × Fin n) ≃ A × Fin m)
SIG 449:     (O : Type) [Fintype O] [DecidableEq O]
SIG 450:     (F : O → Matrix (A × Fin n) (A × Fin n) ℂ →ₗ[ℂ] Matrix (A × Fin n) (A × Fin n) ℂ),
SIG 451:     T.availExt n O F → T.availExt m O (fun a => withSpectator R e (F a))
=== ReferenceExtension.lean:458 def qutritIdx
DOC 455: /-- The explicit reindexing `Fin 3 × (Fin 2 × Fin 2) ≃ Fin 2 × Fin 6`: associate, move the
DOC 456: spectator past the SYSTEM qubit (which stays in the system slot), re-associate, and pack the
DOC 457: spectator with the ancilla qubit into `Fin 6`. -/
SIG 458: def qutritIdx : Fin 3 × (Fin 2 × Fin 2) ≃ Fin 2 × Fin 6 :=
SIG 459:   (Equiv.prodAssoc _ _ _).symm.trans
SIG 460:     ((Equiv.prodCongr (Equiv.prodComm _ _) (Equiv.refl _)).trans
SIG 461:       ((Equiv.prodAssoc _ _ _).trans (Equiv.prodCongr (Equiv.refl _) finProdFinEquiv)))
=== ReferenceExtension.lean:464 theorem qutritIdx_apply
DOC 463: /-- The system index is preserved by the reindexing; the spectator and ancilla are packed. -/
SIG 464: theorem qutritIdx_apply (r : Fin 3) (a e : Fin 2) :
SIG 465:     qutritIdx (r, (a, e)) = (a, finProdFinEquiv (r, e)) := rfl
