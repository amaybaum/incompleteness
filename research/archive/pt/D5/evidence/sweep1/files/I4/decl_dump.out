=== QuasilocalAlgebra.lean:563 def localNorm
DOC 562: /-- The norm as an additive group norm. -/
SIG 563: noncomputable def localNorm : AddGroupNorm (localAlg ι Q) where
SIG 564:   toFun := nrm
SIG 565:   map_zero' := by rw [← ofM_zero (∅ : Finset ι), nrm_ofM, norm_zero]
SIG 566:   add_le' a b := by
SIG 567:     obtain ⟨Λ, X, Y, rfl, rfl⟩ := exists_ofM₂ a b
SIG 568:     rw [← ofM_add, nrm_ofM, nrm_ofM, nrm_ofM]
SIG 569:     exact norm_add_le X Y
SIG 570:   neg' a := by
SIG 571:     obtain ⟨Λ, X, rfl⟩ := exists_ofM a
SIG 572:     rw [← ofM_neg, nrm_ofM, nrm_ofM, norm_neg]
SIG 573:   eq_zero_of_map_eq_zero' a h := by
SIG 574:     obtain ⟨Λ, X, rfl⟩ := exists_ofM a
SIG 575:     rw [nrm_ofM] at h
SIG 576:     rw [norm_eq_zero.mp h, ofM_zero]
