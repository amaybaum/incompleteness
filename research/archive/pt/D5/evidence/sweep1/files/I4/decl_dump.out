=== QuasilocalAlgebra.lean:418 def localAlg  HEADLINE
DOC 416: /-- **THE LOCAL ALGEBRA**: the operators of the scaffold that are local observables of some
DOC 417: region. -/
SIG 418: noncomputable def localAlg (ι Q : Type) [DecidableEq ι] [Fintype Q] [DecidableEq Q] :
SIG 419:     Subalgebra ℂ (Module.End ℂ (Scaffold ι Q)) where
SIG 420:   carrier := {T | ∃ (Λ : Finset ι) (X : Matrix (Conf Λ Q) (Conf Λ Q) ℂ), emb Λ X = T}
SIG 421:   mul_mem' := by
SIG 422:     rintro _ _ ⟨Λ, X, rfl⟩ ⟨Λ', Y, rfl⟩
SIG 423:     refine ⟨Λ ∪ Λ', inclObs Finset.subset_union_left X * inclObs Finset.subset_union_right Y, ?_⟩
SIG 424:     rw [emb_mul, emb_inclObs, emb_inclObs]
SIG 425:   one_mem' := ⟨∅, 1, emb_one ∅⟩
SIG 426:   add_mem' := by
SIG 427:     rintro _ _ ⟨Λ, X, rfl⟩ ⟨Λ', Y, rfl⟩
SIG 428:     refine ⟨Λ ∪ Λ', inclObs Finset.subset_union_left X + inclObs Finset.subset_union_right Y, ?_⟩
SIG 429:     rw [emb_add, emb_inclObs, emb_inclObs]
SIG 430:   zero_mem' := ⟨∅, 0, emb_zero ∅⟩
SIG 431:   algebraMap_mem' := fun c => ⟨∅, c • 1, by
SIG 432:     rw [emb_smul, emb_one, Algebra.algebraMap_eq_smul_one]⟩
