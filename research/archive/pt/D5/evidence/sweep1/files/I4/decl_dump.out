SIG 1110:     (G₁ G₂ : ι → Matrix n n ℂ) (σ₁ σ₂ : κ → Matrix n n ℂ)
SIG 1111:     (hdata : ∀ i k, Matrix.trace (G₁ i * σ₁ k) = Matrix.trace (G₂ i * σ₂ k))
SIG 1112:     (hG₁h : ∀ i, (G₁ i).IsHermitian) (hG₂h : ∀ i, (G₂ i).IsHermitian)
SIG 1113:     (hσ₁p : ∀ k, (σ₁ k).PosSemidef) (hσ₂p : ∀ k, (σ₂ k).PosSemidef)
SIG 1114:     (hspan₁ : Submodule.span ℂ (Set.range G₁) = ⊤)
SIG 1115:     (hspan₂ : Submodule.span ℂ (Set.range G₂) = ⊤)
SIG 1116:     (hsep₁ : ∀ M : Matrix n n ℂ, (∀ k, Matrix.trace (M * σ₁ k) = 0) → M = 0)
SIG 1117:     (hsep₂ : ∀ M : Matrix n n ℂ, (∀ k, Matrix.trace (M * σ₂ k) = 0) → M = 0)
SIG 1118:     (i₀ : ι) (hone₁ : G₁ i₀ = 1) (hone₂ : G₂ i₀ = 1)
SIG 1119:     (hcone₁ : ∀ τ : Matrix n n ℂ, τ.PosSemidef → ∃ (s : Finset κ) (c : κ → ℝ),
SIG 1120:       (∀ k, 0 ≤ c k) ∧ τ = ∑ k ∈ s, c k • σ₁ k)
SIG 1121:     (hcone₂ : ∀ τ : Matrix n n ℂ, τ.PosSemidef → ∃ (s : Finset κ) (c : κ → ℝ),
SIG 1122:       (∀ k, 0 ≤ c k) ∧ τ = ∑ k ∈ s, c k • σ₂ k) :
