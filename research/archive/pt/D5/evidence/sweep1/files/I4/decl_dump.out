=== QuasilocalAlgebra.lean:512 def inclHom
DOC 511: /-- Inclusion of observables as a star algebra homomorphism between the finite stages. -/
SIG 512: noncomputable def inclHom {Λ Λ' : Finset ι} (h : Λ ⊆ Λ') :
SIG 513:     Matrix (Conf Λ Q) (Conf Λ Q) ℂ →⋆ₐ[ℂ] Matrix (Conf Λ' Q) (Conf Λ' Q) ℂ where
SIG 514:   toFun := inclObs h
SIG 515:   map_one' := inclObs_one h
SIG 516:   map_mul' := inclObs_mul h
SIG 517:   map_zero' := by
SIG 518:     rw [← zero_smul ℂ (0 : Matrix (Conf Λ Q) (Conf Λ Q) ℂ), inclObs_smul, zero_smul]
SIG 519:   map_add' := inclObs_add h
SIG 520:   commutes' c := by
SIG 521:     rw [Algebra.algebraMap_eq_smul_one, inclObs_smul, inclObs_one, Algebra.algebraMap_eq_smul_one]
SIG 522:   map_star' X := by
SIG 523:     rw [Matrix.star_eq_conjTranspose, Matrix.star_eq_conjTranspose, inclObs_conjTranspose]
