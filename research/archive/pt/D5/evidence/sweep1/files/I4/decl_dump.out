=== QuasilocalAlgebra.lean:234 abbrev Scaffold
DOC 231: /-- The scaffold: the free vector space on global configurations. It carries no inner product,
DOC 232: no norm, and no state; it is the algebraic device by which the direct limit of the finite stages
DOC 233: is realized as a ring. -/
SIG 234: abbrev Scaffold (ι Q : Type) : Type := (ι → Q) →₀ ℂ
=== QuasilocalAlgebra.lean:242 def emb
DOC 241: /-- A local observable as an operator on the scaffold. -/
SIG 242: noncomputable def emb (Λ : Finset ι) (X : Matrix (Conf Λ Q) (Conf Λ Q) ℂ) :
SIG 243:     Module.End ℂ (Scaffold ι Q) :=
SIG 244:   Finsupp.linearCombination ℂ
SIG 245:     (fun s => ∑ f : Conf Λ Q, X f (glob Λ s) • Finsupp.single (patch Λ s f) (1 : ℂ))
=== QuasilocalAlgebra.lean:247 theorem emb_single
SIG 247: theorem emb_single (Λ : Finset ι) (X : Matrix (Conf Λ Q) (Conf Λ Q) ℂ) (s : ι → Q) (c : ℂ) :
SIG 248:     emb Λ X (Finsupp.single s c)
SIG 249:       = c • ∑ f : Conf Λ Q, X f (glob Λ s) • Finsupp.single (patch Λ s f) (1 : ℂ) :=
=== QuasilocalAlgebra.lean:254 theorem emb_single_apply
DOC 253: /-- The operator of a local observable has the observable's kernel. -/
SIG 254: theorem emb_single_apply (Λ : Finset ι) (X : Matrix (Conf Λ Q) (Conf Λ Q) ℂ) (s : ι → Q)
SIG 255:     (c : ℂ) (t : ι → Q) : emb Λ X (Finsupp.single s c) t = c * kern Λ X t s := by
