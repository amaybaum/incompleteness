DOC 189: /-- **EACH MAP OF THE PATH IS A `*`-AUTOMORPHISM.** -/
SIG 190: theorem driveQ_bijective (t : ℝ) :
SIG 191:     Function.Bijective (driveQ R t : Quasilocal ι (V × V) → Quasilocal ι (V × V)) :=
=== SecondOrderDrive.lean:199 theorem continuous_driveQ_time  HEADLINE
DOC 195: /-- **THE PATH IS NORM-CONTINUOUS IN TIME.** Neither factor's strong continuity gives this on its
DOC 196: own: the time parameter moves in both slots at once. What closes the gap is that the outer flow is
DOC 197: isometric *uniformly in its own time parameter*, so the inner motion can be estimated at a frozen
DOC 198: outer time and the outer motion at a frozen inner argument. -/
SIG 199: theorem continuous_driveQ_time (x : Quasilocal ι (V × V)) :
SIG 200:     Continuous fun t : ℝ => driveQ R t x := by
=== SecondOrderDrive.lean:225 theorem driveQ_isContinuousPath  HEADLINE
DOC 221: /-- **THE UPDATE IS JOINED TO THE IDENTITY BY A CONTINUOUS PATH OF `*`-AUTOMORPHISMS.** The three
DOC 222: clauses are the whole claim: the path starts at the identity, every point of it is an isometric
DOC 223: `*`-automorphism of the quasilocal algebra, and it is norm-continuous in the parameter. No group
DOC 224: law and no generator are asserted. -/
SIG 225: theorem driveQ_isContinuousPath :
SIG 226:     driveQ R 0 = (id : Quasilocal ι (V × V) → Quasilocal ι (V × V)) ∧
SIG 227:       (∀ t : ℝ, Function.Bijective (driveQ R t : Quasilocal ι (V × V) → Quasilocal ι (V × V)) ∧
SIG 228:         (∀ x y, driveQ R t (x * y) = driveQ R t x * driveQ R t y) ∧
SIG 229:         (∀ x y, driveQ R t (x + y) = driveQ R t x + driveQ R t y) ∧
SIG 230:         (∀ x, driveQ R t (star x) = star (driveQ R t x)) ∧
SIG 231:         (∀ x, ‖driveQ R t x‖ = ‖x‖)) ∧
SIG 232:       (∀ x : Quasilocal ι (V × V), Continuous fun t : ℝ => driveQ R t x) :=
=== SecondOrderDrive.lean:248 def swapFiniteRange  HEADLINE
DOC 246: /-- **THE SWAP LAYER'S COUPLING DATA.** A swap gate occupies one site, so both cones are
DOC 247: singletons. -/
SIG 248: def swapFiniteRange (V : Type) [Fintype V] [DecidableEq V] [Nonempty V] [AddCommGroup V] :
SIG 249:     FiniteRange (swapLayer : (ι → V × V) → (ι → V × V)) where
SIG 250:   nbhd i := {i}
SIG 251:   local_dep i := by
SIG 252:     intro s s' h
SIG 253:     have hi : s i = s' i := h i (Finset.mem_singleton_self i)
SIG 254:     show swapLayer s i = swapLayer s' i
SIG 255:     rw [swapLayer_apply, swapLayer_apply, hi]
SIG 256:   infl i := {i}
SIG 257:   mem_infl i j hij := by
SIG 258:     rw [Finset.mem_singleton] at hij
SIG 259:     subst hij
SIG 260:     exact Finset.mem_singleton_self _
=== SecondOrderDrive.lean:264 def swapDyn  HEADLINE
DOC 262: /-- **THE SWAP LAYER AS A REVERSIBLE DYNAMICS.** It is its own inverse, so both range proofs are
DOC 263: the same one. -/
SIG 264: def swapDyn (V : Type) [Fintype V] [DecidableEq V] [Nonempty V] [AddCommGroup V] :
SIG 265:     ReversibleDynamics ι (V × V) where
SIG 266:   φ := swapEquiv
SIG 267:   G := swapFiniteRange V
SIG 268:   G' := swapFiniteRange V
=== SecondOrderDrive.lean:274 def stepInfl
DOC 272: /-- The influence set of the shear and of the whole update: a site influences itself and whatever
DOC 273: the rule says it influences. -/
SIG 274: def stepInfl (i : ι) : Finset ι := insert i (R.infl i)
=== SecondOrderDrive.lean:277 theorem mem_stepInfl_of_mem_gateRegion
SIG 277: theorem mem_stepInfl_of_mem_gateRegion {i j : ι} (h : i ∈ gateRegion R j) : j ∈ stepInfl R i := by
=== SecondOrderDrive.lean:285 def shearFiniteRange  HEADLINE
DOC 283: /-- **THE SHEAR LAYER'S COUPLING DATA.** A shear at site `i` reads the current slice on `N i` and
DOC 284: the previous slice at `i`, so its neighbourhood is the gate region. -/
SIG 285: def shearFiniteRange : FiniteRange (shear R.F : (ι → V × V) → (ι → V × V)) where
SIG 286:   nbhd := gateRegion R
SIG 287:   local_dep i := by
SIG 288:     intro s s' h
SIG 289:     have hi : s i = s' i := h i (Finset.mem_insert_self i (R.N i))
SIG 290:     have hF : R.F (curOf s) i = R.F (curOf s') i :=
SIG 291:       R.dep i _ _ fun j hj => by
SIG 292:         rw [curOf_apply, curOf_apply, h j (Finset.mem_insert_of_mem hj)]
SIG 293:     show shear R.F s i = shear R.F s' i
SIG 294:     rw [shear_apply, shear_apply, hF, hi]
SIG 295:   infl := stepInfl R
SIG 296:   mem_infl _ _ h := mem_stepInfl_of_mem_gateRegion R h
=== SecondOrderDrive.lean:299 def shearDyn  HEADLINE
DOC 298: /-- **THE SHEAR LAYER AS A REVERSIBLE DYNAMICS.** -/
SIG 299: def shearDyn : ReversibleDynamics ι (V × V) where
SIG 300:   φ := shearEquiv R.F
SIG 301:   G := shearFiniteRange R
SIG 302:   G' := shearFiniteRange R
=== SecondOrderDrive.lean:306 def leapFiniteRange  HEADLINE
DOC 304: /-- **THE UPDATE'S COUPLING DATA.** The one-step map reads the same sites as the shear: the swap
DOC 305: that follows it is on-site. -/
SIG 306: def leapFiniteRange : FiniteRange (leap R.F : (ι → V × V) → (ι → V × V)) where
SIG 307:   nbhd := gateRegion R
SIG 308:   local_dep i := by
SIG 309:     intro s s' h
SIG 310:     have hi : s i = s' i := h i (Finset.mem_insert_self i (R.N i))
SIG 311:     have hF : R.F (curOf s) i = R.F (curOf s') i :=
SIG 312:       R.dep i _ _ fun j hj => by
SIG 313:         rw [curOf_apply, curOf_apply, h j (Finset.mem_insert_of_mem hj)]
SIG 314:     show leap R.F s i = leap R.F s' i
SIG 315:     rw [leap_apply, leap_apply, hF, hi]
SIG 316:   infl := stepInfl R
SIG 317:   mem_infl _ _ h := mem_stepInfl_of_mem_gateRegion R h
=== SecondOrderDrive.lean:321 def leapSymmFiniteRange  HEADLINE
DOC 319: /-- **THE INVERSE STEP'S COUPLING DATA.** The inverse runs the two layers in the other order, so it
DOC 320: reads the *previous* slice on `N i` — the same sites, a different component. -/
SIG 321: def leapSymmFiniteRange :
SIG 322:     FiniteRange (fun x : ι → V × V => shear R.F (swapLayer x)) where
SIG 323:   nbhd := gateRegion R
SIG 324:   local_dep i := by
SIG 325:     intro s s' h
SIG 326:     have hi : s i = s' i := h i (Finset.mem_insert_self i (R.N i))
SIG 327:     have hF : R.F (curOf (swapLayer s)) i = R.F (curOf (swapLayer s')) i :=
SIG 328:       R.dep i _ _ fun j hj => by
SIG 329:         rw [curOf_apply, curOf_apply, swapLayer_apply, swapLayer_apply,
SIG 330:           h j (Finset.mem_insert_of_mem hj)]
SIG 331:     show shear R.F (swapLayer s) i = shear R.F (swapLayer s') i
SIG 332:     rw [shear_apply, shear_apply, hF, swapLayer_apply, swapLayer_apply, hi]
SIG 333:   infl := stepInfl R
SIG 334:   mem_infl _ _ h := mem_stepInfl_of_mem_gateRegion R h
=== SecondOrderDrive.lean:339 def ruleDynamics  HEADLINE
DOC 336: /-- **THE UPDATE AS A FINITE-RANGE REVERSIBLE DYNAMICS.** Reversibility is not assumed: it comes
DOC 337: from the depth-two factorization, which exhibits the inverse as the two layers in the other
DOC 338: order. -/
SIG 339: def ruleDynamics : ReversibleDynamics ι (V × V) where
SIG 340:   φ := leapEquiv R.F
SIG 341:   G := leapFiniteRange R
SIG 342:   G' := leapSymmFiniteRange R
=== SecondOrderDrive.lean:345 theorem ruleDynamics_comp  HEADLINE
