=== TypedCompletion.lean:231 def shadow  HEADLINE
DOC 229: /-- **THE ENDOMORPHIC SHADOW**: the typed theory restricted to maps from a carrier to itself,
DOC 230: with `A × Fin n` as the levels. -/
SIG 231: noncomputable def shadow (A : Type) [Fintype A] [DecidableEq A] : FiniteOperationalTheory A where
SIG 232:   avail := fun O _ _ F => 𝒯.availT A A O F
SIG 233:   availExt := fun n O _ _ F => 𝒯.availT (A × Fin n) (A × Fin n) O F
SIG 234:   avail_id := 𝒯.id A
SIG 235:   avail_coarse := fun O O' _ _ _ _ F f h => 𝒯.coarse A A O O' F f h
SIG 236:   availExt_coarse := fun _ O O' _ _ _ _ F f h => 𝒯.coarse _ _ O O' F f h
SIG 237:   availExt_bind := fun _ O O' _ _ _ _ F G hF hG => 𝒯.bind _ _ _ O O' F G hF hG
SIG 238:   prepAvail := fun n P => 𝒯.availT A (A × Fin n) Unit (fun _ => P)
SIG 239:   prepAvail_uniform := fun n => by
SIG 240:     have h := 𝒯.attach A (Fin (n + 1))
SIG 241:     rwa [attachUniform_fin] at h
SIG 242:   prepAvail_post := fun n P Φ hP hΦ => by
SIG 243:     have h := 𝒯.bind A (A × Fin n) (A × Fin n) Unit Unit (fun _ => P) (fun _ _ => Φ) hP
SIG 244:       (fun _ => hΦ)
SIG 245:     exact 𝒯.availT_equiv (Equiv.prodPUnit Unit) _ h
SIG 246:   readout := fun n => 𝒯.readout A (Fin n)
SIG 247:   readout_avail := fun n => 𝒯.readout_avail A (Fin n)
SIG 248:   readout_local := fun n k => 𝒯.readout_local A (Fin n) k
SIG 249:   prepAvail_discard := fun n P O _ _ F hP hF => by
SIG 250:     have h1 := 𝒯.bind A (A × Fin n) (A × Fin n) Unit O (fun _ => P) (fun _ => F) hP
SIG 251:       (fun _ => hF)
SIG 252:     have h2 := 𝒯.bind A (A × Fin n) A (Unit × O) Unit _ (fun _ _ => discardR (Fin n)) h1
SIG 253:       (fun _ => 𝒯.discard A (Fin n))
SIG 254:     have h3 := 𝒯.availT_equiv ((Equiv.prodPUnit (Unit × O)).trans (Equiv.punitProd O)) _ h2
SIG 255:     exact h3
