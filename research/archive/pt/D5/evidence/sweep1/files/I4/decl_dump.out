SIG 868:   readout_avail := fun n => by
SIG 869:     have h := InstAvail.readout (𝓘 := 𝓘) (Equiv.refl (S × Fin n))
SIG 870:       (fun k => by rw [Matrix.reindex_refl_refl]; exact arch.proj S n k)
SIG 871:     simp only [Matrix.reindex_refl_refl] at h
SIG 872:     have e : (fun k : Fin n => localLuders (A := S) k)
SIG 873:         = fun k => conjChannel (readProj S n k) := funext fun k => localLuders_eq_conjChannel k
SIG 874:     rw [e]
SIG 875:     exact h
SIG 876:   readout_local := fun _ k => localLuders_mapSpectatorIndependent k
SIG 877:   prepAvail_discard := by
SIG 878:     rintro n P O _ _ F ⟨hn, Φ, hΦ, rfl⟩ hF
SIG 879:     have e : (fun a => discardWith n (Φ.comp (uniformAttach n)) (F a))
