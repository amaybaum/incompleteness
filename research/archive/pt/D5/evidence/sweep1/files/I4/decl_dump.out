=== TypedCompletion.lean:165 structure TypedOperationalTheory  HEADLINE
DOC 162: /-- **A TYPED FINITE OPERATIONAL THEORY**: availability of finite outcome families of maps
DOC 163: between any two finite carriers, with the closure rules of the endomorphic structure stated at
DOC 164: their carrier-general type. No clause mentions a dilation. -/
SIG 165: structure TypedOperationalTheory where
SIG 166:   /-- Available finite outcome families of maps from carrier `S` to carrier `S'`. -/
SIG 167:   availT : ∀ (S S' : Type) [Fintype S] [DecidableEq S] [Fintype S'] [DecidableEq S']
SIG 168:     (O : Type) [Fintype O] [DecidableEq O], (O → Matrix S S ℂ →ₗ[ℂ] Matrix S' S' ℂ) → Prop
SIG 169:   /-- Doing nothing is available. -/
SIG 170:   id : ∀ (S : Type) [Fintype S] [DecidableEq S], availT S S Unit (fun _ => LinearMap.id)
SIG 171:   /-- Classical coarse-graining of the outcome label. -/
SIG 172:   coarse : ∀ (S S' : Type) [Fintype S] [DecidableEq S] [Fintype S'] [DecidableEq S']
SIG 173:     (O O' : Type) [Fintype O] [DecidableEq O] [Fintype O'] [DecidableEq O']
SIG 174:     (F : O → Matrix S S ℂ →ₗ[ℂ] Matrix S' S' ℂ) (f : O → O'), availT S S' O F →
SIG 175:     availT S S' O' (fun a => ∑ j ∈ Finset.univ.filter (fun j => f j = a), F j)
SIG 176:   /-- Feed-forward composition across carriers. -/
SIG 177:   bind : ∀ (S S' S'' : Type) [Fintype S] [DecidableEq S] [Fintype S'] [DecidableEq S']
SIG 178:     [Fintype S''] [DecidableEq S''] (O O' : Type) [Fintype O] [DecidableEq O] [Fintype O']
SIG 179:     [DecidableEq O'] (F : O → Matrix S S ℂ →ₗ[ℂ] Matrix S' S' ℂ)
SIG 180:     (G : O → O' → Matrix S' S' ℂ →ₗ[ℂ] Matrix S'' S'' ℂ),
SIG 181:     availT S S' O F → (∀ a, availT S' S'' O' (G a)) →
SIG 182:     availT S S'' (O × O') (fun c => (G c.1 c.2).comp (F c.1))
SIG 183:   /-- Relabelling along carrier bijections. -/
SIG 184:   relabel : ∀ (S S' T T' : Type) [Fintype S] [DecidableEq S] [Fintype S'] [DecidableEq S']
SIG 185:     [Fintype T] [DecidableEq T] [Fintype T'] [DecidableEq T'] (e : S ≃ T) (e' : S' ≃ T')
SIG 186:     (O : Type) [Fintype O] [DecidableEq O] (F : O → Matrix S S ℂ →ₗ[ℂ] Matrix S' S' ℂ),
SIG 187:     availT S S' O F → availT T T' O (fun a => transportT e e' (F a))
SIG 188:   /-- Attaching a uniformly mixed fresh factor: the only preparation assumed. -/
SIG 189:   attach : ∀ (S R : Type) [Fintype S] [DecidableEq S] [Fintype R] [DecidableEq R] [Nonempty R],
SIG 190:     availT S (S × R) Unit (fun _ => attachUniform R)
SIG 191:   /-- Discarding a factor. -/
SIG 192:   discard : ∀ (S R : Type) [Fintype S] [DecidableEq S] [Fintype R] [DecidableEq R],
SIG 193:     availT (S × R) S Unit (fun _ => discardR R)
SIG 194:   /-- A native readout of a factor exists and is spectator-independent; its form is derived. -/
SIG 195:   readout : ∀ (S R : Type) [Fintype S] [DecidableEq S] [Fintype R] [DecidableEq R],
SIG 196:     R → (Matrix (S × R) (S × R) ℂ →ₗ[ℂ] Matrix (S × R) (S × R) ℂ)
SIG 197:   readout_avail : ∀ (S R : Type) [Fintype S] [DecidableEq S] [Fintype R] [DecidableEq R],
SIG 198:     availT (S × R) (S × R) R (readout S R)
SIG 199:   readout_local : ∀ (S R : Type) [Fintype S] [DecidableEq S] [Fintype R] [DecidableEq R]
SIG 200:     (k : R), MapSpectatorIndependent (ludersLift k) (readout S R k)
