DOC 914: /-- **THE TYPED DIAGONAL THEORY**: a family is available exactly when every branch preserves
DOC 915: diagonal matrices. It satisfies every rule of the interface. -/
SIG 916: noncomputable def typedDiag : TypedOperationalTheory where
SIG 917:   availT := fun _ _ _ _ _ _ _ _ _ F => ∀ a, PreservesDiag (F a)
SIG 918:   id := fun _ _ _ _ => preservesDiag_id
SIG 919:   coarse := fun _ _ _ _ _ _ _ _ _ _ _ _ _ _ h _ =>
SIG 920:     preservesDiag_sum _ _ fun j _ => h j
SIG 921:   bind := fun _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hF hG c =>
SIG 922:     preservesDiag_comp (hG c.1 c.2) (hF c.1)
SIG 923:   relabel := fun _ _ _ _ _ _ _ _ _ _ _ _ e e' _ _ _ _ h a =>
SIG 924:     preservesDiag_transportT e e' (h a)
SIG 925:   attach := fun _ _ _ _ _ _ _ _ => preservesDiag_attachUniform
SIG 926:   discard := fun _ _ _ _ _ _ _ => preservesDiag_discardR
SIG 927:   readout := fun _ _ _ _ _ _ k => localLuders k
SIG 928:   readout_avail := fun _ _ _ _ _ _ k => preservesDiag_localLuders k
SIG 929:   readout_local := fun _ _ _ _ _ _ k => (mapSpectatorIndependent_iff_localLuders k _).mpr rfl
