=== StateMixingCoupling.lean:56 inductive MixR  HEADLINE
DOC 53: /-- **THE CLASS**: the stated access, the scaled partial permutations and the quarter phase on
DOC 54: any configuration at any level, together with the datum at the angles of `D`, closed under the
DOC 55: architecture operations and relabelling. -/
SIG 56: inductive MixR (D : Set ℝ) : ∀ (T : Type) [Fintype T] [DecidableEq T], Matrix T T ℂ → Prop
SIG 57:   | perm {T : Type} [Fintype T] [DecidableEq T] (K : Matrix T T ℂ) (h : permClass T K) : MixR D T K
SIG 58:   | phase (n : ℕ) (p : Fin 2 × Fin n) : MixR D (Fin 2 × Fin n) (phaseGate p)
SIG 59:   | mix (n : ℕ) (θ : ℝ) (hθ : θ ∈ D) : MixR D (Fin 2 × Fin n) (mixImage n θ)
SIG 60:   | mul {T : Type} [Fintype T] [DecidableEq T] (K L : Matrix T T ℂ) :
SIG 61:       MixR D T K → MixR D T L → MixR D T (K * L)
SIG 62:   | smul {T : Type} [Fintype T] [DecidableEq T] (a : ℂ) (K : Matrix T T ℂ) (ha : ‖a‖ ≤ 1) :
SIG 63:       MixR D T K → MixR D T (a • K)
SIG 64:   | proj {T : Type} [Fintype T] [DecidableEq T] (m : ℕ) (k : Fin m) :
SIG 65:       MixR D (T × Fin m) (Matrix.diagonal fun r => if r.2 = k then 1 else 0)
SIG 66:   | block {T : Type} [Fintype T] [DecidableEq T] (m : ℕ) (K : Matrix (T × Fin m) (T × Fin m) ℂ)
SIG 67:       (f e : Fin m) : MixR D (T × Fin m) K → MixR D T (ancBlock K f e)
SIG 68:   | relabel {T T' : Type} [Fintype T] [DecidableEq T] [Fintype T'] [DecidableEq T'] (e : T ≃ T')
SIG 69:       (K : Matrix T T ℂ) : MixR D T K → MixR D T' (Matrix.reindex e e K)
