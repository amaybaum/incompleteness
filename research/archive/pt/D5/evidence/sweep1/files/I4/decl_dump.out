SIG 415: theorem quad_qd (v : n → n → ℂ)
SIG 416:     (horm : ∀ i j, star (v i) ⬝ᵥ v j = if i = j then 1 else 0) (x i j y : n) :
SIG 417:     star (v x) ⬝ᵥ (qd v i j *ᵥ v y)
SIG 418:       = (if x = i then (1 : ℂ) else 0) * (if j = y then 1 else 0) := by
=== JordanClassification.lean:422 theorem quad_two
SIG 422: theorem quad_two (v : n → n → ℂ)
SIG 423:     (horm : ∀ i j, star (v i) ⬝ᵥ v j = if i = j then 1 else 0)
SIG 424:     (a b : ℂ) (i j k l x y : n) :
SIG 425:     star (v x) ⬝ᵥ ((a • qd v i j + b • qd v k l) *ᵥ v y)
SIG 426:       = a * ((if x = i then (1 : ℂ) else 0) * (if j = y then 1 else 0))
SIG 427:         + b * ((if x = k then (1 : ℂ) else 0) * (if l = y then 1 else 0)) := by
=== JordanClassification.lean:435 def cA
DOC 434: /-- The direct corner coefficient of the image of a matrix unit. -/
SIG 435: def cA (Φ : Matrix n n ℂ →ₗ[ℂ] Matrix n n ℂ) (v : n → n → ℂ) (i j : n) : ℂ :=
SIG 436:   star (v i) ⬝ᵥ (Φ (Eu i j) *ᵥ v j)
=== JordanClassification.lean:439 def cB
DOC 438: /-- The transposed corner coefficient. -/
SIG 439: def cB (Φ : Matrix n n ℂ →ₗ[ℂ] Matrix n n ℂ) (v : n → n → ℂ) (i j : n) : ℂ :=
SIG 440:   star (v j) ⬝ᵥ (Φ (Eu i j) *ᵥ v i)
=== JordanClassification.lean:444 theorem corner_form  HEADLINE
DOC 442: /-- **Corner localization**: the image of an off-diagonal matrix unit lives in the
DOC 443: two-dimensional span of the direct and transposed frame dyads. -/
SIG 444: theorem corner_form (Φ : Matrix n n ℂ →ₗ[ℂ] Matrix n n ℂ)
SIG 445:     (hj : ∀ A B : Matrix n n ℂ, Φ (A * B + B * A) = Φ A * Φ B + Φ B * Φ A)
SIG 446:     (hone : Φ 1 = 1)
SIG 447:     (v : n → n → ℂ) (horm : ∀ i j, star (v i) ⬝ᵥ v j = if i = j then 1 else 0)
SIG 448:     (hP : ∀ i, Φ (Eu i i) = qd v i i) {i j : n} (hij : i ≠ j) :
SIG 449:     Φ (Eu i j) = cA Φ v i j • qd v i j + cB Φ v i j • qd v j i := by
=== JordanClassification.lean:565 theorem corner_mulVec
DOC 564: /-- The images of matrix units act on the frame by the corner coefficients. -/
SIG 565: theorem corner_mulVec (Φ : Matrix n n ℂ →ₗ[ℂ] Matrix n n ℂ)
SIG 566:     (hj : ∀ A B : Matrix n n ℂ, Φ (A * B + B * A) = Φ A * Φ B + Φ B * Φ A)
SIG 567:     (hone : Φ 1 = 1)
SIG 568:     (v : n → n → ℂ) (horm : ∀ i j, star (v i) ⬝ᵥ v j = if i = j then 1 else 0)
SIG 569:     (hP : ∀ i, Φ (Eu i i) = qd v i i) {i j : n} (hij : i ≠ j) :
SIG 570:     Φ (Eu i j) *ᵥ v j = cA Φ v i j • v i
SIG 571:       ∧ Φ (Eu i j) *ᵥ v i = cB Φ v i j • v j
SIG 572:       ∧ ∀ k, k ≠ i → k ≠ j → Φ (Eu i j) *ᵥ v k = 0 := by
=== JordanClassification.lean:589 theorem dot_conj
DOC 588: /-- Adjoint transport of the quadratic pairing. -/
SIG 589: theorem dot_conj (M : Matrix n n ℂ) (x y : n → ℂ) :
SIG 590:     star x ⬝ᵥ (Mᴴ *ᵥ y) = star (star y ⬝ᵥ (M *ᵥ x)) := by
=== JordanClassification.lean:603 theorem corner_conj
DOC 602: /-- Star-preservation turns index swap into conjugation of both corner coefficients. -/
SIG 603: theorem corner_conj (Φ : Matrix n n ℂ →ₗ[ℂ] Matrix n n ℂ)
SIG 604:     (hstar : ∀ X : Matrix n n ℂ, Φ Xᴴ = (Φ X)ᴴ) (v : n → n → ℂ) (i j : n) :
SIG 605:     cA Φ v j i = star (cA Φ v i j) ∧ cB Φ v j i = star (cB Φ v i j) := by
=== JordanClassification.lean:613 theorem corner_nilpotent  HEADLINE
DOC 612: /-- **Corner nilpotency**: the direct and transposed coefficients cannot both live. -/
SIG 613: theorem corner_nilpotent (Φ : Matrix n n ℂ →ₗ[ℂ] Matrix n n ℂ)
SIG 614:     (hj : ∀ A B : Matrix n n ℂ, Φ (A * B + B * A) = Φ A * Φ B + Φ B * Φ A)
SIG 615:     (hone : Φ 1 = 1)
SIG 616:     (v : n → n → ℂ) (horm : ∀ i j, star (v i) ⬝ᵥ v j = if i = j then 1 else 0)
SIG 617:     (hP : ∀ i, Φ (Eu i i) = qd v i i) {i j : n} (hij : i ≠ j) :
SIG 618:     cA Φ v i j * cB Φ v i j = 0 := by
=== JordanClassification.lean:638 theorem corner_unimodular  HEADLINE
DOC 637: /-- **Corner unimodularity**: `|α|² + |β|² = 1` at every corner. -/
SIG 638: theorem corner_unimodular (Φ : Matrix n n ℂ →ₗ[ℂ] Matrix n n ℂ)
SIG 639:     (hstar : ∀ X : Matrix n n ℂ, Φ Xᴴ = (Φ X)ᴴ)
SIG 640:     (hj : ∀ A B : Matrix n n ℂ, Φ (A * B + B * A) = Φ A * Φ B + Φ B * Φ A)
SIG 641:     (hone : Φ 1 = 1)
SIG 642:     (v : n → n → ℂ) (horm : ∀ i j, star (v i) ⬝ᵥ v j = if i = j then 1 else 0)
SIG 643:     (hP : ∀ i, Φ (Eu i i) = qd v i i) {i j : n} (hij : i ≠ j) :
SIG 644:     cA Φ v i j * star (cA Φ v i j) + cB Φ v i j * star (cB Φ v i j) = 1 := by
=== JordanClassification.lean:668 theorem corner_cocycle  HEADLINE
DOC 667: /-- **The corner cocycle** across a triple. -/
SIG 668: theorem corner_cocycle (Φ : Matrix n n ℂ →ₗ[ℂ] Matrix n n ℂ)
SIG 669:     (hj : ∀ A B : Matrix n n ℂ, Φ (A * B + B * A) = Φ A * Φ B + Φ B * Φ A)
SIG 670:     (hone : Φ 1 = 1)
SIG 671:     (v : n → n → ℂ) (horm : ∀ i j, star (v i) ⬝ᵥ v j = if i = j then 1 else 0)
SIG 672:     (hP : ∀ i, Φ (Eu i i) = qd v i i) {i j k : n}
SIG 673:     (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) :
SIG 674:     cA Φ v i k = cA Φ v i j * cA Φ v j k ∧ cB Φ v i k = cB Φ v i j * cB Φ v j k := by
=== JordanClassification.lean:699 theorem orientation_dichotomy  HEADLINE
DOC 695: /-- **TRIPLE COHERENCE — the global orientation dichotomy.** A single transposed corner
DOC 696: forces every corner transposed: mixed orientations would make some corner carry neither
DOC 697: coefficient, contradicting unimodularity. Probe F19's mixed-orientation map violates the
DOC 698: Jordan identity at the triple, exactly as this propagation demands. -/
SIG 699: theorem orientation_dichotomy (Φ : Matrix n n ℂ →ₗ[ℂ] Matrix n n ℂ)
SIG 700:     (hstar : ∀ X : Matrix n n ℂ, Φ Xᴴ = (Φ X)ᴴ)
SIG 701:     (hj : ∀ A B : Matrix n n ℂ, Φ (A * B + B * A) = Φ A * Φ B + Φ B * Φ A)
SIG 702:     (hone : Φ 1 = 1)
SIG 703:     (v : n → n → ℂ) (horm : ∀ i j, star (v i) ⬝ᵥ v j = if i = j then 1 else 0)
SIG 704:     (hP : ∀ i, Φ (Eu i i) = qd v i i) :
