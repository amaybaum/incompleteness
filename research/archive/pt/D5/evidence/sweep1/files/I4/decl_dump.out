=== QuasilocalCharacterization.lean:227 def localHom
DOC 226: /-- The factored map is a star algebra homomorphism. -/
SIG 227: noncomputable def localHom : localAlg ι Q →⋆ₐ[ℂ] S.A where
SIG 228:   toFun := localMap S
SIG 229:   map_one' := by rw [← ofM_one (∅ : Finset ι), localMap_ofM, map_one]
SIG 230:   map_mul' a b := by
SIG 231:     obtain ⟨Λ, X, Y, rfl, rfl⟩ := exists_ofM₂ a b
SIG 232:     rw [← ofM_mul, localMap_ofM, localMap_ofM, localMap_ofM, map_mul]
SIG 233:   map_zero' := by rw [← ofM_zero (∅ : Finset ι), localMap_ofM, map_zero]
SIG 234:   map_add' a b := by
SIG 235:     obtain ⟨Λ, X, Y, rfl, rfl⟩ := exists_ofM₂ a b
SIG 236:     rw [← ofM_add, localMap_ofM, localMap_ofM, localMap_ofM, map_add]
SIG 237:   commutes' c := by
SIG 238:     rw [Algebra.algebraMap_eq_smul_one, ← ofM_one (∅ : Finset ι), ← ofM_smul, localMap_ofM,
SIG 239:       map_smul, map_one, Algebra.algebraMap_eq_smul_one]
SIG 240:   map_star' a := by
SIG 241:     obtain ⟨Λ, X, rfl⟩ := exists_ofM a
SIG 242:     rw [star_ofM, localMap_ofM, localMap_ofM, ← Matrix.star_eq_conjTranspose, map_star]
