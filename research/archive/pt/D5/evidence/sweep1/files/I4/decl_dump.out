=== CarrierGeneralOIPlus.lean:230 theorem oiPlus_independence  HEADLINE
DOC 228: /-- **THE THREE PRINCIPLES OF CARRIER-GENERAL OI⁺ ARE INDEPENDENT**, witnessed on the qubit:
DOC 229: each fails on a well-formed theory carrying the sealed core and the other two. -/
SIG 230: theorem oiPlus_independence :
SIG 231:     (∃ T : FiniteOperationalTheory (Fin 2), WellFormed T ∧ ReversibleRichness T
SIG 232:       ∧ ObserverRecursion T ∧ ¬ ObservationalIndependence T)
SIG 233:     ∧ (∃ T : FiniteOperationalTheory (Fin 2), WellFormed T ∧ ObservationalIndependence T
SIG 234:       ∧ ObserverRecursion T ∧ ¬ ReversibleRichness T)
SIG 235:     ∧ (∃ T : FiniteOperationalTheory (Fin 2), WellFormed T ∧ ObservationalIndependence T
SIG 236:       ∧ ReversibleRichness T ∧ ¬ ObserverRecursion T) := by
=== ImplementationLocality.lean:113 def twoPosTheory  HEADLINE
DOC 111: /-- **THE 2-POSITIVE-INSTRUMENT THEORY** on an arbitrary finite carrier: 2-positive branches
DOC 112: with the trace preserved in aggregate, on the system and on every composite. -/
SIG 113: noncomputable def twoPosTheory (S : Type) [Fintype S] [DecidableEq S] :
SIG 114:     FiniteOperationalTheory S where
SIG 115:   avail := fun _ _ _ F => IsTwoPositiveInstrument F
SIG 116:   availExt := fun _ _ _ _ F => IsTwoPositiveInstrument F
SIG 117:   avail_id := ⟨fun _ => by rw [← conjChannel_one]; exact conjChannel_twoPositive _, fun X => by
SIG 118:     rw [Fintype.sum_unique, LinearMap.id_apply]⟩
SIG 119:   avail_coarse := by
SIG 120:     rintro O O' _ _ _ _ F f ⟨h2, htr⟩
SIG 121:     refine ⟨fun a' => isTwoPositive_sum _ _ fun j _ => h2 j, fun X => ?_⟩
SIG 122:     rw [Finset.sum_congr rfl fun a' _ => by rw [LinearMap.sum_apply, Matrix.trace_sum],
SIG 123:       Finset.sum_fiberwise_of_maps_to (fun x _ => Finset.mem_univ (f x))
SIG 124:         (fun j => ((F j) X).trace)]
SIG 125:     exact htr X
SIG 126:   availExt_coarse := by
SIG 127:     rintro n O O' _ _ _ _ F f ⟨h2, htr⟩
SIG 128:     refine ⟨fun a' => isTwoPositive_sum _ _ fun j _ => h2 j, fun X => ?_⟩
SIG 129:     rw [Finset.sum_congr rfl fun a' _ => by rw [LinearMap.sum_apply, Matrix.trace_sum],
SIG 130:       Finset.sum_fiberwise_of_maps_to (fun x _ => Finset.mem_univ (f x))
SIG 131:         (fun j => ((F j) X).trace)]
SIG 132:     exact htr X
SIG 133:   availExt_bind := by
SIG 134:     rintro n O O' _ _ _ _ F G ⟨hF2, hFtr⟩ hG
SIG 135:     refine ⟨fun c => isTwoPositive_comp ((hG c.1).1 c.2) (hF2 c.1), fun X => ?_⟩
SIG 136:     rw [Fintype.sum_prod_type]
SIG 137:     show ∑ a, ∑ b, ((G a b) ((F a) X)).trace = X.trace
SIG 138:     rw [Finset.sum_congr rfl fun a _ => (hG a).2 ((F a) X)]
SIG 139:     exact hFtr X
SIG 140:   prepAvail := fun n P => 0 < n ∧ ∃ Φ, IsTwoPositiveInstrument (fun _ : Unit => Φ)
SIG 141:     ∧ P = Φ.comp (uniformAttach n)
SIG 142:   prepAvail_uniform := fun n =>
SIG 143:     ⟨n.succ_pos, LinearMap.id,
SIG 144:       ⟨fun _ => by rw [← conjChannel_one]; exact conjChannel_twoPositive _, fun X => by
SIG 145:         rw [Fintype.sum_unique, LinearMap.id_apply]⟩, by rw [LinearMap.id_comp]⟩
SIG 146:   prepAvail_post := by
SIG 147:     rintro n P Φ ⟨hn, Ψ, ⟨hΨ2, hΨtr⟩, rfl⟩ ⟨hΦ2, hΦtr⟩
SIG 148:     refine ⟨hn, Φ.comp Ψ, ⟨fun _ => isTwoPositive_comp (hΦ2 ()) (hΨ2 ()), fun X => ?_⟩,
SIG 149:       by rw [LinearMap.comp_assoc]⟩
SIG 150:     rw [Fintype.sum_unique]
SIG 151:     have h1 := hΦtr (Ψ X)
SIG 152:     rw [Fintype.sum_unique] at h1
SIG 153:     have h2 := hΨtr X
SIG 154:     rw [Fintype.sum_unique] at h2
SIG 155:     exact h1.trans h2
SIG 156:   readout := fun _ k => localLuders k
SIG 157:   readout_avail := fun _ => ⟨fun k => localLuders_twoPositive k, localLuders_trace_sum⟩
SIG 158:   readout_local := fun _ k => localLuders_mapSpectatorIndependent k
SIG 159:   prepAvail_discard := by
SIG 160:     rintro n P O _ _ F ⟨hn, Φ, ⟨hΦ2, hΦtr⟩, rfl⟩ ⟨hF2, hFtr⟩
SIG 161:     refine ⟨fun a => ?_, fun X => ?_⟩
SIG 162:     · show IsTwoPositive (discardWith n (Φ.comp (uniformAttach n)) (F a))
SIG 163:       have h : discardWith n (Φ.comp (uniformAttach n)) (F a)
SIG 164:           = discardWith n (uniformAttach n) ((F a).comp Φ) := by
SIG 165:         simp only [discardWith, LinearMap.comp_assoc]
SIG 166:       rw [h]
SIG 167:       exact discardWith_uniform_twoPositive (isTwoPositive_comp (hF2 a) (hΦ2 ()))
SIG 168:     · show ∑ a, ((discardWith n (Φ.comp (uniformAttach n)) (F a)) X).trace = X.trace
SIG 169:       rw [Finset.sum_congr rfl fun a _ => discardWith_trace n _ (F a) X, hFtr]
SIG 170:       have h := hΦtr (uniformAttach n X)
SIG 171:       rw [Fintype.sum_unique] at h
SIG 172:       exact h.trans (uniformAttach_trace n hn.ne' X)
