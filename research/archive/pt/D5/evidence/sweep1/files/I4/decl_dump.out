SIG 222:   | perm {T : Type} [Fintype T] [DecidableEq T] (K : Matrix T T ℂ) (h : permClass T K) : PolGen T K
SIG 223:   | shear (n : ℕ) : PolGen (Fin 2 × Fin n) (siteShearImage n)
SIG 224:   | swap (n : ℕ) : PolGen (Fin 2 × Fin n) (siteSwapImage n)
SIG 225:   | mul {T : Type} [Fintype T] [DecidableEq T] (K L : Matrix T T ℂ) :
SIG 226:       PolGen T K → PolGen T L → PolGen T (K * L)
SIG 227:   | smul {T : Type} [Fintype T] [DecidableEq T] (a : ℂ) (K : Matrix T T ℂ) (ha : ‖a‖ ≤ 1) :
SIG 228:       PolGen T K → PolGen T (a • K)
SIG 229:   | proj {T : Type} [Fintype T] [DecidableEq T] (m : ℕ) (k : Fin m) :
SIG 230:       PolGen (T × Fin m) (Matrix.diagonal fun r => if r.2 = k then 1 else 0)
SIG 231:   | block {T : Type} [Fintype T] [DecidableEq T] (m : ℕ) (K : Matrix (T × Fin m) (T × Fin m) ℂ)
SIG 232:       (f e : Fin m) : PolGen (T × Fin m) K → PolGen T (ancBlock K f e)
