=== EmbeddedObservation.lean:237 def cpTheory  HEADLINE
DOC 234: /-- **THE CP-INSTRUMENT THEORY** on an arbitrary finite carrier: completely positive branches
DOC 235: with the trace preserved in aggregate, on the system and on every composite; preparations
DOC 236: are the uniform attachment followed by an available channel. -/
SIG 237: noncomputable def cpTheory (S : Type) [Fintype S] [DecidableEq S] :
SIG 238:     FiniteOperationalTheory S where
SIG 239:   avail := fun _ _ _ F => IsCPInstrument F
SIG 240:   availExt := fun _ _ _ _ F => IsCPInstrument F
SIG 241:   avail_id := ⟨fun _ => by rw [← conjChannel_one]; exact conjChannel_cp _, fun X => by
SIG 242:     rw [Fintype.sum_unique, LinearMap.id_apply]⟩
SIG 243:   avail_coarse := by
SIG 244:     rintro O O' _ _ _ _ F f ⟨h2, htr⟩
SIG 245:     refine ⟨fun a' => cp_sum _ _ fun j _ => h2 j, fun X => ?_⟩
SIG 246:     rw [Finset.sum_congr rfl fun a' _ => by rw [LinearMap.sum_apply, Matrix.trace_sum],
SIG 247:       Finset.sum_fiberwise_of_maps_to (fun x _ => Finset.mem_univ (f x))
SIG 248:         (fun j => ((F j) X).trace)]
SIG 249:     exact htr X
SIG 250:   availExt_coarse := by
SIG 251:     rintro n O O' _ _ _ _ F f ⟨h2, htr⟩
SIG 252:     refine ⟨fun a' => cp_sum _ _ fun j _ => h2 j, fun X => ?_⟩
SIG 253:     rw [Finset.sum_congr rfl fun a' _ => by rw [LinearMap.sum_apply, Matrix.trace_sum],
SIG 254:       Finset.sum_fiberwise_of_maps_to (fun x _ => Finset.mem_univ (f x))
SIG 255:         (fun j => ((F j) X).trace)]
SIG 256:     exact htr X
SIG 257:   availExt_bind := by
SIG 258:     rintro n O O' _ _ _ _ F G ⟨hF2, hFtr⟩ hG
SIG 259:     refine ⟨fun c => cp_comp ((hG c.1).1 c.2) (hF2 c.1), fun X => ?_⟩
SIG 260:     rw [Fintype.sum_prod_type]
SIG 261:     show ∑ a, ∑ b, ((G a b) ((F a) X)).trace = X.trace
SIG 262:     rw [Finset.sum_congr rfl fun a _ => (hG a).2 ((F a) X)]
SIG 263:     exact hFtr X
SIG 264:   prepAvail := fun n P => 0 < n ∧ ∃ Φ, IsCPInstrument (fun _ : Unit => Φ)
SIG 265:     ∧ P = Φ.comp (uniformAttach n)
SIG 266:   prepAvail_uniform := fun n =>
SIG 267:     ⟨n.succ_pos, LinearMap.id,
SIG 268:       ⟨fun _ => by rw [← conjChannel_one]; exact conjChannel_cp _, fun X => by
SIG 269:         rw [Fintype.sum_unique, LinearMap.id_apply]⟩, by rw [LinearMap.id_comp]⟩
SIG 270:   prepAvail_post := by
SIG 271:     rintro n P Φ ⟨hn, Ψ, ⟨hΨcp, hΨtr⟩, rfl⟩ ⟨hΦcp, hΦtr⟩
SIG 272:     refine ⟨hn, Φ.comp Ψ, ⟨fun _ => cp_comp (hΦcp ()) (hΨcp ()), fun X => ?_⟩,
SIG 273:       by rw [LinearMap.comp_assoc]⟩
SIG 274:     rw [Fintype.sum_unique]
SIG 275:     have h1 := hΦtr (Ψ X)
SIG 276:     rw [Fintype.sum_unique] at h1
SIG 277:     have h2 := hΨtr X
SIG 278:     rw [Fintype.sum_unique] at h2
SIG 279:     exact h1.trans h2
SIG 280:   readout := fun _ k => localLuders k
SIG 281:   readout_avail := fun _ => ⟨fun k => localLuders_cp k, localLuders_trace_sum⟩
SIG 282:   readout_local := fun _ k => localLuders_mapSpectatorIndependent k
SIG 283:   prepAvail_discard := by
SIG 284:     rintro n P O _ _ F ⟨hn, Φ, ⟨hΦcp, hΦtr⟩, rfl⟩ ⟨hFcp, hFtr⟩
SIG 285:     refine ⟨fun a => ?_, fun X => ?_⟩
SIG 286:     · show IsCompletelyPositive (discardWith n (Φ.comp (uniformAttach n)) (F a))
SIG 287:       have h : discardWith n (Φ.comp (uniformAttach n)) (F a)
SIG 288:           = discardWith n (uniformAttach n) ((F a).comp Φ) := by
SIG 289:         simp only [discardWith, LinearMap.comp_assoc]
SIG 290:       rw [h]
SIG 291:       exact discardWith_uniform_cp (cp_comp (hFcp a) (hΦcp ()))
SIG 292:     · show ∑ a, ((discardWith n (Φ.comp (uniformAttach n)) (F a)) X).trace = X.trace
SIG 293:       rw [Finset.sum_congr rfl fun a _ => discardWith_trace n _ (F a) X, hFtr]
SIG 294:       have h := hΦtr (uniformAttach n X)
SIG 295:       rw [Fintype.sum_unique] at h
SIG 296:       exact h.trans (uniformAttach_trace n hn.ne' X)
