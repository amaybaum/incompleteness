SIG 863:     ⟨n.succ_pos, LinearMap.id, instAvail_id (arch.one _), by rw [LinearMap.id_comp]⟩
SIG 864:   prepAvail_post := by
SIG 865:     rintro n P Φ ⟨hn, Ψ, hΨ, rfl⟩ hΦ
SIG 866:     exact ⟨hn, Φ.comp Ψ, instAvail_one_comp hΦ hΨ, by rw [LinearMap.comp_assoc]⟩
