=== MinimalRepertoire.lean:250 def colourAlg  HEADLINE
DOC 248: /-- **THE COLOUR ALGEBRA**: the matrices the colour phase carries into the real antisymmetric
DOC 249: matrices, a real Lie subalgebra with zero diagonal. -/
SIG 250: def colourAlg (c : S → Bool) : LieSubalgebra ℝ (Matrix S S ℂ) where
SIG 251:   carrier := {M | IsRealAntisym (colourPhase c * M * (colourPhase c)ᴴ)}
SIG 252:   add_mem' := fun {M M'} hM hM' => by
SIG 253:     show IsRealAntisym (colourPhase c * (M + M') * (colourPhase c)ᴴ)
SIG 254:     rw [Matrix.mul_add, Matrix.add_mul]
SIG 255:     exact IsRealAntisym.add hM hM'
SIG 256:   zero_mem' := by
SIG 257:     show IsRealAntisym (colourPhase c * 0 * (colourPhase c)ᴴ)
SIG 258:     rw [Matrix.mul_zero, Matrix.zero_mul]
SIG 259:     exact IsRealAntisym.zero
SIG 260:   smul_mem' := fun r M hM => by
SIG 261:     show IsRealAntisym (colourPhase c * (r • M) * (colourPhase c)ᴴ)
SIG 262:     rw [Matrix.mul_smul, Matrix.smul_mul]
SIG 263:     exact IsRealAntisym.smul hM r
SIG 264:   lie_mem' := fun {M M'} hM hM' => by
SIG 265:     show IsRealAntisym (colourPhase c * (M * M' - M' * M) * (colourPhase c)ᴴ)
SIG 266:     rw [Matrix.mul_sub, Matrix.sub_mul, ← conj_mul_conj, ← conj_mul_conj]
SIG 267:     exact IsRealAntisym.bracket hM hM'
