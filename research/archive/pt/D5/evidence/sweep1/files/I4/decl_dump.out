DOC 180: shear back first, then swap back. -/
SIG 181: theorem driveQ_left_inverse (t : ℝ) (x : Quasilocal ι (V × V)) :
SIG 182:     swapQ V (-t) (layerQ R (-t) (driveQ R t x)) = x := by
