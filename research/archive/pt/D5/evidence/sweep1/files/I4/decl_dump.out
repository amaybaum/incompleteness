SIG 1331:     (X : Matrix (Conf Λ Q) (Conf Λ Q) ℂ) (k : ℕ) :
SIG 1332:     ∃ Y : Matrix (Conf (hatIter Φ Λ k) Q) (Conf (hatIter Φ Λ k) Q) ℂ,
SIG 1333:       (heis Φ)^[k] (emb Λ X) = emb (hatIter Φ Λ k) Y := by
=== QuasilocalAlgebra.lean:1353 theorem quasilocal_completion  HEADLINE
DOC 1349: /-- **THE QUASILOCAL COMPLETION.** The finite stages embed compatibly and isometrically, the
DOC 1350: quasilocal algebra is the closure of their union, every consistent family of density matrices is
DOC 1351: a unital positive continuous functional on it, and every reversible finite-range dynamics acts on
DOC 1352: it by an isometric star automorphism. -/
SIG 1353: theorem quasilocal_completion (Φ : ReversibleDynamics ι Q) :
SIG 1354:     (∀ (Λ Λ' : Finset ι) (h : Λ ⊆ Λ') (X : Matrix (Conf Λ Q) (Conf Λ Q) ℂ),
SIG 1355:       stage Λ' (inclObs h X) = stage Λ X)
SIG 1356:     ∧ (∀ (Λ : Finset ι) (X : Matrix (Conf Λ Q) (Conf Λ Q) ℂ), ‖stage Λ X‖ = ‖X‖)
SIG 1357:     ∧ closure (⋃ Λ : Finset ι, Set.range (stage Λ (Q := Q))) = (Set.univ : Set (Quasilocal ι Q))
SIG 1358:     ∧ (∀ (ρ : ∀ Λ : Finset ι, Matrix (Conf Λ Q) (Conf Λ Q) ℂ) (hρ : IsStateFamily ρ),
SIG 1359:         quasiState hρ 1 = 1 ∧ (∀ x : Quasilocal ι Q, 0 ≤ quasiState hρ (star x * x))
SIG 1360:         ∧ ∀ (Λ : Finset ι) (X : Matrix (Conf Λ Q) (Conf Λ Q) ℂ),
SIG 1361:           quasiState hρ (stage Λ X) = (X * ρ Λ).trace)
SIG 1362:     ∧ (∀ x y : Quasilocal ι Q, heisQ Φ (x * y) = heisQ Φ x * heisQ Φ y)
SIG 1363:     ∧ (∀ x : Quasilocal ι Q, heisQ Φ (star x) = star (heisQ Φ x))
SIG 1364:     ∧ (∀ x : Quasilocal ι Q, ‖heisQ Φ x‖ = ‖x‖)
SIG 1365:     ∧ (∀ x : Quasilocal ι Q, heisQ Φ.inv (heisQ Φ x) = x) :=
=== QuasilocalCharacterization.lean:79 theorem kerOf_emb_mul_emb
DOC 78: /-- The kernel of a product of two local operators. -/
SIG 79: theorem kerOf_emb_mul_emb (Λ Λ' : Finset ι) (X : Matrix (Conf Λ Q) (Conf Λ Q) ℂ)
SIG 80:     (Y : Matrix (Conf Λ' Q) (Conf Λ' Q) ℂ) (t s : ι → Q) :
SIG 81:     kerOf (emb Λ X * emb Λ' Y) t s
SIG 82:       = ∑ g : Conf Λ' Q, Y g (glob Λ' s) * kern Λ X t (patch Λ' s g) := by
