### [K] K2Guard.lean:253 three_of_nativeGateOf_of_two_le
doc K2Guard.lean:251-252:
  | /-- **`2 ≤ d` in place of the entangling clause, relative to the available family.**
  | K1-BRIDGE-1's `dim_of_nativeGateOf` and `2 ≤ d`. -/
  > theorem three_of_nativeGateOf_of_two_le (hd : 2 ≤ d) (hE : EffectsOn (eball d) avail)
  >     (hG : PreservesBody (eball d) G) (hP1 : SharpSeed (eball d) r)
  >     (hK : BoundaryTransitive (eball d) G) (hV4 : SeedOrbitAvailable G r avail)
  >     {z : Fin d → ℝ} {N : (Fin d → ℝ) →ₗ[ℝ] (Fin d → ℝ)} {T : W d ≃ₗ[ℝ] W d}
  >     (hN : IsNot (eball d) z N) (hT : NativeGateOf (eball d) avail z N T) : d = 3 :=

### [K] DenseOrbit.lean:53 DenseBoundaryOrbit
doc DenseOrbit.lean:52-52:
  | /-- Every boundary state lies in the closure of the orbit of every boundary state. -/
  > def DenseBoundaryOrbit {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V] (Ω : Set V)
  >     (G : Set (V ≃ᵃ[ℝ] V)) : Prop :=

### [K] DenseOrbit.lean:57 denseBoundaryOrbit_of_boundaryTransitive
  > theorem denseBoundaryOrbit_of_boundaryTransitive {V : Type} [NormedAddCommGroup V] [NormedSpace ℝ V]
  >     {Ω : Set V} {G : Set (V ≃ᵃ[ℝ] V)} (hT : BoundaryTransitive Ω G) : DenseBoundaryOrbit Ω G :=

### [K] DenseOrbit.lean:243 maxConeOf_avail_eq_of_dense
doc DenseOrbit.lean:242-242:
  | /-- **The available family determines DIM-1's maximal cone** under a dense boundary orbit. -/
  > theorem maxConeOf_avail_eq_of_dense (hd : 0 < d) (hG : PreservesBody (eball d) G)
  >     (hP1 : SharpSeed (eball d) r) (hK : DenseBoundaryOrbit (eball d) G)
  >     (hV4 : SeedOrbitAvailable G r avail) (hE : EffectsOn (eball d) avail) :
  >     maxConeOf avail = maxCone (eball d) :=

### [K] NativeGateBall.lean:194 parity
doc NativeGateBall.lean:192-193:
  | /-- **S5.** An injective linear map anticommuting with `P` maps the `+1` eigenspace of `P` injectively
  | into the `−1` eigenspace and back, so the two have equal dimension. -/
  > theorem parity {V : Type*} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]
  >     (P L : V →ₗ[ℝ] V) (hL : Function.Injective L)
  >     (hanti : ∀ v, L (P v) = - P (L v)) :
  >     Module.finrank ℝ (LinearMap.ker (P - LinearMap.id))
  >       = Module.finrank ℝ (LinearMap.ker (P + LinearMap.id)) :=

### [K] NativeGateBall.lean:176 p_le_one
doc NativeGateBall.lean:174-175:
  | /-- **S4, conclusion.** If some entry of the E₊ block is nonzero (as invertibility requires), then
  | `p ≤ 1`. -/
  > theorem p_le_one (p m : ℕ)
  >     (A : Fin p → Matrix (Fin m) (Fin m) ℝ) (B : Fin p → Fin p → Matrix (Fin m) (Fin m) ℝ)
  >     (hB : ∀ r s, B r s = - B s r)
  >     (hpos : ∀ k l : Fin m, ∀ i : Fin p, ∀ s : ℝ, (s = 1 ∨ s = -1) →
  >       ∀ b : Fin p → ℝ, (∑ j, b j ^ 2) = 1 →
  >         0 ≤ (1 + s * A i k l)
  >           + ∑ j, b j * (A j k l + s * ((if j = i then (1:ℝ) else 0) + B j i k l)))
  >     (hne : ∃ r k l, A r k l ≠ 0) : p ≤ 1 :=

### [K] NativeGateBall.lean:248 dim_of_bounds
  > theorem dim_of_bounds (p q d : ℕ) (hp : p ≤ 1) (hpq : p = q) (hd : p + q + 1 = d) :
  >     d = 1 ∨ d = 3 :=

### [K] NativeGateBall.lean:105 lorentz_of_effects
doc NativeGateBall.lean:104-104:
  | /-- If every unit effect direction `b` keeps `x₀ + b·v ≥ 0`, then `x₀ ≥ 0` and `|v|² ≤ x₀²`. -/
  > theorem lorentz_of_effects (p : ℕ) (hp : 1 ≤ p) (x0 : ℝ) (v : Fin p → ℝ)
  >     (h : ∀ b : Fin p → ℝ, (∑ j, b j ^ 2) = 1 → 0 ≤ x0 + ∑ j, b j * v j) :
  >     0 ≤ x0 ∧ (∑ j, v j ^ 2) ≤ x0 ^ 2 :=

### [K] NativeGateBall.lean:255 nb1_kernel_core
doc NativeGateBall.lean:254-254:
  | /-- The kernel layer's verdict: `p_le_one`, `parity` and `dim_of_bounds` together. -/
  > theorem nb1_kernel_core :
  >     (∀ (p m : ℕ) (A : Fin p → Matrix (Fin m) (Fin m) ℝ)
  >       (B : Fin p → Fin p → Matrix (Fin m) (Fin m) ℝ),
  >       (∀ r s, B r s = - B s r) →
  >       (∀ k l : Fin m, ∀ i : Fin p, ∀ s : ℝ, (s = 1 ∨ s = -1) →
  >         ∀ b : Fin p → ℝ, (∑ j, b j ^ 2) = 1 →
  >           0 ≤ (1 + s * A i k l)
  >             + ∑ j, b j * (A j k l + s * ((if j = i then (1:ℝ) else 0) + B j i k l))) →
  >       (∃ r k l, A r k l ≠ 0) → p ≤ 1) ∧
  >     (∀ (V : Type) [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V] (P L : V →ₗ[ℝ] V),
  >       Function.Injective L → (∀ v, L (P v) = - P (L v)) →
  >       Module.finrank ℝ (LinearMap.ker (P - LinearMap.id))
  >         = Module.finrank ℝ (LinearMap.ker (P + LinearMap.id))) ∧
  >     (∀ p q d : ℕ, p ≤ 1 → p = q → p + q + 1 = d → d = 1 ∨ d = 3) :=

### [K] ParityNot.lean:42 GateRel
doc ParityNot.lean:41-41:
  | /-- The target relation and the control relation of `NativeGate`, and nothing else. -/
  > structure GateRel (N : (Fin d → ℝ) →ₗ[ℝ] (Fin d → ℝ)) (G : W d ≃ₗ[ℝ] W d) : Prop where

### [K] ParityNot.lean:137 not_even_of_gateRel
doc ParityNot.lean:136-136:
  | /-- No even dimension carries the two relations. -/
  > theorem not_even_of_gateRel {z : Fin d → ℝ} {N : (Fin d → ℝ) →ₗ[ℝ] (Fin d → ℝ)}
  >     {G : W d ≃ₗ[ℝ] W d} (hN : IsNot (eball d) z N) (hR : GateRel N G) : ¬ Even d :=

### [K] ParityNot.lean:161 piRotation_three
doc ParityNot.lean:159-160:
  | /-- **The NOT at `d = 3` is a rotation by `π`.** There is a unit axis `u` with
  | `N x = 2 (u · x) u − x`. -/
  > theorem piRotation_three {z : Fin 3 → ℝ} {N : (Fin 3 → ℝ) →ₗ[ℝ] (Fin 3 → ℝ)}
  >     {G : W 3 ≃ₗ[ℝ] W 3} (hN : IsNot (eball 3) z N) (hR : GateRel N G) :
  >     ∃ u : Fin 3 → ℝ, ∑ j, u j ^ 2 = 1 ∧ ∀ x, N x = (2 * ∑ j, u j * x j) • u - x :=

### [K] ParityNot.lean:389 not_gateRel_refl3
doc ParityNot.lean:388-388:
  | /-- The reflection `diag(1, 1, −1)` carries no pair of relations. -/
  > theorem not_gateRel_refl3 (G : W 3 ≃ₗ[ℝ] W 3) : ¬ GateRel refl3 G :=

### [K] ParityNot.lean:547 not_posFwd_gJ3
doc ParityNot.lean:546-546:
  | /-- **At `d = 3` the frame and the relations hold and forward positivity fails.** -/
  > theorem not_posFwd_gJ3 :
  >     ¬ ∀ x ∈ eball 3, ∀ y ∈ eball 3, gJ3 (prodState x y) ∈ maxCone (eball 3) :=

### [K] ParityNot.lean:704 not_posFwd_gJ5
doc ParityNot.lean:703-703:
  | /-- **At `d = 5` the frame and the relations hold and forward positivity fails.** -/
  > theorem not_posFwd_gJ5 :
  >     ¬ ∀ x ∈ eball 5, ∀ y ∈ eball 5, gJ5 (prodState x y) ∈ maxCone (eball 5) :=

### [K] OddChar.lean:184 exists_frame_gateRel_iff_odd
doc OddChar.lean:182-183:
  | /-- **The odd dimensions.** A NOT, the frame and the two relations exist on `eball d` exactly when
  | `d` is odd. -/
  > theorem exists_frame_gateRel_iff_odd (d : ℕ) :
  >     (∃ (z : Fin d → ℝ) (N : (Fin d → ℝ) →ₗ[ℝ] (Fin d → ℝ)) (G : W d ≃ₗ[ℝ] W d),
  >       IsNot (eball d) z N ∧
  >         (∀ a b : Fin 2,
  >           G (prodState (corner z a) (corner z b)) = prodState (corner z a) (corner z (a + b))) ∧
  >         GateRel N G) ↔ Odd d :=

### [K] OddChar.lean:287 not_posFwd_gRev
doc OddChar.lean:285-286:
  | /-- **At every odd dimension at least three, the frame and the relations hold and forward
  | positivity fails.** -/
  > theorem not_posFwd_gRev (k : ℕ) (hk : 1 ≤ k) :
  >     ¬ ∀ x ∈ eball (2 * k + 1), ∀ y ∈ eball (2 * k + 1),
  >       gRev k (prodState x y) ∈ maxCone (eball (2 * k + 1)) :=

### [K] RelcSelectParity.lean:354 not_even_of_relC
doc RelcSelectParity.lean:352-353:
  | /-- No even dimension carries a NOT of the ball and an invertible gate with the control
  | relation. -/
  > theorem not_even_of_relC {z : Fin d → ℝ} {N : (Fin d → ℝ) →ₗ[ℝ] (Fin d → ℝ)}
  >     {G : W d ≃ₗ[ℝ] W d} (hN : IsNot (eball d) z N)
  >     (hC : ∀ ω, actC N (G (actC N ω)) = actT N (G ω)) : ¬ Even d :=

### [K] RelcSelectBlock.lean:45 CtrlGate
doc RelcSelectBlock.lean:44-44:
  | /-- `NativeGate` without the target relation `relT`. -/
  > structure CtrlGate (Ω : Set (Fin d → ℝ)) (z : Fin d → ℝ) (N : (Fin d → ℝ) →ₗ[ℝ] (Fin d → ℝ))
  >     (G : W d ≃ₗ[ℝ] W d) : Prop where

### [K] RelcSelectBlock.lean:53 ctrlGate_of_nativeGate
  > theorem ctrlGate_of_nativeGate {Ω : Set (Fin d → ℝ)} {z : Fin d → ℝ}
  >     {N : (Fin d → ℝ) →ₗ[ℝ] (Fin d → ℝ)} {G : W d ≃ₗ[ℝ] W d} (hG : NativeGate Ω z N G) :
  >     CtrlGate Ω z N G :=

### [K] RelcSelectBlock.lean:739 dim_of_ctrlGate
doc RelcSelectBlock.lean:736-738:
  | /-- **The selector without the target relation.** Two identical copies of the Euclidean ball with
  | a gate satisfying the frame, two-sided positivity and the control relation have dimension one or
  | three. -/
  > theorem dim_of_ctrlGate {z : Fin d → ℝ} {N : (Fin d → ℝ) →ₗ[ℝ] (Fin d → ℝ)}
  >     {G : W d ≃ₗ[ℝ] W d} (hN : IsNot (eball d) z N) (hG : CtrlGate (eball d) z N G) :
  >     d = 1 ∨ d = 3 :=

### [K] RelcSelectBlock.lean:753 three_of_ctrlGate
doc RelcSelectBlock.lean:752-752:
  | /-- **The selector under the entangling clause, without the target relation.** -/
  > theorem three_of_ctrlGate {z : Fin d → ℝ} {N : (Fin d → ℝ) →ₗ[ℝ] (Fin d → ℝ)}
  >     {G : W d ≃ₗ[ℝ] W d} (hN : IsNot (eball d) z N) (hG : CtrlGate (eball d) z N G)
  >     (hE : Entangling (eball d) G) : d = 3 :=

### [K] RelcSelectSqueeze.lean:465 gSq_sep
doc RelcSelectSqueeze.lean:463-464:
  | /-- **Forward positivity does not imply inverse positivity** under the NOT, the frame and the two
  | relations at `d = 5`. -/
  > theorem gSq_sep :
  >     IsNot (eball 5) z5 n5
  >       ∧ (∀ a b : Fin 2,
  >           gSq (prodState (corner z5 a) (corner z5 b)) = prodState (corner z5 a) (corner z5 (a + b)))
  >       ∧ GateRel n5 gSq
  >       ∧ (∀ x ∈ eball 5, ∀ y ∈ eball 5, gSq (prodState x y) ∈ maxCone (eball 5))
  >       ∧ ¬ (∀ x ∈ eball 5, ∀ y ∈ eball 5, gSq.symm (prodState x y) ∈ maxCone (eball 5)) :=

### [K] RelcSelectSqueeze.lean:476 gSqInv_sep
doc RelcSelectSqueeze.lean:474-475:
  | /-- **Inverse positivity does not imply forward positivity** under the NOT, the frame and the two
  | relations at `d = 5`: the inverse of the squeezed gate. -/
  > theorem gSqInv_sep :
  >     IsNot (eball 5) z5 n5
  >       ∧ (∀ a b : Fin 2,
  >           gSq.symm (prodState (corner z5 a) (corner z5 b))
  >             = prodState (corner z5 a) (corner z5 (a + b)))
  >       ∧ GateRel n5 gSq.symm
  >       ∧ (∀ x ∈ eball 5, ∀ y ∈ eball 5, gSq (prodState x y) ∈ maxCone (eball 5))
  >       ∧ ¬ (∀ x ∈ eball 5, ∀ y ∈ eball 5, gSq.symm (prodState x y) ∈ maxCone (eball 5)) :=

### [K] RelcSelectC5.lean:393 relT_not_dimension_selecting
doc RelcSelectC5.lean:391-392:
  | /-- **Without the control relation the selector fails**: `IsNot`, the frame, two-sided
  | positivity and the target relation do not force `d = 1 ∨ d = 3`. -/
  > theorem relT_not_dimension_selecting :
  >     ¬ ∀ (d : ℕ) (z : Fin d → ℝ) (N : (Fin d → ℝ) →ₗ[ℝ] (Fin d → ℝ)) (G : W d ≃ₗ[ℝ] W d),
  >       IsNot (eball d) z N →
  >       (∀ a b : Fin 2,
  >         G (prodState (corner z a) (corner z b)) = prodState (corner z a) (corner z (a + b))) →
  >       (∀ x ∈ eball d, ∀ y ∈ eball d, G (prodState x y) ∈ maxCone (eball d)) →
  >       (∀ x ∈ eball d, ∀ y ∈ eball d, G.symm (prodState x y) ∈ maxCone (eball d)) →
  >       (∀ ω, actT N (G (actT N ω)) = G ω) →
  >       d = 1 ∨ d = 3 :=

