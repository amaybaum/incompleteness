    (U : Matrix (MinimalCarrier φ vis) (MinimalCarrier φ vis) ℂ)
    (hglue : CompatibilityDomainGlue U (quotPerm φ vis)
      {w | ClassicalBranchDomain (quotPerm φ vis) (quotVis φ vis) w}) :
    DiagonalSectorGlue U (quotPerm φ vis) :=
