"""Emit controls.py for A35 from props35.json (single source with the preregistration's Lean blocks).
usage: python3 gen_controls35.py <probe blob>"""
import json, os, sys
S = os.path.dirname(os.path.abspath(__file__))
P = json.load(open(os.path.join(S, 'props35.json')))
T34 = json.load(open(os.path.join(S, '..', 'a34', 'texts34.json')))
P34 = json.load(open(os.path.join(S, '..', 'a34', 'props34.json')))
PROBE_BLOB = sys.argv[1] if len(sys.argv) > 1 else '0' * 40
def lit(d):
    return '{\n' + ',\n'.join(' %s: %s' % (json.dumps(k, ensure_ascii=False), json.dumps(v, ensure_ascii=False)) for k, v in d.items()) + '\n}'

A34_HEAD = P34['COMPONENTS']['HEAD']
assert P['COMPONENTS']['HEAD34'] == A34_HEAD and P['COMPONENTS']['HEAD'] == A34_HEAD + P['COMPONENTS']['HEAD35']

SENT = {
 "A35-DITA-STRATIFIED": "At the frozen product configuration, the Diţă-hull package holds, at evidence level 2: the column construction `X[a,c]·D[c,b]·Y_c[b,d]` and the row construction `X[a,c]·E[a,d]·Y_a[b,d]` are realizable for every choice of flat unitary factors and unit twist phases; the product-embedded stratum lies in both hulls; the product relabellings and the conjugation carry the column hull into itself and the transpose carries it onto the row hull; and the twist phases of the column construction at fixed factors enter the feature vector injectively modulo the two gauges, so the hull through one point is infinite and no finite set of maps applied to a finite set reaches it. Beside the package, required under both decided labels: every product tuple's same-row-block, same-column-in-block cross ratios equal one; act 34's properness witness is a point of the column hull off the stratum, violating that identity, and is the column relabelling of the untwisted stratum point; a twisted point of the column hull is off the stratum; a non-product relabelling carries a stratum point off the stratum inside its isometry class; and the second real class of order sixteen is a real point of the column hull off the stratum. This is a statement about the frozen mathematical objects; it adopts no isometry as a symmetry, a principle or a law, it does not classify the isometries or the classes of the product normalized set, and it does not decide whether every realizable class near the stratum lies in a relabelled hull.",
 "A35-NOT-DITA-STRATIFIED": "At the frozen product configuration, the Diţă-hull package fails, at evidence level 2: the realizability of a construction, the containment of the stratum, the behaviour under the matrix-induced operations or the injectivity of the twist phases is false, and the witness is exhibited in the kernel; the cross-ratio identity, the witness statements and the relabelling statement hold. This is a statement about the frozen mathematical objects; it adopts no isometry as a symmetry, a principle or a law.",
 "A35-UNDECIDED": "Neither the package nor its negation was obtained. The step at which the proof stopped is named, with what would settle it."
}
CLAUSE = "Act 35 proves statements about two explicit families of realizable classes at act 29's product\nconfiguration, the column and row Diţă hulls through act 34's product-embedded stratum, and about exact\ninvariants of points on and off them, and adopts none of them as anything but mathematics. The hulls are\nmathematical objects, images of explicit parametrizations in a Euclidean space; their realizability,\ntheir containment of the stratum, their behaviour under the matrix-induced relabellings, conjugation\nand transpose, and the injectivity of the twist phases are facts about those objects and about nothing\nelse. A `DITA-STRATIFIED` verdict settles the frozen package, and a `NOT-DITA-STRATIFIED` verdict\nexhibits the failure of a named part; both leave open whether every realizable class near the stratum\nlies in a relabelled hull, which the round records as an open modulus and does not decide, and both\nleave the product normalized set unclassified. Neither verdict establishes that any admissible\ntransition law is covariant under any isometry, selects a physical law or closes `P0`. No hull, family,\nisometry, carrier, group or principle gains physical status by appearing here, and nothing here derives,\nrecognises or approaches quantum evolution."
P0_END_D = T34['P0_CASE']['A34-STRATIFIED'] + ' ' + T34['P0_STANDING_34']
P0_CASE = {
 "A35-DITA-STRATIFIED": "At the product configuration, two explicit families of realizable classes, the column and row Diţă hulls, contain the product-embedded stratum, are realizable for every choice of flat unitary factors and unit twist phases, and carry infinitely many classes through every stratum point that no finite set of maps identifies; act 34's properness witness is a column relabelling of a stratum point, so stratum membership is not an invariant of the isometry classes of the product normalized set; and, by the round's exact-computation probe, the linearized dimension of the product normalized set at a stratum point exceeds the hulls' tangent rank, 49 against 26 at the certified rational point, so the hulls do not exhaust the classes near the stratum at the linear level: an open modulus, recorded and not decided.",
 "A35-NOT-DITA-STRATIFIED": "At the product configuration, the Diţă-hull package fails at a named part, by a witness exhibited in the kernel, while the cross-ratio identity, act 34's witness as a relabelled stratum point and the non-product relabelling statement hold."
}
P0_STANDING_35 = "Nothing here classifies the product normalized set or its isometries or establishes that any admissible law is covariant under any isometry or reaches any class, `P0`'s threading part is untouched, no hull, isometry or family is adopted as a physical symmetry, principle or law, and nothing here names, endorses or excludes a selection principle."

HEADER = '''"""Track B act 35 -- the round's own static controls, frozen with the control plane.

Written before F; its blob is frozen in the preregistration beside it, and the execution adds it
with that exact blob. It reads nothing but the repository at D and at the commit under check, and
it certifies nothing on its own: the Lean kernel, the axiom audit and the release gate establish
the mathematics, the exact-computation probe replays the exact arithmetic, and the V3 verifier the
protocol. What it checks is that the execution carries the frozen statements, the frozen probe, the
frozen outcome grammar and the frozen surface edits, and nothing else.

    python3 controls.py --self-test     the duality of the two verdict propositions, the single
                                        source of every shared text, the mutation controls on
                                        synthetic inputs, and the agreement of the constants
                                        below with the preregistration beside this file
    python3 controls.py check <commit>  every control against the tree at <commit>, read from git

Exit 1 on any failure.
"""
import hashlib
import json
import os
import re
import subprocess
import sys

D = '100bb1e86931fa769a200e9b117f4f9fb0a745b9'
RDIR = 'verification/programmes/oi-qm/track-b/act-35-dita-hull/'
MODULE = 'verification/lean-mathlib/OIBridge/DitaHull.lean'
PROBE = 'verification/lean/dita_defect_probe.py'
WORKFLOW = '.github/workflows/verify.yml'
ROOT = 'verification/lean-mathlib/OIBridge.lean'
GUARD = 'verification/lean/edge_rigidity_probe.py'
CENSUS = 'verification/lean-manuscript-census.json'
ROADMAP = 'verification/ROADMAP.md'
ROADMAP_BLOB_D = '57a2381ba243c8dd3905ad867accbc65311e55bb'
GUARD_BLOB_D = 'd28e9b3cf2093984a1c453892204b9932a685b2e'
WORKFLOW_BLOB_D = 'ebef32b9fe565ebe2b17322a35b5e97bcc091b44'
PROBE_BLOB = %s
PROBE_ANCHOR = 'rooted_classification_t3 physical_c4_toy_instance; do'
PROBE_WIRED = 'rooted_classification_t3 physical_c4_toy_instance dita_defect; do'

IMPORT = 'import OIBridge.ProductStratum\\n'
WIRE_AFTER = 'import OIBridge.ProductStratum\\n'
WIRE = 'import OIBridge.DitaHull\\n'
OPEN = %s
NAMESPACE = 'DitaHull'

# ---- act 34's frozen head, which every statement of this round carries verbatim as its first part
A34_HEAD = %s

# ---- the frozen propositions, verbatim
PROPS = %s

# ---- the shared components the propositions are built from
COMPONENTS = %s

# ---- the theorems: (role, name, proposition key)
THEOREMS = %s
LABELS = [(role, nm, key) for role, nm, key in THEOREMS if role.startswith('A35-') and role[4:5].isalpha()]
COROLLARY = ('a35_c_exclusive', ['P_N'], 'P_R')
SHARED = re.compile(r'^a35_shared_[A-Za-z0-9_]+$')
UNDECIDED = 'A35-UNDECIDED'
STRATIFIED, NOT_STRATIFIED = 'A35-DITA-STRATIFIED', 'A35-NOT-DITA-STRATIFIED'
ROWS = (STRATIFIED, NOT_STRATIFIED, UNDECIDED)
STRUCTURAL = [(nm, key) for role, nm, key in THEOREMS if role in ('A35-1', 'A35-1 corollary', 'A35-2', 'A35-7')]
ALWAYS = [(nm, key) for role, nm, key in THEOREMS if role in ('A35-3', 'A35-4', 'A35-5', 'A35-6', 'control')]
REQUIRED = {STRATIFIED: STRUCTURAL + ALWAYS, NOT_STRATIFIED: ALWAYS, UNDECIDED: []}
OUTCOME_RE = re.compile(r'\\*\\*Outcome:\\*\\* `(A35-[A-Z-]+)`')
LABEL_RE = re.compile(r'A35-(?:NOT-DITA-STRATIFIED|DITA-STRATIFIED|UNDECIDED)')

SENTENCES = %s
CLAUSE = %s
MENTION = 'THE CLAUSE, carried at this mention'

# ---- the `P0` cell: the end of the cell at D, and the sentence appended per decided case
P0_END_D = %s
P0_CASE = %s
P0_STANDING_35 = %s

CENSUS_MODULES = ['DitaHull']
'''

BODY = r'''
_BAD_CMD = re.compile(r'(?m)^[ \t]*(?:@\[[^\]\n]*\][ \t]*)?(?:private[ \t]+|protected[ \t]+|noncomputable[ \t]+|'
                      r'unsafe[ \t]+|partial[ \t]+)*(?:def|abbrev|structure|class|instance|inductive|axiom|opaque|'
                      r'example|variable|include|omit|section|macro|syntax|elab|notation|infix|prefix|postfix|'
                      r'set_option|import|attribute|local|scoped|universe|initialize|deriving|mutual|declare_syntax_cat)\b')
_BAD_TOKEN = re.compile(r'\b(?:sorry|native_decide|admit|unsafe|implemented_by|extern)\b')


def norm(t):
    t = ' '.join(t.split())
    t = re.sub(r'\( ', '(', t)
    return re.sub(r' \)', ')', t)


def qnorm(t):
    return ' '.join(re.sub(r'(?m)^[ \t]*>[ \t]?', '', t).split())


def sha(t):
    return hashlib.sha256(t.encode('utf-8')).hexdigest()


PARTS = ('HULL', 'HULLT', 'SIGMA', 'EXT', 'MOD', 'INF')


def dual_texts(c):
    """The two verdict propositions, rebuilt from their shared components."""
    r = c['HEAD'] + '  ' + '\n  ∧ '.join('(' + c[k] + ')' for k in PARTS)
    n = c['HEAD'] + '  ' + '\n  ∨ '.join('¬ (' + c[k] + ')' for k in PARTS)
    return r, n


SOURCE_TABLE = (
    ('HULL', 'HEAD', 1), ('HULLT', 'HEAD', 1), ('SUB', 'HEAD', 1), ('SIGMA', 'HEAD', 1), ('CROSS', 'HEAD', 1), ('WIT', 'HEAD', 1),
    ('TWIST', 'HEAD', 1), ('RELAB', 'HEAD', 1), ('EXT', 'HEAD', 1), ('MOD', 'HEAD', 1), ('INF', 'HEAD', 1), ('UNTW', 'HEAD', 1),
    ('REAL2', 'HEAD', 1), ('P_R', 'HEAD', 1), ('P_N', 'HEAD', 1),
    ('HULL', 'HULL', 1), ('HULLT', 'HULLT', 1), ('SUB', 'SUB', 1), ('SIGMA', 'SIGMA', 1), ('CROSS', 'CROSS', 1), ('WIT', 'WIT', 1),
    ('TWIST', 'TWIST', 1), ('RELAB', 'RELAB', 1), ('EXT', 'EXT', 1), ('MOD', 'MOD', 1), ('INF', 'INF', 1), ('UNTW', 'UNTW', 1),
    ('REAL2', 'REAL2', 1),
    ('P_R', 'PKG', 1), ('P_R', 'HULL', 1), ('P_R', 'HULLT', 1), ('P_R', 'SIGMA', 1), ('P_R', 'EXT', 1), ('P_R', 'MOD', 1), ('P_R', 'INF', 1),
    ('P_N', 'HULL', 1), ('P_N', 'HULLT', 1), ('P_N', 'SIGMA', 1), ('P_N', 'EXT', 1), ('P_N', 'MOD', 1), ('P_N', 'INF', 1),
    ('WIT', 'WITH', 1), ('WIT', 'F4I', 1), ('WIT', 'F4T', 1), ('WIT', 'RHO', 1), ('INF', 'FAM', 1),
    ('TWIST', 'F4I', 0), ('UNTW', 'F4I', 0), ('REAL2', 'F4I', 0),
)


def duality_ok(props, comps):
    """P_R is the conjunction of the six package statements over one head and P_N the disjunction of
    their negations, so each verdict is the other's negation; every other statement carries the one
    head; the head is act 34's frozen head followed by this round's objects; the witness statement
    carries act 34's witness text and the frozen relabelling."""
    f = []
    r, n = dual_texts(comps)
    if norm(props['P_R']) != norm(r):
        f.append('duality:P_R-is-not-the-frozen-conjunction')
    if norm(props['P_N']) != norm(n):
        f.append('duality:P_N-is-not-the-frozen-disjunction')
    if norm(comps['PKG']) != norm('\n  ∧ '.join('(' + comps[k] + ')' for k in PARTS)):
        f.append('duality:PKG-is-not-the-conjunction-of-the-six')
    if comps['HEAD34'] != A34_HEAD or comps['HEAD'] != comps['HEAD34'] + comps['HEAD35']:
        f.append('source:head-is-not-act-34s-head-followed-by-this-rounds-objects')
    for key, comp, k in SOURCE_TABLE:
        if norm(props[key]).count(norm(comps[comp])) != k:
            f.append('source:%s-does-not-carry-%s-%d-times' % (key, comp, k))
    return f


def strip_comments(src):
    out, i, depth, n = [], 0, 0, len(src)
    while i < n:
        if src.startswith('/-', i):
            depth += 1
            i += 2
        elif depth and src.startswith('-/', i):
            depth -= 1
            i += 2
        elif depth:
            out.append('\n' if src[i] == '\n' else ' ')
            i += 1
        elif src.startswith('--', i):
            j = src.find('\n', i)
            i = n if j < 0 else j
        else:
            out.append(src[i])
            i += 1
    return ''.join(out)


_THM = re.compile(r'(?m)^[ \t]*(?:@\[[^\]\n]*\][ \t]*)?(?:private[ \t]+|protected[ \t]+)?'
                  r'(?:theorem|lemma)[ \t]+(\S+)')


_END = re.compile(r':=[ \t]*(?:by\b|\n)')


def theorems(code):
    """name -> the text between the name and the `:=` that opens the proof: the first `:=` followed
    by `by` or by the end of its line, so that a `let x := v` inside a statement does not end it."""
    out = {}
    for m in _THM.finditer(code):
        nm = m.group(1)
        rest = code[m.end():]
        e = _END.search(rest)
        out[nm] = None if nm in out else (rest if e is None else rest[:e.start()])
    return out


def statement(key):
    return norm(': ' + PROPS[key])


def corollary_statement():
    nm, prem, concl = COROLLARY
    return norm(': ' + ' → '.join('(' + PROPS[p] + ')' for p in prem) + ' → ¬ (' + PROPS[concl] + ')')


# ---- the module -------------------------------------------------------------------------------
def module_label(src):
    f = []
    if not src.startswith(IMPORT):
        f.append('module:first-line-is-not-the-frozen-import')
    code = strip_comments(src)
    body = code[len(IMPORT):] if code.startswith(IMPORT) else code
    if _BAD_CMD.search(body):
        f.append('module:forbidden-command:' + _BAD_CMD.search(body).group(0).strip())
    if _BAD_TOKEN.search(code):
        f.append('module:forbidden-token:' + _BAD_TOKEN.search(code).group(0))
    opens = [m.start() for m in re.finditer(r'(?m)^[ \t]*open\b', code)]
    if len(opens) != 1 or not code[opens[0]:].startswith(OPEN):
        f.append('module:open-is-not-exactly-the-frozen-one')
    if 'namespace OIBridge\nnamespace %s\n' % NAMESPACE not in code or \
            not code.rstrip().endswith('end %s\nend OIBridge' % NAMESPACE):
        f.append('module:namespace')
    th = theorems(code)
    if any(v is None for v in th.values()):
        f.append('module:theorem-declared-twice')
    if opens and th and min(m.start() for m in _THM.finditer(code)) < opens[0]:
        f.append('module:theorem-before-open')
    printed = re.findall(r'(?m)^[ \t]*#print[ \t]+axioms[ \t]+(\S+)[ \t]*$', code)
    if sorted(printed) != sorted(set(printed)):
        f.append('module:axioms-printed-twice')
    for nm in th:
        if nm not in printed:
            f.append('module:no-print-axioms:' + nm)
    for nm in printed:
        if nm not in th:
            f.append('module:print-axioms-of-no-theorem:' + nm)
    names = {x[1] for x in LABELS} | {COROLLARY[0]} | {x[0] for x in STRUCTURAL + ALWAYS}
    for nm in th:
        if nm not in names and not SHARED.match(nm):
            f.append('module:theorem-name-outside-the-frozen-set:' + nm)
    earned = []
    for lab, nm, key in LABELS:
        if nm in th and th[nm] is not None:
            if norm(th[nm]) != statement(key):
                f.append('module:statement-not-frozen:' + nm)
            earned.append(lab)
    if len(earned) > 1:
        f.append('module:both-labels')
        return None, f
    label = earned[0] if earned else UNDECIDED
    if COROLLARY[0] not in th:
        f.append('module:required-corollary-absent:' + COROLLARY[0])
    elif th[COROLLARY[0]] is not None and norm(th[COROLLARY[0]]) != corollary_statement():
        f.append('module:statement-not-frozen:' + COROLLARY[0])
    for nm, key in STRUCTURAL + ALWAYS:
        if nm in th and th[nm] is not None and norm(th[nm]) != statement(key):
            f.append('module:statement-not-frozen:' + nm)
    for nm, key in REQUIRED[label]:
        if nm not in th:
            f.append('module:required-statement-absent:' + nm)
    return label, f


# ---- the result note ---------------------------------------------------------------------------
def note_ok(note, label):
    f = []
    found = OUTCOME_RE.findall(note)
    if found != [label]:
        f.append('note:outcome-line:%s' % found)
    q = qnorm(note)
    if q.count(qnorm(SENTENCES[label])) != 1:
        f.append('note:frozen-sentence:' + label)
    for lab in SENTENCES:
        if lab != label and qnorm(SENTENCES[lab]) in q:
            f.append('note:sentence-of-a-label-not-earned:' + lab)
    body = qnorm(CLAUSE)
    if note.count(MENTION) != 1 or q.count(body) != 1 or \
            not 0 <= q.index(body) - q.index(MENTION) <= 80:
        f.append('note:the-clause')
    for nm, _ in REQUIRED[label]:
        if '`%s`' % nm not in note:
            f.append('note:required-statement-not-named:' + nm)
    if 'dita_defect_probe: OK' not in note:
        f.append('note:probe-summary-line-absent')
    return f


# ---- the surfaces ------------------------------------------------------------------------------
def expected_roadmap(road_d, label):
    if label == UNDECIDED:
        return road_d
    old = ' ' + P0_END_D + ' |'
    if road_d.count(old) != 1:
        return None
    return road_d.replace(old, ' ' + P0_END_D + ' ' + P0_CASE[label] + ' ' + P0_STANDING_35 + ' |', 1)


def census_ok(cen_d, cen_e, label):
    f = []
    try:
        d, e = json.loads(cen_d), json.loads(cen_e)
    except ValueError:
        return ['census:not-json']
    if cen_e != json.dumps(e, indent=2, ensure_ascii=False) + '\n':
        f.append('census:not-in-the-registry-format')
    fams = e.get('families', [])
    mine = [x for x in fams if CENSUS_MODULES[0] in x.get('modules', [])]
    if len(mine) != 1 or fams[-1:] != mine:
        return f + ['census:family-count-or-place']
    m = mine[0]
    if m.get('modules') != CENSUS_MODULES or m.get('status') != 'kernel-only' or \
            m.get('manuscript') != []:
        f.append('census:family-disposition')
    if LABEL_RE.findall(m.get('note', '')) != [label]:
        f.append('census:outcome')
    if dict(e, families=fams[:-1]) != d:
        f.append('census:another-entry-changed')
    return f


def wire_ok(root_d, root_e):
    if root_d.count(WIRE_AFTER) != 1:
        return ['wire:anchor']
    return [] if root_e == root_d.replace(WIRE_AFTER, WIRE_AFTER + WIRE, 1) else ['wire:root']


def workflow_ok(wf_d, wf_e):
    if wf_d.count(PROBE_ANCHOR) != 1:
        return ['workflow:anchor']
    return [] if wf_e == wf_d.replace(PROBE_ANCHOR, PROBE_WIRED, 1) else ['workflow:not-D-with-the-probe-wired']


def expected_paths(label):
    p = {RDIR + 'preregistration.md': 'A', RDIR + 'controls.py': 'A', RDIR + 'result.md': 'A',
         MODULE: 'A', PROBE: 'A', ROOT: 'M', CENSUS: 'M', WORKFLOW: 'M'}
    if label != UNDECIDED:
        p[ROADMAP] = 'M'
    return p


EXPECTED_PROBE_BLOB = [PROBE_BLOB]


def check_all(files_d, files_e, delta):
    f = duality_ok(PROPS, COMPONENTS)
    label, g = module_label(files_e.get(MODULE, ''))
    f += g
    if label is None:
        return f
    f += note_ok(files_e.get(RDIR + 'result.md', ''), label)
    road = expected_roadmap(files_d[ROADMAP], label)
    if road is None or files_e.get(ROADMAP) != road:
        f.append('roadmap:not-as-frozen-for-the-case')
    if files_e.get(GUARD) != files_d[GUARD]:
        f.append('guard:not-byte-identical-to-D')
    f += census_ok(files_d[CENSUS], files_e.get(CENSUS, ''), label)
    f += wire_ok(files_d[ROOT], files_e.get(ROOT, ''))
    f += workflow_ok(files_d[WORKFLOW], files_e.get(WORKFLOW, ''))
    if blob_id(files_e.get(PROBE, '')) != EXPECTED_PROBE_BLOB[0]:
        f.append('probe:not-the-frozen-blob')
    if delta != expected_paths(label):
        f.append('paths:delta-is-not-the-frozen-set')
    return f


# ---- git ---------------------------------------------------------------------------------------
def git(*a):
    return subprocess.run(('git',) + a, capture_output=True, check=True).stdout


def blob_id(text):
    b = text.encode('utf-8')
    return hashlib.sha1(b'blob %d\0' % len(b) + b).hexdigest()


def cmd_check(commit):
    paths = (MODULE, ROOT, GUARD, CENSUS, ROADMAP, WORKFLOW, PROBE, RDIR + 'result.md')
    fd, fe = {}, {}
    for p in paths:
        for ref, dst in ((D, fd), (commit, fe)):
            try:
                dst[p] = git('show', '%s:%s' % (ref, p)).decode('utf-8')
            except subprocess.CalledProcessError:
                pass
    f = []
    if blob_id(fd[ROADMAP]) != ROADMAP_BLOB_D or blob_id(fd[GUARD]) != GUARD_BLOB_D or blob_id(fd[WORKFLOW]) != WORKFLOW_BLOB_D:
        f.append('base:D-is-not-the-frozen-base')
    delta = {}
    for ln in git('diff', '--no-renames', '--name-status', D, commit).decode().splitlines():
        st, p = ln.split('\t', 1)
        delta[p] = st
    f += check_all(fd, fe, delta)
    label, _ = module_label(fe.get(MODULE, ''))
    print('controls: label read off the module:', label)
    print('controls: %d path(s) changed from D' % len(delta))
    return f


# ---- the self-test -----------------------------------------------------------------------------
def _module(label, extra='', drop=(), stmt=None):
    parts = [IMPORT, '/-! synthetic -/\n', 'namespace OIBridge\nnamespace %s\n\n' % NAMESPACE,
             OPEN, '\n']

    def th(nm, s):
        parts.append('theorem %s :\n    %s := by\n  exact test\n#print axioms %s\n\n' % (nm, s, nm))
    th('a35_shared_x', 'True')
    for nm, key in REQUIRED[label]:
        if nm not in drop:
            th(nm, (stmt or {}).get(nm, PROPS[key]))
    for lab, nm, key in LABELS:
        if lab == label and nm not in drop:
            th(nm, (stmt or {}).get(nm, PROPS[key]))
    if COROLLARY[0] not in drop:
        th(COROLLARY[0], (stmt or {}).get(COROLLARY[0], corollary_statement()[2:]))
    parts.append(extra)
    parts.append('end %s\nend OIBridge\n' % NAMESPACE)
    return ''.join(parts)


def _note(label):
    parts = ['# result\n\n**Outcome:** `%s`\n\n' % label, '> ' + SENTENCES[label] + '\n\n']
    parts.append('> **' + MENTION + ' — the result note.**\n'
                 + '\n'.join('> ' + l for l in CLAUSE.split('\n')) + '\n\n')
    parts.append(' '.join('`%s`' % nm for nm, _ in REQUIRED[label]) + '\n\ndita_defect_probe: OK -- x\n')
    return ''.join(parts)


def _synthetic_d():
    road = '| **P0** | q | x | Act 25 a. Act 33 b. ' + P0_END_D + ' | y |\n'
    cen = json.dumps({'families': [{'name': 'x', 'modules': ['X'], 'status': 'kernel-only',
                                    'manuscript': [], 'note': 'n'}]},
                     indent=2, ensure_ascii=False) + '\n'
    return {ROADMAP: road, CENSUS: cen, ROOT: 'import A\n' + WIRE_AFTER + 'import B\n', GUARD: '# guard\n',
            WORKFLOW: 'jobs:\n  for p in a b \\\n         ' + PROBE_ANCHOR + '\n    python3 x\n'}


def _synthetic_e(fd, label):
    fe = {MODULE: _module(label), RDIR + 'result.md': _note(label),
          ROADMAP: expected_roadmap(fd[ROADMAP], label), GUARD: fd[GUARD], PROBE: '# synthetic probe\n'}
    c = json.loads(fd[CENSUS])
    c['families'].append({'name': 'act 35', 'modules': CENSUS_MODULES,
                          'status': 'kernel-only', 'manuscript': [],
                          'note': 'Outcome: ' + label + '.'})
    fe[CENSUS] = json.dumps(c, indent=2, ensure_ascii=False) + '\n'
    fe[ROOT] = fd[ROOT].replace(WIRE_AFTER, WIRE_AFTER + WIRE, 1)
    fe[WORKFLOW] = fd[WORKFLOW].replace(PROBE_ANCHOR, PROBE_WIRED, 1)
    return fe, expected_paths(label)


def self_test():
    bad = []
    here = os.path.dirname(os.path.abspath(__file__))
    pre = os.path.join(here, 'preregistration.md')
    if not os.path.exists(pre):
        bad.append('agreement: preregistration.md not beside controls.py')
    else:
        text = open(pre, encoding='utf-8').read()
        q, n = qnorm(text), norm(text)
        for k, v in PROPS.items():
            if norm(v) not in n:
                bad.append('agreement: proposition %s not in the preregistration' % k)
        for k, v in list(SENTENCES.items()) + [('clause', CLAUSE), ('end-of-cell', P0_END_D),
                                               ('standing-35', P0_STANDING_35)] + list(P0_CASE.items()):
            if qnorm(v) not in q:
                bad.append('agreement: %s not in the preregistration' % k)
        for b in (ROADMAP_BLOB_D, GUARD_BLOB_D, WORKFLOW_BLOB_D, PROBE_BLOB, D):
            if b not in text:
                bad.append('agreement: %s not in the preregistration' % b)
        for role, nm, key in THEOREMS:
            if '`%s`' % nm not in text:
                bad.append('agreement: theorem %s not in the preregistration' % nm)
    for a, x in SENTENCES.items():
        for b, y in SENTENCES.items():
            if a != b and qnorm(x) in qnorm(y):
                bad.append('distinctness: the sentence of %s lies inside that of %s' % (a, b))
    # the duality and the single source hold of the frozen texts, and fail when either is altered
    if duality_ok(PROPS, COMPONENTS):
        bad.append('duality: the frozen texts fail: %s' % duality_ok(PROPS, COMPONENTS))
    dmuts = 0
    for nm, key, old, new in (
            ('P_R-disjunction', 'P_R', '\n  ∧ (' + COMPONENTS['INF'] + ')', '\n  ∨ (' + COMPONENTS['INF'] + ')'),
            ('P_R-part-dropped', 'P_R', '\n  ∧ (' + COMPONENTS['MOD'] + ')', ''),
            ('P_N-negation-dropped', 'P_N', '\n  ∨ ¬ (' + COMPONENTS['INF'] + ')', '\n  ∨ (' + COMPONENTS['INF'] + ')'),
            ('P_N-conjunction', 'P_N', '\n  ∨ ¬ (' + COMPONENTS['MOD'] + ')', '\n  ∧ ¬ (' + COMPONENTS['MOD'] + ')'),
            ('hull-drift', 'HULL', '‖dita X Y D i j‖ = 1 / 4', '‖dita X Y D i j‖ ≤ 1 / 4'),
            ('witness-relabelling-drift', 'WIT', COMPONENTS['RHO'], '(1 : Equiv.Perm (Fin 4 × Fin 4))')):
        props = dict(PROPS)
        if props[key].count(old) < 1:
            bad.append('duality mutation %s: pattern absent' % nm)
            continue
        props[key] = props[key].replace(old, new, 1)
        dmuts += 1
        if not duality_ok(props, COMPONENTS):
            bad.append('duality mutation %s: accepted' % nm)
    comps = dict(COMPONENTS, HEAD34=COMPONENTS['HEAD34'].replace('![0, 2, 4, 2, 0, 3, 4, 5, 0]', '![0, 2, 4, 2, 0, 3, 4, 5, 1]', 1))
    dmuts += 1
    if not duality_ok(PROPS, comps):
        bad.append('duality mutation head-drift: accepted')
    comps = dict(COMPONENTS, FAM=COMPONENTS['FAM'].replace('‖D c b‖ = 1', '‖D c b‖ = 2', 1))
    dmuts += 1
    if not duality_ok(PROPS, comps):
        bad.append('duality mutation component-drift: accepted')

    fd = _synthetic_d()
    EXPECTED_PROBE_BLOB[0] = blob_id('# synthetic probe\n')
    for label in ROWS:
        fe, delta = _synthetic_e(fd, label)
        r = check_all(fd, fe, delta)
        if r:
            bad.append('positive %s: %s' % (label, r))
    ST, NS, X = ROWS
    muts = []

    def mut(name, label, fn, want):
        fe, delta = _synthetic_e(fd, label)
        fe, delta = fn(dict(fe), dict(delta))
        r = check_all(fd, fe, delta)
        muts.append(name)
        if not any(x.startswith(want) for x in r):
            bad.append('mutation %s: expected %s, got %s' % (name, want, r))

    def modstmt(label, nm, s):
        return lambda fe, dl: (dict(fe, **{MODULE: _module(label, stmt={nm: s})}), dl)
    E_ = 'end ' + NAMESPACE
    mut('definition-added', ST, lambda fe, dl: (dict(fe, **{MODULE: fe[MODULE].replace(
        E_, 'noncomputable def zz := 1\n' + E_)}), dl), 'module:forbidden-command')
    mut('variable-added', ST, lambda fe, dl: (dict(fe, **{MODULE: fe[MODULE].replace(
        '\ntheorem a35_shared_x', '\nvariable (h : False)\ntheorem a35_shared_x')}), dl),
        'module:forbidden-command')
    mut('second-open', ST, lambda fe, dl: (dict(fe, **{MODULE: fe[MODULE].replace(
        '\ntheorem a35_shared_x', '\nopen Classical in\ntheorem a35_shared_x')}), dl), 'module:open')
    mut('second-import', ST, lambda fe, dl: (dict(fe, **{MODULE: fe[MODULE].replace(
        '/-! synthetic -/', 'import Mathlib.GroupTheory.SemidirectProduct\n/-! synthetic -/')}), dl),
        'module:forbidden-command')
    mut('sorry', ST, lambda fe, dl: (dict(fe, **{MODULE: fe[MODULE].replace('exact test', 'sorry', 1)}), dl),
        'module:forbidden-token')
    mut('native-decide', ST, lambda fe, dl: (dict(fe, **{MODULE: fe[MODULE].replace('exact test', 'native_decide', 1)}), dl),
        'module:forbidden-token')
    mut('print-axioms-dropped', ST, lambda fe, dl: (dict(fe, **{MODULE: fe[MODULE].replace(
        '#print axioms a35_dita_stratified\n', '')}), dl), 'module:no-print-axioms')
    mut('stray-theorem-name', ST, lambda fe, dl: (dict(fe, **{MODULE: fe[MODULE].replace(
        E_, 'theorem a35_n : True := trivial\n#print axioms a35_n\n' + E_)}), dl),
        'module:theorem-name-outside')
    mut('stratified-weakened', ST, modstmt(ST, 'a35_dita_stratified', PROPS['P_R'].replace(
        '\n  ∧ (' + COMPONENTS['INF'] + ')', '', 1)), 'module:statement-not-frozen:a35_dita_stratified')
    mut('not-stratified-weakened', NS, modstmt(NS, 'a35_not_dita_stratified', PROPS['P_N'].replace(
        '¬ (' + COMPONENTS['HULL'] + ')', '(' + COMPONENTS['HULL'] + ')', 1)), 'module:statement-not-frozen:a35_not_dita_stratified')
    mut('hull-norm-weakened', ST, modstmt(ST, 'a35_shared_hull', PROPS['HULL'].replace(
        '‖dita X Y D i j‖ = 1 / 4', '‖dita X Y D i j‖ ≤ 1 / 4', 1)), 'module:statement-not-frozen:a35_shared_hull')
    mut('hull-t-unitarity-dropped', ST, modstmt(ST, 'a35_shared_hull_t', PROPS['HULLT'].replace(
        'ditaT X Y E ∈ Matrix.unitaryGroup (Fin 4 × Fin 4) ℂ ∧', 'True ∧', 1)), 'module:statement-not-frozen:a35_shared_hull_t')
    mut('sub-reversed', ST, modstmt(ST, 'a35_shared_hull_sub', PROPS['SUB'].replace('Δc ⊆ N', 'N ⊆ Δc', 1)),
        'module:statement-not-frozen:a35_shared_hull_sub')
    mut('sigma-reversed', ST, modstmt(ST, 'a35_shared_sigma_hull', PROPS['SIGMA'].replace('S ⊆ Δc', 'Δc ⊆ S', 1)),
        'module:statement-not-frozen:a35_shared_sigma_hull')
    mut('cross-value-altered', NS, modstmt(NS, 'a35_shared_cross', PROPS['CROSS'].replace('= 1 / 256', '= 1 / 128', 1)),
        'module:statement-not-frozen:a35_shared_cross')
    mut('witness-on-stratum', NS, modstmt(NS, 'a35_control_witness', PROPS['WIT'].replace('featureVec (gram H) ∉ S', 'featureVec (gram H) ∈ S', 1)),
        'module:statement-not-frozen:a35_control_witness')
    mut('witness-relabelling-dropped', NS, modstmt(NS, 'a35_control_witness', PROPS['WIT'].replace(
        '\n  ∧ (∀ i j, H i j = dita (F4 Complex.I) (fun _ => F4 Complex.I) (fun _ _ => 1) i (ρ j))', '', 1)),
        'module:statement-not-frozen:a35_control_witness')
    mut('witness-cross-value-altered', NS, modstmt(NS, 'a35_control_witness', PROPS['WIT'].replace('= -(1 / 256)', '= 1 / 256', 1)),
        'module:statement-not-frozen:a35_control_witness')
    mut('twist-on-stratum', NS, modstmt(NS, 'a35_control_twist', PROPS['TWIST'].replace('featureVec (gram Hw) ∉ S', 'featureVec (gram Hw) ∈ S', 1)),
        'module:statement-not-frozen:a35_control_twist')
    mut('relabel-isometry-weakened', NS, modstmt(NS, 'a35_control_relabel', PROPS['RELAB'].replace(
        '= dist (featureVec G) (featureVec G\')', '≤ dist (featureVec G) (featureVec G\')', 1)), 'module:statement-not-frozen:a35_control_relabel')
    mut('relabel-on-stratum', NS, modstmt(NS, 'a35_control_relabel', PROPS['RELAB'].replace('featureVec Pσ ∉ S', 'featureVec Pσ ∈ S', 1)),
        'module:statement-not-frozen:a35_control_relabel')
    mut('extend-conjugation-dropped', ST, modstmt(ST, 'a35_shared_extend', PROPS['EXT'].replace(
        '\n    ∧ featureVec (fun i => Matrix.of fun j k => star (gram (dita X Y D) i j k)) ∈ Δc', '', 1)), 'module:statement-not-frozen:a35_shared_extend')
    mut('modulus-conclusion-weakened', ST, modstmt(ST, 'a35_shared_modulus', PROPS['MOD'].replace(
        '∃ u v : Fin 4 → ℂ, ∀ c b, D\' c b = u c * v b * D c b', 'True', 1)), 'module:statement-not-frozen:a35_shared_modulus')
    mut('infinite-to-finite', ST, modstmt(ST, 'a35_shared_infinite', PROPS['INF'].replace('Set.Infinite', 'Set.Finite', 1)),
        'module:statement-not-frozen:a35_shared_infinite')
    mut('real-imaginary-dropped', NS, modstmt(NS, 'a35_control_real', PROPS['REAL2'].replace('(∀ i j, (Hr i j).im = 0) ∧ ', '', 1)),
        'module:statement-not-frozen:a35_control_real')
    mut('untwisted-off-stratum', NS, modstmt(NS, 'a35_control_untwisted', PROPS['UNTW'].replace('∈ S', '∉ S', 1)),
        'module:statement-not-frozen:a35_control_untwisted')
    for nm, _ in REQUIRED[ST]:
        mut('required-absent:' + nm, ST, lambda fe, dl, nm=nm: (dict(fe, **{MODULE: _module(ST, drop=(nm,))}), dl),
            'module:required-statement-absent:' + nm)
    for nm, _ in REQUIRED[NS]:
        mut('required-absent-not-stratified:' + nm, NS, lambda fe, dl, nm=nm: (dict(fe, **{MODULE: _module(NS, drop=(nm,))}), dl),
            'module:required-statement-absent:' + nm)
    mut('corollary-absent', X, lambda fe, dl: (dict(fe, **{MODULE: _module(X, drop=('a35_c_exclusive',))}), dl),
        'module:required-corollary-absent')
    mut('corollary-altered', X, lambda fe, dl: (dict(fe, **{MODULE: _module(
        X, stmt={'a35_c_exclusive': corollary_statement()[2:].replace('→ ¬ (', '→ (', 1)})}), dl),
        'module:statement-not-frozen:a35_c_exclusive')
    mut('both-labels', ST, lambda fe, dl: (dict(fe, **{MODULE: fe[MODULE].replace(
        E_, 'theorem a35_not_dita_stratified :\n    ' + PROPS['P_N'] + ' := by\n  exact test\n'
        '#print axioms a35_not_dita_stratified\n' + E_)}), dl), 'module:both-labels')
    mut('note-outcome-mismatch', ST, lambda fe, dl: (dict(fe, **{RDIR + 'result.md': fe[RDIR + 'result.md'].replace(
        '**Outcome:** `A35-DITA-STRATIFIED`', '**Outcome:** `A35-NOT-DITA-STRATIFIED`')}), dl), 'note:outcome-line')
    mut('note-second-outcome', ST, lambda fe, dl: (dict(fe, **{RDIR + 'result.md': fe[RDIR + 'result.md']
        + '\n**Outcome:** `A35-DITA-STRATIFIED`\n'}), dl), 'note:outcome-line')
    mut('note-sentence-altered', ST, lambda fe, dl: (dict(fe, **{RDIR + 'result.md': fe[RDIR + 'result.md'].replace(
        'evidence level 2', 'evidence level 3', 1)}), dl), 'note:frozen-sentence')
    mut('note-unearned-sentence', X, lambda fe, dl: (dict(fe, **{RDIR + 'result.md': fe[RDIR + 'result.md']
        + '\n' + SENTENCES[ST] + '\n'}), dl), 'note:sentence-of-a-label-not-earned')
    mut('note-clause-twice', ST, lambda fe, dl: (dict(fe, **{RDIR + 'result.md': fe[RDIR + 'result.md']
        + '\n' + CLAUSE + '\n'}), dl), 'note:the-clause')
    mut('note-clause-detached', ST, lambda fe, dl: (dict(fe, **{RDIR + 'result.md': fe[RDIR + 'result.md'].replace(
        ' — the result note.**\n', ' — the result note.**\n' + 'x ' * 60 + '\n', 1)}), dl), 'note:the-clause')
    mut('note-control-unnamed', ST, lambda fe, dl: (dict(fe, **{RDIR + 'result.md': fe[RDIR + 'result.md'].replace(
        '`a35_control_untwisted`', 'x')}), dl), 'note:required-statement-not-named')
    mut('note-structural-unnamed', ST, lambda fe, dl: (dict(fe, **{RDIR + 'result.md': fe[RDIR + 'result.md'].replace(
        '`a35_shared_modulus`', 'x')}), dl), 'note:required-statement-not-named')
    mut('note-probe-line-absent', ST, lambda fe, dl: (dict(fe, **{RDIR + 'result.md': fe[RDIR + 'result.md'].replace(
        'dita_defect_probe: OK', 'dita_defect_probe: ran')}), dl), 'note:probe-summary-line-absent')
    mut('roadmap-wrong-case', ST, lambda fe, dl: (dict(fe, **{ROADMAP: expected_roadmap(fd[ROADMAP], NS)}), dl),
        'roadmap:')
    mut('roadmap-standing-dropped', ST, lambda fe, dl: (dict(fe, **{ROADMAP: fe[ROADMAP].replace(
        P0_CASE[ST] + ' ' + P0_STANDING_35, P0_CASE[ST])}), dl), 'roadmap:')
    mut('roadmap-sentence-misplaced', ST, lambda fe, dl: (dict(fe, **{ROADMAP: fd[ROADMAP].replace(
        ' Act 25 a.', ' Act 25 a. ' + P0_CASE[ST] + ' ' + P0_STANDING_35, 1)}), dl), 'roadmap:')
    mut('roadmap-touched-when-undecided', X, lambda fe, dl: (dict(fe, **{ROADMAP: expected_roadmap(fd[ROADMAP], ST)}),
        dict(dl, **{ROADMAP: 'M'})), 'roadmap:')
    mut('guard-one-byte', ST, lambda fe, dl: (dict(fe, **{GUARD: fe[GUARD] + ' '}), dict(dl, **{GUARD: 'M'})), 'guard:')
    mut('census-status-promoted', ST, lambda fe, dl: (dict(fe, **{CENSUS: fe[CENSUS].replace(
        '"status": "kernel-only",\n      "manuscript": [],\n      "note": "Outcome',
        '"status": "manuscript-cited",\n      "manuscript": [],\n      "note": "Outcome')}), dl),
        'census:family-disposition')
    mut('census-other-entry-changed', ST, lambda fe, dl: (dict(fe, **{CENSUS: fe[CENSUS].replace(
        '"note": "n"', '"note": "m"')}), dl), 'census:another-entry-changed')
    mut('census-outcome-wrong', ST, lambda fe, dl: (dict(fe, **{CENSUS: fe[CENSUS].replace(
        'A35-DITA-STRATIFIED.', 'A35-NOT-DITA-STRATIFIED.')}), dl), 'census:outcome')
    mut('census-entry-absent', ST, lambda fe, dl: (dict(fe, **{CENSUS: fd[CENSUS]}), dl), 'census:family-count-or-place')
    mut('wire-absent', ST, lambda fe, dl: (dict(fe, **{ROOT: fd[ROOT]}), dl), 'wire:')
    mut('wire-misplaced', ST, lambda fe, dl: (dict(fe, **{ROOT: fd[ROOT] + WIRE}), dl), 'wire:')
    mut('workflow-probe-not-wired', ST, lambda fe, dl: (dict(fe, **{WORKFLOW: fd[WORKFLOW]}), dl), 'workflow:')
    mut('workflow-extra-change', ST, lambda fe, dl: (dict(fe, **{WORKFLOW: fe[WORKFLOW] + '\n'}), dl), 'workflow:')
    mut('probe-altered', ST, lambda fe, dl: (dict(fe, **{PROBE: fe[PROBE] + '\n'}), dl), 'probe:')
    mut('path-extra', ST, lambda fe, dl: (fe, dict(dl, **{'papers/SM.md': 'M'})), 'paths:')
    mut('path-missing-note', ST, lambda fe, dl: (fe, dict((k, v) for k, v in dl.items()
                                                         if k != RDIR + 'result.md')), 'paths:')
    mut('path-missing-probe', ST, lambda fe, dl: (fe, dict((k, v) for k, v in dl.items() if k != PROBE)), 'paths:')
    EXPECTED_PROBE_BLOB[0] = PROBE_BLOB
    return bad, len(ROWS), dmuts, len(muts)


def main():
    if sys.argv[1:] == ['--self-test']:
        bad, rows, dmuts, muts = self_test()
        for b in bad:
            print('  FAIL', b)
        if bad:
            print('controls: self-test FAILED')
            return 1
        print('controls: the two verdict propositions are duals and every shared text has one source; '
              '%d duality mutations fail as required' % dmuts)
        print('controls: %d rows hold as frozen, %d mutation controls fail as required' % (rows, muts))
        print('controls: self-test OK')
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == 'check':
        f = cmd_check(sys.argv[2])
        for x in f:
            print('  FAIL', x)
        print('controls: check %s' % ('FAILED' if f else 'OK'))
        return 1 if f else 0
    print(__doc__)
    return 2


if __name__ == '__main__':
    sys.exit(main())
'''

text = HEADER % (json.dumps(PROBE_BLOB), json.dumps(P['OPEN'], ensure_ascii=False), json.dumps(A34_HEAD, ensure_ascii=False),
                 lit(P['PROPS']), lit(P['COMPONENTS']),
                 json.dumps(P['THEOREMS'], ensure_ascii=False, indent=1),
                 lit(SENT), json.dumps(CLAUSE, ensure_ascii=False), json.dumps(P0_END_D, ensure_ascii=False),
                 lit(P0_CASE), json.dumps(P0_STANDING_35, ensure_ascii=False)) + BODY
open(os.path.join(S, 'controls.py'), 'w', encoding='utf-8').write(text)
json.dump({'SENTENCES': SENT, 'CLAUSE': CLAUSE, 'P0_END_D': P0_END_D, 'P0_CASE': P0_CASE, 'P0_STANDING_35': P0_STANDING_35},
          open(os.path.join(S, 'texts35.json'), 'w'), ensure_ascii=False, indent=1)
print('controls.py written', len(text))
