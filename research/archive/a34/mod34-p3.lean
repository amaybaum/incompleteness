  · apply a34_shared_dist_of_sq
    rw [a34_shared_dist_inner, a34_shared_dist_inner, ← inner_self_eq_norm_sq (𝕜 := ℂ) (featureVec (fun i : Fin 4 × Fin 4 => Matrix.of fun j k : Fin 4 × Fin 4 => Y i.1 j.1 k.1 * X i.2 j.2 k.2)), ← inner_self_eq_norm_sq (𝕜 := ℂ) (featureVec (fun i : Fin 4 × Fin 4 => Matrix.of fun j k : Fin 4 × Fin 4 => Y i.1 j.1 k.1 * X' i.2 j.2 k.2)), ← inner_self_eq_norm_sq (𝕜 := ℂ) (featureVec X), ← inner_self_eq_norm_sq (𝕜 := ℂ) (featureVec X'), a34_shared_inner_core, a34_shared_inner_core, a34_shared_inner_core, hYY, one_mul, one_mul, one_mul]
