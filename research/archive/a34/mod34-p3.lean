theorem a34_shared_feature_ext :
    ∀ G H : Fin 4 × Fin 4 → Matrix (Fin 4 × Fin 4) (Fin 4 × Fin 4) ℂ, featureVec G = featureVec H ↔ ∀ p : ((Fin 4 × Fin 4) × (Fin 4 × Fin 4) × (Fin 4 × Fin 4)) × ((Fin 4 × Fin 4) × (Fin 4 × Fin 4) × (Fin 4 × Fin 4)), mixedTriple G p = mixedTriple H p := by
  intro G H
  constructor
  · intro h p
    have := congrArg (fun x : EuclideanSpace ℂ (((Fin 4 × Fin 4) × (Fin 4 × Fin 4) × (Fin 4 × Fin 4)) × ((Fin 4 × Fin 4) × (Fin 4 × Fin 4) × (Fin 4 × Fin 4))) => x.ofLp p) h
    simpa [featureVec_ofLp] using this
  · intro h
    unfold featureVec
    exact congrArg _ (funext h)
#print axioms a34_shared_feature_ext

theorem a34_shared_fact :
    ∀ (X Y : Fin 4 → Matrix (Fin 4) (Fin 4) ℂ) (p : ((Fin 4 × Fin 4) × (Fin 4 × Fin 4) × (Fin 4 × Fin 4)) × ((Fin 4 × Fin 4) × (Fin 4 × Fin 4) × (Fin 4 × Fin 4))), mixedTriple (fun i : Fin 4 × Fin 4 => Matrix.of fun j k : Fin 4 × Fin 4 => X i.1 j.1 k.1 * Y i.2 j.2 k.2) p = mixedTriple X ((p.1.1.1, p.1.2.1.1, p.1.2.2.1), (p.2.1.1, p.2.2.1.1, p.2.2.2.1)) * mixedTriple Y ((p.1.1.2, p.1.2.1.2, p.1.2.2.2), (p.2.1.2, p.2.2.1.2, p.2.2.2.2)) := by
  intro X Y p
  obtain ⟨⟨a, b, c⟩, ⟨d, e, f⟩⟩ := p
  simp only [mixedTriple, Matrix.of_apply]
  ring
#print axioms a34_shared_fact

theorem a34_shared_prod_congr :
    ∀ X X' Y Y' : Fin 4 → Matrix (Fin 4) (Fin 4) ℂ, featureVec X = featureVec X' → featureVec Y = featureVec Y' → featureVec (fun i : Fin 4 × Fin 4 => Matrix.of fun j k : Fin 4 × Fin 4 => X i.1 j.1 k.1 * Y i.2 j.2 k.2) = featureVec (fun i : Fin 4 × Fin 4 => Matrix.of fun j k : Fin 4 × Fin 4 => X' i.1 j.1 k.1 * Y' i.2 j.2 k.2) := by
  intro X X' Y Y' hX hY
  rw [a34_shared_feature_ext]
  intro p
  rw [a34_shared_fact, a34_shared_fact, (a33_shared_feature_ext X X').1 hX, (a33_shared_feature_ext Y Y').1 hY]
#print axioms a34_shared_prod_congr

theorem a34_shared_inner_core :
    ∀ X Y X' Y' : Fin 4 → Matrix (Fin 4) (Fin 4) ℂ, inner ℂ (featureVec (fun i : Fin 4 × Fin 4 => Matrix.of fun j k : Fin 4 × Fin 4 => X i.1 j.1 k.1 * Y i.2 j.2 k.2)) (featureVec (fun i : Fin 4 × Fin 4 => Matrix.of fun j k : Fin 4 × Fin 4 => X' i.1 j.1 k.1 * Y' i.2 j.2 k.2)) = inner ℂ (featureVec X) (featureVec X') * inner ℂ (featureVec Y) (featureVec Y') := by
  intro X Y X' Y'
  simp only [featureVec, PiLp.inner_apply, RCLike.inner_apply, WithLp.ofLp_toLp]
  rw [Finset.sum_mul_sum, ← Fintype.sum_prod_type']
  exact Fintype.sum_equiv ⟨fun p : ((Fin 4 × Fin 4) × (Fin 4 × Fin 4) × (Fin 4 × Fin 4)) × ((Fin 4 × Fin 4) × (Fin 4 × Fin 4) × (Fin 4 × Fin 4)) => (((p.1.1.1, p.1.2.1.1, p.1.2.2.1), (p.2.1.1, p.2.2.1.1, p.2.2.2.1)), ((p.1.1.2, p.1.2.1.2, p.1.2.2.2), (p.2.1.2, p.2.2.1.2, p.2.2.2.2))), fun r : ((Fin 4 × Fin 4 × Fin 4) × (Fin 4 × Fin 4 × Fin 4)) × ((Fin 4 × Fin 4 × Fin 4) × (Fin 4 × Fin 4 × Fin 4)) => (((r.1.1.1, r.2.1.1), (r.1.1.2.1, r.2.1.2.1), (r.1.1.2.2, r.2.1.2.2)), ((r.1.2.1, r.2.2.1), (r.1.2.2.1, r.2.2.2.1), (r.1.2.2.2, r.2.2.2.2))), fun _ => rfl, fun _ => rfl⟩ _ _ (fun p => by simp only [Equiv.coe_fn_mk, a34_shared_fact, map_mul]; ring)
#print axioms a34_shared_inner_core

theorem a34_shared_dist_inner :
    ∀ {E : Type} [NormedAddCommGroup E] [InnerProductSpace ℂ E] (x y : E), dist x y ^ 2 = ‖x‖ ^ 2 + ‖y‖ ^ 2 - 2 * (inner ℂ x y).re := by
  intro E _ _ x y
  rw [dist_eq_norm, ← inner_self_eq_norm_sq (𝕜 := ℂ) (x - y), ← inner_self_eq_norm_sq (𝕜 := ℂ) x, ← inner_self_eq_norm_sq (𝕜 := ℂ) y, inner_sub_left, inner_sub_right, inner_sub_right, map_sub, map_sub, map_sub, inner_re_symm y x]
  simp only [RCLike.re_to_complex]
  ring
#print axioms a34_shared_dist_inner

theorem a34_shared_dist_of_sq :
    ∀ {E E' : Type} [MetricSpace E] [MetricSpace E'] (a b : E) (c d : E'), dist a b ^ 2 = dist c d ^ 2 → dist a b = dist c d := by
  intro E E' _ _ a b c d h
  have ha : 0 ≤ dist a b := dist_nonneg
  have hc : 0 ≤ dist c d := dist_nonneg
  rw [← Real.sqrt_sq ha, ← Real.sqrt_sq hc, h]
#print axioms a34_shared_dist_of_sq

theorem a34_shared_entry_norm :
    ∀ (Γ₀ : Matrix (Fin 4) (Fin 4) ℝ), Γ₀ = Matrix.of (fun _ _ => (1 / 4 : ℝ)) → ∀ G : Fin 4 → Matrix (Fin 4) (Fin 4) ℂ, RealizableGram (Fin 1) Γ₀ G → ∀ i j k : Fin 4, ‖G i j k‖ = 1 / 4 := by
  intro Γ₀ hΓ₀ G hG i j k
  obtain ⟨U, hU, hFU⟩ := sh1_sufficiency (0 : Fin 1) hG
  have hn : ∀ a : Fin 4, ‖U (i, 0) (a, 0)‖ = 1 / 2 := by
    intro a
    have h1 := hU.2 i a
    rw [Fin.sum_univ_one, hΓ₀] at h1
    simp only [Matrix.of_apply] at h1
    have h0 : 0 ≤ ‖U (i, 0) (a, 0)‖ := norm_nonneg _
    have h2 : (‖U (i, 0) (a, 0)‖ - 1 / 2) * (‖U (i, 0) (a, 0)‖ + 1 / 2) = 0 := by ring_nf; linarith
    rcases mul_eq_zero.1 h2 with h3 | h3
    · linarith
    · linarith
  rw [← hFU, fibreGram_apply, Fin.sum_univ_one, norm_mul, norm_star, hn j, hn k]
  norm_num
#print axioms a34_shared_entry_norm

theorem a34_shared_norm_sq_one :
    ∀ (Γ₀ : Matrix (Fin 4) (Fin 4) ℝ), Γ₀ = Matrix.of (fun _ _ => (1 / 4 : ℝ)) → ∀ G : Fin 4 → Matrix (Fin 4) (Fin 4) ℂ, RealizableGram (Fin 1) Γ₀ G → ∑ p : (Fin 4 × Fin 4 × Fin 4) × (Fin 4 × Fin 4 × Fin 4), ‖mixedTriple G p‖ ^ 2 = 1 := by
  intro Γ₀ hΓ₀ G hG
  have h : ∀ p : (Fin 4 × Fin 4 × Fin 4) × (Fin 4 × Fin 4 × Fin 4), ‖mixedTriple G p‖ = 1 / 64 := by
    intro p
    obtain ⟨⟨a, b, c⟩, ⟨d, e, f⟩⟩ := p
    simp only [mixedTriple]
    rw [norm_mul, norm_mul, a34_shared_entry_norm Γ₀ hΓ₀ G hG, a34_shared_entry_norm Γ₀ hΓ₀ G hG, a34_shared_entry_norm Γ₀ hΓ₀ G hG]
    norm_num
  simp only [h, Finset.sum_const, Finset.card_univ, Fintype.card_prod, Fintype.card_fin, nsmul_eq_mul]
  norm_num
#print axioms a34_shared_norm_sq_one

theorem a34_shared_norm_one :
    ∀ (Γ₀ : Matrix (Fin 4) (Fin 4) ℝ), Γ₀ = Matrix.of (fun _ _ => (1 / 4 : ℝ)) → ∀ G : Fin 4 → Matrix (Fin 4) (Fin 4) ℂ, RealizableGram (Fin 1) Γ₀ G → ‖featureVec G‖ = 1 := by
  intro Γ₀ hΓ₀ G hG
