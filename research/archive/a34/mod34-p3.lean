theorem a34_shared_real :
    ∀ G H : Fin 4 → Matrix (Fin 4) (Fin 4) ℂ, (∀ i, (G i).IsHermitian) → (∀ i, (H i).IsHermitian) → (inner ℂ (featureVec G) (featureVec H)).im = 0 := by
  intro G H hG hH
  have hg : ∀ (K : Fin 4 → Matrix (Fin 4) (Fin 4) ℂ), (∀ i, (K i).IsHermitian) → ∀ p : (Fin 4 × Fin 4 × Fin 4) × (Fin 4 × Fin 4 × Fin 4), mixedTriple K ((p.1.1, p.1.2.2, p.1.2.1), (p.2.2.1, p.2.1, p.2.2.2)) = star (mixedTriple K p) := by
    intro K hK p
    obtain ⟨⟨a, b, c⟩, ⟨d, e, f⟩⟩ := p
    simp only [mixedTriple]
    rw [star_mul', star_mul', (hK a).apply, (hK b).apply, (hK c).apply]
    ring
  have hsum : inner ℂ (featureVec G) (featureVec H) = (starRingEnd ℂ) (inner ℂ (featureVec G) (featureVec H)) := by
    simp only [featureVec, PiLp.inner_apply, RCLike.inner_apply, WithLp.ofLp_toLp, map_sum, map_mul, Complex.conj_conj]
    exact Fintype.sum_equiv ⟨fun p : (Fin 4 × Fin 4 × Fin 4) × (Fin 4 × Fin 4 × Fin 4) => ((p.1.1, p.1.2.2, p.1.2.1), (p.2.2.1, p.2.1, p.2.2.2)), fun p : (Fin 4 × Fin 4 × Fin 4) × (Fin 4 × Fin 4 × Fin 4) => ((p.1.1, p.1.2.2, p.1.2.1), (p.2.2.1, p.2.1, p.2.2.2)), fun _ => rfl, fun _ => rfl⟩ _ _ (fun p => by simp only [Equiv.coe_fn_mk, hg G hG p, hg H hH p, Complex.star_def, Complex.conj_conj]; try ring)
  exact Complex.conj_eq_iff_im.1 hsum.symm
#print axioms a34_shared_real

theorem a34_shared_hermitian :
