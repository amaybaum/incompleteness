/-! ### §A — the face generated by a state; the elementary scope; the localized principle -/

/-- The face of `Ω` generated by `m`: the states `z` beyond which `m` extends inside `Ω`. -/
def genFace (Ω : Set V) (m : V) : Set V :=
  {z ∈ Ω | ∃ ε : ℝ, 0 < ε ∧ m + ε • (m - z) ∈ Ω}

/-- **ELEM₂.** The body is generated, as a face, by two of its pure states: two distinct extreme points whose
midpoint is a state and not a boundary state. -/
def Elem2 (Ω : Set V) : Prop :=
  ∃ x ∈ Ω.extremePoints ℝ, ∃ y ∈ Ω.extremePoints ℝ, x ≠ y ∧
    midpoint ℝ x y ∈ Ω ∧ ¬ IsBoundaryState Ω (midpoint ℝ x y)

/-- **GEOM₂** (body form of the localized K∞-Geom). The face generated by any two distinct pure states is
relatively strictly convex. -/
def PairFaceStrictConvex (Ω : Set V) : Prop :=
  ∀ x ∈ Ω.extremePoints ℝ, ∀ y ∈ Ω.extremePoints ℝ, x ≠ y →
    RelStrictConvex (genFace Ω (midpoint ℝ x y))

/-- **SF₂** (effect form). Inside the face generated by two distinct pure states, every available effect that is
proper on that face is certain on at most one state. -/
def PairFaceSingleton (Ω : Set V) (avail : Set (V →ᵃ[ℝ] ℝ)) : Prop :=
  ∀ x ∈ Ω.extremePoints ℝ, ∀ y ∈ Ω.extremePoints ℝ, x ≠ y →
    SingletonFaces (genFace Ω (midpoint ℝ x y)) avail

/-- Transitivity on pure states (Masanes–Müller's "symmetry"). -/
def ExtremeTransitive (Ω : Set V) (G : Set (V ≃ᵃ[ℝ] V)) : Prop :=
  ∀ x ∈ Ω.extremePoints ℝ, ∀ y ∈ Ω.extremePoints ℝ, ∃ g ∈ G, g x = y

/-- Dense orbits on pure states. -/
def ExtremeDense (Ω : Set V) (G : Set (V ≃ᵃ[ℝ] V)) : Prop :=
  ∀ x ∈ Ω.extremePoints ℝ, ∀ y ∈ Ω.extremePoints ℝ, y ∈ closure ((fun g : V ≃ᵃ[ℝ] V => g x) '' G)

/-! ### §B — the elementary body is relatively strictly convex (Theorem B) -/

theorem genFace_subset (Ω : Set V) (m : V) : genFace Ω m ⊆ Ω := fun _ hz => hz.1

/-- When `m` is a state and not a boundary state, the face it generates is the whole body. -/
theorem genFace_eq_of_not_boundary {Ω : Set V} {m : V} (hm : m ∈ Ω) (h : ¬ IsBoundaryState Ω m) :
    genFace Ω m = Ω := by
  refine Set.Subset.antisymm (genFace_subset Ω m) (fun z hz => ⟨hz, ?_⟩)
  by_contra hno
  push_neg at hno
  exact h ⟨hm, z, hz, fun ε hε hmem => hno ε hε hmem⟩

/-- **Theorem B.** ELEM₂ and GEOM₂ make the body relatively strictly convex. -/
theorem relStrictConvex_of_elem2 {Ω : Set V} (hE : Elem2 Ω) (hG : PairFaceStrictConvex Ω) :
    RelStrictConvex Ω := by
  obtain ⟨x, hx, y, hy, hxy, hm, hnb⟩ := hE
  have h := hG x hx y hy hxy
  rwa [genFace_eq_of_not_boundary hm hnb] at h

/-- The effect form, with supporting-effect completeness on the body, gives the same conclusion
(Lemma C, KF:575, applied to the body, which is its own pair face). -/
theorem relStrictConvex_of_elem2_singleton {Ω : Set V} {avail : Set (V →ᵃ[ℝ] ℝ)} (hconv : Convex ℝ Ω)
    (hE : Elem2 Ω) (hSF : PairFaceSingleton Ω avail) (hSEC : SupportingEffectComplete Ω avail) :
    RelStrictConvex Ω := by
  obtain ⟨x, hx, y, hy, hxy, hm, hnb⟩ := hE
  have h := hSF x hx y hy hxy
  rw [genFace_eq_of_not_boundary hm hnb] at h
  exact relStrictConvex_of_supporting_singleton hconv hSEC h

/-! ### §C — K∞-Trans = RelStrictConvex + transitivity on pure states (Theorem A and its converse) -/

/-- A boundary state of a relatively strictly convex body is extreme. -/
theorem extreme_of_isBoundaryState_of_relStrictConvex {Ω : Set V} (h : RelStrictConvex Ω) {x : V}
    (hx : IsBoundaryState Ω x) : x ∈ Ω.extremePoints ℝ := by
  refine ⟨hx.1, fun x₁ hx₁ x₂ hx₂ hseg => ?_⟩
  by_cases h12 : x₁ = x₂
  · subst h12
    rw [openSegment_same] at hseg
    exact (Set.mem_singleton_iff.mp hseg).symm
  · obtain ⟨a, b, ha, hb, hab, hab'⟩ := hseg
    exact absurd (hab' ▸ hx) (h x₁ hx₁ x₂ hx₂ h12 a b ha hb hab).2

/-- **Theorem A (←).** Relative strict convexity and transitivity on pure states give boundary transitivity. -/
theorem boundaryTransitive_of_relStrictConvex {Ω : Set V} {G : Set (V ≃ᵃ[ℝ] V)} (h : RelStrictConvex Ω)
    (hT : ExtremeTransitive Ω G) : BoundaryTransitive Ω G :=
  fun x y hx hy => hT x (extreme_of_isBoundaryState_of_relStrictConvex h hx) y
    (extreme_of_isBoundaryState_of_relStrictConvex h hy)

/-- **Theorem A, dense form (←).** -/
theorem denseBoundaryOrbit_of_relStrictConvex {Ω : Set V} {G : Set (V ≃ᵃ[ℝ] V)} (h : RelStrictConvex Ω)
    (hT : ExtremeDense Ω G) : DenseOrbit.DenseBoundaryOrbit Ω G :=
  fun x y hx hy => hT x (extreme_of_isBoundaryState_of_relStrictConvex h hx) y
    (extreme_of_isBoundaryState_of_relStrictConvex h hy)

/-- **Theorem A (→), first half.** Under TRB-1's hypotheses boundary transitivity gives relative strict
convexity (boundary purity, TB:290). -/
theorem relStrictConvex_of_boundaryTransitive [Nontrivial V] {Ω : Set V} (hc : IsCompact Ω)
    (hconv : Convex ℝ Ω) (hi : (interior Ω).Nonempty) {G : Set (V ≃ᵃ[ℝ] V)} (hG : PreservesBody Ω G)
    (hT : BoundaryTransitive Ω G) : RelStrictConvex Ω := by
  intro x hx y hy hxy a b ha hb hab
  refine ⟨hconv hx hy ha.le hb.le hab, fun hbd => ?_⟩
  have hext := extreme_of_isBoundaryState_of_transitive hc hconv hi hG hT hbd
  have h1 : x = a • x + b • y := hext.2 hx hy ⟨a, b, ha, hb, hab, rfl⟩
  have h2 : y = a • x + b • y := hext.2 hy hx (by rw [openSegment_symm]; exact ⟨a, b, ha, hb, hab, rfl⟩)
  exact hxy (h1.trans h2.symm)

/-- **Theorem A (→), second half.** -/
theorem extremeTransitive_of_boundaryTransitive [Nontrivial V] {Ω : Set V} (hconv : Convex ℝ Ω)
    (hi : (interior Ω).Nonempty) {G : Set (V ≃ᵃ[ℝ] V)} (hT : BoundaryTransitive Ω G) :
    ExtremeTransitive Ω G :=
  fun x hx y hy => hT x y (isBoundaryState_of_extreme hconv hi hx) (isBoundaryState_of_extreme hconv hi hy)

