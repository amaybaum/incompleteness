/-! ### §E — QA2: label duals give seed-orbit availability on the chart -/

section LabelDual

open StageCompletion CompletionAction OrbitNormalization

variable {D : DirectedStages} (C : CompletionChart D)

/-- SA-LEDGER P-A (not landed): the operation pulls every stage effect back to a stage effect. -/
def LabelDual (T : OpDatum D) (σ : Label D → Label D) : Prop :=
  ∀ a x, T.τ x a = val D (σ a) x

/-- The stage effects read in the chart. -/
def chartEffects : Set ((Fin C.d → ℝ) →ᵃ[ℝ] (ℝ)) :=
  Set.range fun a : Label D => effR C.L C.p0 (coord D a)

/-- **Pullback of a stage effect along a label-dual datum is a stage effect** (as affine maps of the chart:
they agree on the generators `gen C x`, which affinely span the chart, CA:218). -/
theorem pullback_eq_of_labelDual {T : OpDatum D} (hT : AffineRespect T) {σ : Label D → Label D}
    (hσ : LabelDual T σ) (a : Label D) :
    (effR C.L C.p0 (coord D a)).comp (induced C T hT) = effR C.L C.p0 (coord D (σ a)) := by
  sorry -- UNBUILT: ext on `Set.range (gen C)` via `induced_gen` (CA:281), `hσ`, chart/coordsOf inverse on the body,
        -- then equality of affine maps agreeing on an affinely spanning set (`affineSpan_gen`, CA:218)

/-- **V4 from label duals.** If the inverse of every member of `G` is induced by a label-dual datum, every transport
of a stage-effect seed is a stage effect. -/
theorem seedOrbitAvailable_of_labelDual {G : Set ((Fin C.d → ℝ) ≃ᵃ[ℝ] (Fin C.d → ℝ))}
    (hG : ∀ g ∈ G, ∃ (T : OpDatum D) (hT : AffineRespect T) (σ : Label D → Label D),
      LabelDual T σ ∧ (g.symm : (Fin C.d → ℝ) →ᵃ[ℝ] (Fin C.d → ℝ)) = induced C T hT)
    (a : Label D) :
    SeedOrbitAvailable G (effR C.L C.p0 (coord D a)) (chartEffects C) := by
  intro g hg
  obtain ⟨T, hT, σ, hσ, hg'⟩ := hG g hg
  refine ⟨σ a, ?_⟩
  show effR C.L C.p0 (coord D (σ a)) = (effR C.L C.p0 (coord D a)).comp g.symm.toAffineMap
  rw [← pullback_eq_of_labelDual C hT hσ a]
  congr 1
  exact hg'.symm

end LabelDual

