theorem a40_shared_x_flat :
    ((Matrix.of fun a c : Fin 2 => (1 + Complex.I) / 2 * ![![(1 : ℂ), 1], ![1, -1]] a c) ∈ Matrix.unitaryGroup (Fin 2) ℂ ∧ ∀ a₁ c₁, ‖(Matrix.of fun a c : Fin 2 => (1 + Complex.I) / 2 * ![![(1 : ℂ), 1], ![1, -1]] a c) a₁ c₁‖ ^ 2 = 1 / (Fintype.card (Fin 2) : ℝ)) := by
