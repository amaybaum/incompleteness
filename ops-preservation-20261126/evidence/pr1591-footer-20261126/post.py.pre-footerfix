import json,subprocess,sys,unicodedata,re,os
HALT=os.environ.get('POST_HALT','/tmp/claude-0/-home-user-incompleteness/8a0f23ba-ffa7-50df-a785-676e090e9917/scratchpad/w2/HALT')
F="\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_"
def die(m):
    fd=os.open(HALT,os.O_CREAT|os.O_EXCL|os.O_WRONLY); os.write(fd,m.encode()); os.close(fd); print('HALT:',m); sys.exit(3)
if os.path.exists(HALT): print('halt marker present'); sys.exit(3)
issue,path=sys.argv[1],sys.argv[2]
body=open(path,encoding='utf-8').read()
if not body.endswith(F): die('body lacks footer form')
if '\r' in body or '@' in body or any(unicodedata.category(c)=='Cf' or (c.isspace() and ord(c)>127) for c in body): die('precheck')
for u in re.findall(r'https?://github\.com/[^\s)\]>`]+',body):
    if re.search(r'/(blob|tree)/',u) and len(u)>101 and '#' not in u: die('long link')
if body.lstrip().lower().startswith('oi-'): die('oi- form')
if '<!' in body:
    # Refused before any request; nothing is sent and no halt marker is written.
    # GitHub's write path removed the '!' of a '<!' sequence (comment 7172299731,
    # 2026-11-25); the writer rewords the text, the tool never escapes it.
    i=body.index('<!')
    print('REFUSED: the text contains the sequence \'<\' followed by \'!\' (first at character %d: %r). '
          'Nothing was sent. Reword the text so that no \'<\' is immediately followed by \'!\', then send it again.'
          % (i, body[max(0,i-30):i+30]))
    sys.exit(4)
import time
SINCE=time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime(time.time()-6*3600))
def find_existing():
    # exact-body match among the newest comments; never a retry
    # the issue-comments endpoint ignores sort; list by time window instead
    g=subprocess.run(['gh','api',f'repos/amaybaum/incompleteness/issues/{issue}/comments?since={SINCE}&per_page=100'],capture_output=True,text=True)
    if g.returncode: return None
    cs=json.loads(g.stdout)
    if len(cs)>=100: return None
    return [c['id'] for c in cs if c.get('body')==body]
pre=find_existing()
if pre is None: die('pre-write listing failed')
if pre: die(f'identical comment already exists: {pre}')
r=subprocess.run(['gh','api','-X','POST',f'repos/amaybaum/incompleteness/issues/{issue}/comments','--input','-'],input=json.dumps({'body':body}),capture_output=True,text=True)
if r.returncode:
    m=find_existing()
    if m and len(m)==1:
        cid=m[0]; print('NOTE: write reported failure; exactly one identical comment found:',cid)
    else:
        die('write failed/unknown, not resolvable by listing ('+str(m)+'): '+r.stderr[:200])
else:
    cid=json.loads(r.stdout)['id']
g=subprocess.run(['gh','api',f'repos/amaybaum/incompleteness/issues/comments/{cid}'],capture_output=True,text=True)
if g.returncode: die(f'readback failed for {cid}')
if json.loads(g.stdout)['body']!=body: die(f'MISMATCH comment {cid}')
print('OK',cid)
