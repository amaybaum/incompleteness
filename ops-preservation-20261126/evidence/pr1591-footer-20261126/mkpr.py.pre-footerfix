import json,subprocess,sys,unicodedata,re,os
HALT=S='/tmp/claude-0/-home-user-incompleteness/8a0f23ba-ffa7-50df-a785-676e090e9917/scratchpad/w2/HALT'
F="\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_"
def die(m):
    fd=os.open(HALT,os.O_CREAT|os.O_EXCL|os.O_WRONLY); os.write(fd,m.encode()); os.close(fd); print('HALT:',m); sys.exit(3)
if os.path.exists(HALT): print('halt marker present'); sys.exit(3)
head,base,title,path=sys.argv[1:5]
body=open(path,encoding='utf-8').read()
for t in (title,body):
    if '\r' in t or '@' in t or '<!' in t or any(unicodedata.category(c)=='Cf' or (c.isspace() and ord(c)>127 ) for c in t): print('REFUSED precheck; nothing sent'); sys.exit(4)
    if t.lstrip().lower().startswith('oi-'): print('REFUSED oi-'); sys.exit(4)
    for u in re.findall(r'https?://github\.com/[^\s)\]>`]+',t):
        if re.search(r'/(blob|tree)/',u) and len(u)>101 and '#' not in u: print('REFUSED long link'); sys.exit(4)
if not body.endswith(F) or '\n' in title: print('REFUSED form'); sys.exit(4)
ex=subprocess.run(['gh','api',f'repos/amaybaum/incompleteness/pulls?head=amaybaum:{head}&state=all'],capture_output=True,text=True)
if ex.returncode or json.loads(ex.stdout): die('existing PR for head or listing failed: '+ex.stdout[:200])
r=subprocess.run(['gh','api','-X','POST','repos/amaybaum/incompleteness/pulls','--input','-'],input=json.dumps({'title':title,'head':head,'base':base,'body':body,'draft':True}),capture_output=True,text=True)
if r.returncode: die('create failed/unknown: '+r.stderr[:300])
n=json.loads(r.stdout)['number']
g=subprocess.run(['gh','api',f'repos/amaybaum/incompleteness/pulls/{n}'],capture_output=True,text=True)
if g.returncode: die(f'readback failed PR {n}')
o=json.loads(g.stdout)
if o['body']!=body or o['title']!=title: die(f'MISMATCH PR {n}')
print('OK PR',n)
