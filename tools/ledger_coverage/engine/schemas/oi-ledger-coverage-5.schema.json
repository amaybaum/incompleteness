{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "oi-ledger-coverage/5",
 "type": "object",
 "required": [
  "schema",
  "outcome",
  "exit_status",
  "preflight",
  "record_checks",
  "items",
  "class_meaning"
 ],
 "properties": {
  "schema": {
   "const": "oi-ledger-coverage/5"
  },
  "outcome": {
   "enum": [
    "PASS",
    "REVIEW_REQUIRED",
    "FAIL",
    "USAGE",
    "ERROR",
    "VOID",
    "INTERNAL"
   ]
  },
  "exit_status": {
   "enum": [
    0,
    10,
    20,
    64,
    65,
    70,
    71
   ]
  },
  "operation": {
   "type": "string"
  },
  "preflight": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "passed"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "passed": {
      "type": "boolean"
     }
    }
   }
  },
  "record_checks": {
   "type": [
    "object",
    "null"
   ]
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "obligation",
     "class",
     "decision",
     "subject",
     "segment",
     "fingerprint"
    ],
    "properties": {
     "obligation": {
      "enum": [
       "HP",
       "RET",
       "TERMS",
       "RECORD",
       "MAIN",
       "DELEGATED"
      ]
     },
     "class": {
      "type": "string"
     },
     "decision": {
      "enum": [
       "FAIL",
       "REVIEW_REQUIRED"
      ]
     },
     "subject": {
      "type": "string"
     },
     "segment": {
      "type": [
       "string",
       "null"
      ]
     },
     "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     },
     "resolution_needed": {
      "type": [
       "object",
       "null"
      ]
     }
    }
   }
  },
  "engine": {
   "type": "object",
   "required": [
    "blob_sha256",
    "modules"
   ]
  },
  "config": {
   "type": "object",
   "required": [
    "config_id",
    "version",
    "path",
    "commit",
    "blob_sha256",
    "admission"
   ]
  },
  "adapters": {
   "type": "array"
  },
  "profiles": {
   "type": "array"
  },
  "sites": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "site_id",
     "pin_count",
     "ordinal",
     "pin_context_sha256",
     "meaning_context",
     "indicators",
     "provenance",
     "region_shared_with",
     "hp_overlap",
     "region_splices",
     "line_splices"
    ]
   }
  },
  "hits": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "file",
     "line",
     "line_sha256",
     "profiles",
     "tree",
     "state"
    ]
   }
  },
  "stop": {
   "type": "object",
   "required": [
    "class",
    "message"
   ]
  },
  "class_meaning": {
   "const": {
    "authorized-removal": "a site removed by a splice of the frozen ledger",
    "authorized-replacement": "a site replaced by a splice of the frozen ledger",
    "unauthorized-change": "a change that no splice of the frozen ledger and no declared class specifies",
    "unauthorized-edit": "a ledgered file whose bytes differ from H with the frozen ledger's splices applied"
   }
  }
 }
}
