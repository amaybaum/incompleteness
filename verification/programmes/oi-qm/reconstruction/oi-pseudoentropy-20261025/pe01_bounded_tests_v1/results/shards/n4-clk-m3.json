tive (it never gives a false COVERED tag) and tags only where lambda = n+1 is the earliest to fire. The exact comparison would use the closed-form K1 maximum over lambda; reading 'L1-L4' is the conservative form.","WIT-A":"Condition (a): which generators. Computed for the fixed G_lin(p_n), G_filt(p_n), G_clk(p_n); other family members enter through the K0 status only (conservative toward the claim under audit)."},"preflight":{"PIN":{"checkpoint":"PIN","code_commits":20,"pass":true,"plan_blob":"3ca81a0630777f1c89f031b42bb9d787a7dd0a04","plan_commit":"af38dc2dde0fbdd190a67debf700ab5c370f92d9","reasons":[],"run_commit":"549641460b8ddb536178f95fac2ec9390e84a987","run_tree":"128207bf572f2e4fb7d351599eb14b7b2c0caefe"},"TH":{"A2":{"a2_blob":"94d2fa2d3c8ce9ab9dffc0a791ac1a82dcc129b5","a2_commit":"826bd9babd92645b668e37735aee0dafd08cf4bc","checkpoint":"TH-A2","open_items":[],"pass":true,"reasons":[],"resolutions":{"B3W-K0":"exact-average+interval-worst","D-SIGN":"abs","LF-A":"passive","TAG-L":"L1-L4","WIT-A":"fixed-primary"},"source":"pinned"},"K_LP_by_n":{"3":3,"4":7,"5":15,"6":31},"a1_blob":"63191eeaa3d8c15280c7c962082ef9ba67a900b0","a1_commit":"1e025b672bdeb56e52f32d668f46320e8c4be06e","a1_commit_is_ancestor":true,"block":{"K_LP":"2^(n-1)-1","K_LP_by_n":{"3":3,"4":7,"5":15,"6":31},"amendment":"A1","m3_passive_K_cap":{"7":15,"8":31},"m3_passive_scope":"ii","theta":"n+1","theta_by_n":{"3":4,"4":5,"5":6,"6":7,"7":8,"8":9}},"checkpoint":"TH","m3_passive_K_cap":{"7":15,"8":31},"m3_passive_scope":"ii","pass":true,"reasons":[],"theta_by_n":{"3":4,"4":5,"5":6,"6":7,"7":8,"8":9}},"code_tree_clean":true},"recipe":"python3 -I -B verification/programmes/oi-qm/reconstruction/oi-pseudoentropy-20261025/pe01_bounded_tests_v1/run.py shard n4-clk-m3 --mode result --out <dir>","schema":"pe01-shard/2","shard":"n4-clk-m3","tree":"128207bf572f2e4fb7d351599eb14b7b2c0caefe"}
