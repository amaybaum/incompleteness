{
  "schema": "oret-phase-a-tuples/1",
  "status": "candidate freeze input; frozen together with PREREG-PHASE-A.md at the owner-designated commit F",
  "companions": {
    "prereg": "PREREG-PHASE-A.md",
    "design": "DESIGN-PULSE.md",
    "expected": "PHASEA-EXPECTED.json"
  },
  "conventions": {
    "eps_star": "1/20",
    "carrier_law": "uniform on the configurations of the carrier cells Sigma (implied by each law below)",
    "kappa": "sigma",
    "independence_law": "mu_t(. | sigma in P)",
    "support_conditioning": "supp Q_t, supp R_t (hence the pooled Q-sets and L-sets), C_t and eta are evaluated under mu_t(. | sigma in P)",
    "B_def": "Q = B = Par(A) minus A, computed from phi on all of S; Q is built from A as a whole, never from the read cells",
    "cell_order": "the order of the model's cells list; every configuration of a cell subset (A, Q, Sigma) lists its cells in this order",
    "config_encoding": "a configuration is the string of its cell bits in cell order",
    "decoder_encoding": "g is a string of length 2^|A|; character i (0-based) is g at the configuration of A whose bit string, read as a binary number with the first cell of A most significant, equals i",
    "tick_labels": "t0+n; the write tick is t0 -> t0+1; hold ticks of W_T are t0+1 .. t0+T",
    "rule_semantics": "steps are applied in order; within a step every assignment is simultaneous, so every right-hand side reads the state before that step; a cell not assigned in a step keeps its value",
    "expression_grammar": "cell names; 0; 1; a ^ b (xor); a & b (and); ite(c, a, b) = a if c = 1, else b; parentheses",
    "index_template": "an assignment with a range stands for one assignment for each index in the range; ring indices are taken mod the stated length",
    "law_types": {
      "uniform_conditioned": "the uniform probability on the states of S that satisfy every listed equality (pi_0 conditioned)",
      "uniform": "the uniform probability on S (pi_0)",
      "explicit": "each listed state (a configuration of the full cell list) has the listed probability; every other state has probability 0"
    },
    "P_encoding": "P lists carrier configurations over Sigma; f lists the carrier property for each, in the same order"
  },
  "order_rule": "Tuples run in increasing 'order'. Orders 1-31 are the non-HC-SK tuples in the listed sequence. Orders 32-49 are the HC-SK tuples sorted by n_bits = (T+1)(k+1)+1 = log2|S| ascending, with ties broken by k ascending; (n_bits, k) determines T, so the order is total.",
  "compared_fields": {
    "window": ["row", "eps_max", "tv", "Ra", "Rb", "dil_exact_T", "tau", "T_prime", "J1", "SCH", "Q_missing_T", "G_star_out_T", "G_status_T", "Q_missing_Tprime", "G_star_out_Tprime", "G_status_Tprime", "eta", "lemma_h_bound", "recurrence_flags", "D_bits", "method", "g", "write_min_eps", "w", "w_chg", "sweep_min_max_eps"],
    "noext": ["row", "eps_max", "tv", "Ra", "Rb", "dil_exact_T", "tau", "T_prime", "J1", "SCH", "Q_missing_T", "G_star_out_T", "G_status_T", "eta", "lemma_h_bound", "recurrence_flags", "D_bits", "method", "g", "write_min_eps"],
    "readback": ["row", "eps_max", "tv", "recurrence_flags", "method", "g"]
  },
  "field_definitions": {
    "eps_max, tv": "maps from each evaluated tick to a rational; evaluated ticks are W_{T'} in window mode, W_T in noext mode, and the readback ticks in readback mode; the key set is compared",
    "J1": "map from each hold tick (H_{T'} in window mode, H_T in noext mode) to {Ji, Jii} booleans",
    "SCH": "map from each hold tick of H_T to a boolean, over the tuple's read cells",
    "Q_missing_W": "configurations of Q (sorted) that are not in the pooled support Q-set of window W",
    "G_star_out_W": "configurations (sorted) in the pooled Q-set of W that are not in G*_W",
    "G_status_W": "empty if G*_W is empty; consistent if G*_W is nonempty and ~ over G*_W is consistent on L_W; inconsistent otherwise",
    "eta": "map from each hold tick of H_T to max over sigma of mu^P(Q_t not in G*_{W_T} | sigma)",
    "lemma_h_bound": "map from each tick t of W_T to eps_max(t0+1) plus the sum of eta over hold ticks s < t",
    "tau": "integer, or the string inf",
    "T_prime": "integer; null for a noext tuple assigned I-9",
    "D_bits": "integer number of bits of D(mu) = log2|S| - H(mu) at t0, or null if D(mu) is not an integer number of bits",
    "method": "full, sequential, or full+sequential (both computed and all compared fields equal)",
    "write_min_eps": "minimum over all decoders of A of eps_max(t0+1)",
    "w, w_chg": "HC-SK only: trigger probability at t0 under the unconditioned law, and the probability that the write changes r; null otherwise",
    "sweep_min_max_eps": "MD-xor only: minimum over all decoders of A of the maximum of eps_max over W_T; null otherwise",
    "recurrence_flags": "sorted list of evaluated ticks t with eps_max(t) <= eps_star that follow some evaluated t' < t with eps_max(t') > eps_star"
  },
  "models": {
    "ring-shift": {
      "cells": "u0 .. u{L-1}",
      "rule": [
        [{"lhs": "u{j}", "rhs": "u{(j-1) mod L}", "range": "j = 0 .. L-1"}]
      ],
      "source": "DESIGN-PULSE.md HC-TS"
    },
    "gate-shift": {
      "cells": "u0 .. u{L-1}",
      "rule": [
        [{"lhs": "u1", "rhs": "u1 ^ u0"}],
        [{"lhs": "u{j}", "rhs": "u{(j-1) mod L}", "range": "j = 0 .. L-1"}]
      ],
      "source": "ROUTES.md HC-P; DESIGN-PULSE.md HC-TM"
    },
    "gate-closed-ring": {
      "cells": "u0 .. u{L-1}, with L = m+3",
      "rule": [
        [{"lhs": "u1", "rhs": "u1 ^ u0"}],
        [
          {"lhs": "u1", "rhs": "u{m}"},
          {"lhs": "u{j}", "rhs": "u{j-1}", "range": "j = 2 .. m"},
          {"lhs": "u{m+1}", "rhs": "u0"},
          {"lhs": "u{j}", "rhs": "u{j-1}", "range": "j = m+2 .. L-1"},
          {"lhs": "u0", "rhs": "u{L-1}"}
        ]
      ],
      "source": "PREREG-PHASE-A.md 3.1, mutation (c)"
    },
    "share-completion": {
      "cells": "a, z0, z1, z2",
      "rule": [
        [{"lhs": "a", "rhs": "a ^ z0"}],
        [{"lhs": "z0", "rhs": "z2"}, {"lhs": "z1", "rhs": "z0"}, {"lhs": "z2", "rhs": "z1"}]
      ],
      "source": "PREREG-PHASE-A.md 3.1 (SC)"
    },
    "fredkin-channel": {
      "cells": "p0, v0, p1, v1, .., p{L-1}, v{L-1}, r",
      "rule": [
        [{"lhs": "v0", "rhs": "ite(p0, r, v0)"}, {"lhs": "r", "rhs": "ite(p0, v0, r)"}],
        [{"lhs": "p{j}", "rhs": "p{(j-1) mod L}", "range": "j = 0 .. L-1"}, {"lhs": "v{j}", "rhs": "v{(j-1) mod L}", "range": "j = 0 .. L-1"}]
      ],
      "source": "ROUTES.md M_F; DESIGN-PULSE.md S1, HC-R3"
    },
    "swapped-pair": {
      "cells": "p0, v0, p1, v1, p2, v2, r1, r2 (L = 3)",
      "rule": [
        [{"lhs": "v0", "rhs": "ite(p0, r1, v0)"}, {"lhs": "r1", "rhs": "ite(p0, v0, r1)"}],
        [{"lhs": "r1", "rhs": "r2"}, {"lhs": "r2", "rhs": "r1"}],
        [{"lhs": "p{j}", "rhs": "p{(j-1) mod 3}", "range": "j = 0 .. 2"}, {"lhs": "v{j}", "rhs": "v{(j-1) mod 3}", "range": "j = 0 .. 2"}]
      ],
      "source": "DESIGN-PULSE.md HC-SW"
    },
    "shift-out": {
      "cells": "p0, v0, p1, v1, p2, v2, r1, r2 (L = 3)",
      "rule": [
        [{"lhs": "v0", "rhs": "ite(p0, r1, v0)"}, {"lhs": "r1", "rhs": "ite(p0, v0, r1)"}],
        [{"lhs": "r1", "rhs": "v1"}, {"lhs": "r2", "rhs": "r1"}, {"lhs": "v1", "rhs": "r2"}],
        [{"lhs": "p{j}", "rhs": "p{(j-1) mod 3}", "range": "j = 0 .. 2"}, {"lhs": "v{j}", "rhs": "v{(j-1) mod 3}", "range": "j = 0 .. 2"}]
      ],
      "source": "PREREG-PHASE-A.md 3.1, mutation (b)"
    },
    "trigger-channel": {
      "cells": "for j = 0 .. L-1: p{j}_1, .., p{j}_k, v{j}; then r (L = T+1)",
      "rule": [
        [{"lhs": "v0", "rhs": "ite(p0_1 & .. & p0_k, r, v0)"}, {"lhs": "r", "rhs": "ite(p0_1 & .. & p0_k, v0, r)"}],
        [{"lhs": "p{j}_{i}", "rhs": "p{(j-1) mod L}_{i}", "range": "j = 0 .. L-1, i = 1 .. k"}, {"lhs": "v{j}", "rhs": "v{(j-1) mod L}", "range": "j = 0 .. L-1"}]
      ],
      "source": "DESIGN-PULSE.md HC-SK"
    },
    "conveyor": {
      "cells": "c, w0, w1, w2, w3",
      "rule": [
        [{"lhs": "w0", "rhs": "w0 ^ c"}],
        [{"lhs": "w{j}", "rhs": "w{(j-1) mod 4}", "range": "j = 0 .. 3"}]
      ],
      "source": "DESIGN-PULSE.md HC-R2"
    },
    "cx4b": {
      "cells": "r, s, y0, y1, z0, z1",
      "rule": [
        [{"lhs": "r", "rhs": "r ^ y0 ^ (z0 & s)"}],
        [{"lhs": "y0", "rhs": "y1"}, {"lhs": "y1", "rhs": "y0"}, {"lhs": "z0", "rhs": "z1"}, {"lhs": "z1", "rhs": "z0"}]
      ],
      "source": "DESIGN-PULSE.md CX-4b; concretized in PREREG-PHASE-A.md 3.1"
    }
  },
