/-! ### §A — the two data, and pair availability -/

/-- **OpDrive(θ₀)**: the token operator of `R_z(θ₀)` is available on the token alone at every
level. An introduced hypothesis. -/
def OpDrive (𝓘 : ImplementationClass) (arch : Architecture 𝓘) : Prop :=
  ∀ n : ℕ, TokenAvailAt 𝓘 arch zPh n

/-- **The J-datum**: the token operator of `J = cycEquiv` is available on the token alone at every
level. An introduced hypothesis. -/
def JDatum (𝓘 : ImplementationClass) (arch : Architecture 𝓘) : Prop :=
  ∀ n : ℕ, TokenAvailAt 𝓘 arch uJ n

variable {𝓘 : ImplementationClass} (arch : Architecture 𝓘)

theorem pairAvail_of_opDrive (hc : ContextStable 𝓘) (hl : LabelInvariant 𝓘)
    (h : OpDrive 𝓘 arch) (n : ℕ) : PairAvailAt 𝓘 arch zPh n :=
  pairAvail_of_tokenAvail arch hc hl (h n)

theorem pairAvail_of_jDatum (hc : ContextStable 𝓘) (hl : LabelInvariant 𝓘)
    (h : JDatum 𝓘 arch) (n : ℕ) : PairAvailAt 𝓘 arch uJ n :=
  pairAvail_of_tokenAvail arch hc hl (h n)

/-- OpDrive(θ₀) is exactly the pair availability of `R_z(θ₀)` at every level. -/
theorem opDrive_iff_pairAvail (hc : ContextStable 𝓘) (hl : LabelInvariant 𝓘) :
    OpDrive 𝓘 arch ↔ ∀ n : ℕ, PairAvailAt 𝓘 arch zPh n :=
  ⟨fun h n => pairAvail_of_tokenAvail arch hc hl (h n),
    fun h n => tokenAvail_of_pairAvail arch hl (h n)⟩

theorem jDatum_iff_pairAvail (hc : ContextStable 𝓘) (hl : LabelInvariant 𝓘) :
    JDatum 𝓘 arch ↔ ∀ n : ℕ, PairAvailAt 𝓘 arch uJ n :=
  ⟨fun h n => pairAvail_of_tokenAvail arch hc hl (h n),
    fun h n => tokenAvail_of_pairAvail arch hl (h n)⟩

/-! ### §B — membership at the token carrier -/

/-- The `(k, k)` ancilla block of `c • (U ⊗ 1ₙ)` is `c • U`. -/
theorem ancBlock_smul_tokOp (c : ℂ) (U : Matrix (Fin 2) (Fin 2) ℂ) {n : ℕ} (k : Fin n) :
    ancBlock (c • tokOp U n) k k = c • U := by
  ext s t
  first
  | (simp only [ancBlock, Matrix.of_apply, Matrix.smul_apply, tokOp, tensorOf_apply,
      Matrix.one_apply_eq, mul_one]; done)
  | simp [ancBlock, tokOp, tensorOf_apply]

/-- **THE RAY STEP AT THE TOKEN**: token availability at a positive level puts a nonzero multiple of
the operator into the class at `Fin 2` (the kernel's `exists_scaled_mem_of_instAvail_unitary` at
`Fin 2 × Fin n`, then the architecture's block clause). -/
theorem exists_scaled_mem_of_tokenAvail {U : Matrix (Fin 2) (Fin 2) ℂ} {n : ℕ} (hn : 0 < n)
    (h : TokenAvailAt 𝓘 arch U n) : ∃ c : ℂ, c ≠ 0 ∧ 𝓘 (Fin 2) (c • U) := by
  haveI : Nonempty (Fin 2 × Fin n) := ⟨(0, ⟨0, hn⟩)⟩
  have h' : InstAvail 𝓘 (Fin 2 × Fin n) Unit (fun _ => conjChannel (tokOp U n)) := h
  obtain ⟨c, hc, hmem⟩ := exists_scaled_mem_of_instAvail_unitary arch h'
  refine ⟨c, hc, ?_⟩
  have hb := arch.block (Fin 2) n (c • tokOp U n) ⟨0, hn⟩ ⟨0, hn⟩ hmem
  rw [ancBlock_smul_tokOp] at hb
  exact hb

/-- Under unitary-ray saturation (I4.134) the unitary itself is a member. -/
theorem mem_of_tokenAvail (hsat : UnitaryRaySaturated 𝓘) {U : Matrix (Fin 2) (Fin 2) ℂ}
    (hU : Uᴴ * U = 1) {n : ℕ} (hn : 0 < n) (h : TokenAvailAt 𝓘 arch U n) : 𝓘 (Fin 2) U := by
  obtain ⟨c, hc, hmem⟩ := exists_scaled_mem_of_tokenAvail arch hn h
  exact hsat (Fin 2) c U hc hU hmem

/-! ### §C — the two transferred tables -/

/-- The operator of `R_z(θ₀)` is the dictionary's phase at the 3-4-5 point. -/
theorem zPh_eq_zPhase : zPh = BridgeDictionary.zPhase (3 / 5) (4 / 5) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    first
    | rfl
    | (simp [zPh, BridgeDictionary.zPhase, w345]; done)
    | (simp [zPh, BridgeDictionary.zPhase, w345]; push_cast; ring)
    | (simp [zPh, BridgeDictionary.zPhase, w345, Matrix.diagonal_apply]; push_cast; ring)

/-- The operator of `J` is the equivalence thread's `cycMat`. -/
theorem uJ_eq_cycMat : uJ = EqvK2Converse.cycMat := rfl

/-- `transferMap zPh` is the target rotation `R_z(θ₀)` on tables. -/
theorem transferMap_zPh (ω : W 3) :
    BridgeConverge.transferMap zPh ω = actT (BridgeDictionary.rotZ (3 / 5) (4 / 5)) ω := by
  refine BridgeConverge.dict_injective ?_
  rw [BridgeConverge.dict_transferMap, zPh_eq_zPhase, BridgeDictionary.dict_actT_rotZ_345]

/-- `transferMap uJ` is the target cyclic permutation `J` on tables. -/
theorem transferMap_uJ (ω : W 3) :
    BridgeConverge.transferMap uJ ω
      = actT (KInfFoundations.cycEquiv : (Fin 3 → ℝ) →ₗ[ℝ] (Fin 3 → ℝ)) ω := by
  refine BridgeConverge.dict_injective ?_
  rw [BridgeConverge.dict_transferMap, uJ_eq_cycMat, BridgeConverge.dict_converge,
    EqvK2Converse.dict_actT_cyc]

/-! ### §D — the derived half: availability ⇒ invariance, through the transfer clause -/

/-- **OpDrive(θ₀) GIVES THE INVARIANCE UNDER `actT R_z(θ₀)`** on every pair cone carrying the
class's transfer clause (hypotheses: I4.32 through the ray step, I4.134, OpDrive(θ₀), (T)_𝓘). -/
theorem transfer_of_opDrive (hsat : UnitaryRaySaturated 𝓘) (hD : OpDrive 𝓘 arch) {K : Set (W 3)}
    (hT : BridgeDictionary.TransferClause 𝓘 K) {ω : W 3} (hω : ω ∈ K) :
    actT (BridgeDictionary.rotZ (3 / 5) (4 / 5)) ω ∈ K := by
  have hmem : 𝓘 (Fin 2) zPh := mem_of_tokenAvail arch hsat zPh_unitary Nat.one_pos (hD 1)
  have h := (BridgeConverge.transferClause_iff 𝓘 K).mp hT zPh hmem zPh_unitary ω hω
  rw [transferMap_zPh] at h
  exact h

/-- **THE J-DATUM GIVES THE INVARIANCE UNDER `actT J`** on every pair cone carrying the class's
transfer clause. -/
theorem transfer_of_jDatum (hsat : UnitaryRaySaturated 𝓘) (hJ : JDatum 𝓘 arch) {K : Set (W 3)}
    (hT : BridgeDictionary.TransferClause 𝓘 K) {ω : W 3} (hω : ω ∈ K) :
    actT (KInfFoundations.cycEquiv : (Fin 3 → ℝ) →ₗ[ℝ] (Fin 3 → ℝ)) ω ∈ K := by
  have hmem : 𝓘 (Fin 2) uJ := mem_of_tokenAvail arch hsat uJ_unitary Nat.one_pos (hJ 1)
  have h := (BridgeConverge.transferClause_iff 𝓘 K).mp hT uJ hmem uJ_unitary ω hω
  rw [transferMap_uJ] at h
  exact h

/-- **THE DERIVED HALF**: OI (I4.32, I4.134) + {OpDrive(θ₀), the J-datum} + (T)_𝓘 ⇒ (T) for
`{R_z(θ₀), J}` on the pair cone. -/
theorem bridge_derived_half (hsat : UnitaryRaySaturated 𝓘) (hD : OpDrive 𝓘 arch)
    (hJ : JDatum 𝓘 arch) {K : Set (W 3)} (hT : BridgeDictionary.TransferClause 𝓘 K) :
    ∀ ω ∈ K, actT (BridgeDictionary.rotZ (3 / 5) (4 / 5)) ω ∈ K
      ∧ actT (KInfFoundations.cycEquiv : (Fin 3 → ℝ) →ₗ[ℝ] (Fin 3 → ℝ)) ω ∈ K :=
  fun ω hω => ⟨transfer_of_opDrive arch hsat hD hT hω, transfer_of_jDatum arch hsat hJ hT hω⟩

/-- **THE KERNEL'S OWN PAIR CONE**: at `Q3` the two invariances hold with no hypothesis — the transfer
clause is where a pair cone on `W 3` enters, and nothing else. -/
theorem Q3_two_invariant :
    ∀ ω ∈ EqvK2Schema.Q3, actT (BridgeDictionary.rotZ (3 / 5) (4 / 5)) ω ∈ EqvK2Schema.Q3
      ∧ actT (KInfFoundations.cycEquiv : (Fin 3 → ℝ) →ₗ[ℝ] (Fin 3 → ℝ)) ω ∈ EqvK2Schema.Q3 :=
  fun ω hω => ⟨BridgeConverge.Q3_phase_invariant (3 / 5) (4 / 5) (by norm_num) hω,
    (EqvK2Converse.Q3_aMiss 0 ω hω).2⟩

/-! ### §E — refutations and controls -/

/-- **FM REFUTES OpDrive(θ₀).** -/
theorem latticeClass_not_opDrive : ¬ OpDrive latticeClass latticeClass_arch :=
  fun h => (lattice_refutes Nat.one_pos).2.2.1 (h 1)

/-- **FM REFUTES THE J-DATUM.** -/
theorem latticeClass_not_jDatum : ¬ JDatum latticeClass latticeClass_arch :=
  fun h => (lattice_refutes Nat.one_pos).2.2.2 (h 1)

/-- The monomial interface satisfies OpDrive(θ₀) (its phase intervention at `θ₀`) and refutes the
J-datum. -/
theorem substratumClass_opDrive_not_jDatum :
    OpDrive substratumClass substratumClass_arch ∧ ¬ JDatum substratumClass substratumClass_arch :=
  ⟨fun n => substratum_tokenAvail_zPh n,
    fun h => (monomialInterface_split.2.2 1 Nat.one_pos).2.2.2 (h 1)⟩

/-- The full class satisfies both data (a positive control: both are satisfiable). -/
theorem fullClass_opDrive_jDatum :
    OpDrive fullClass fullClass_arch ∧ JDatum fullClass fullClass_arch := by
  constructor
  · intro n
    unfold TokenAvailAt
    exact SubstratumSource.genTheory_avail_conj fullClass_arch trivial
      (tokOp_isometry zPh_unitary n)
  · intro n
    unfold TokenAvailAt
    exact SubstratumSource.genTheory_avail_conj fullClass_arch trivial
      (tokOp_isometry uJ_unitary n)

/-- **THE EXCLUSION LEMMA**: a pair cone carrying the class's transfer clause and moved by
`actT R_z(θ₀)` refutes OpDrive(θ₀) for that class (K(Z_F)'s instance is `b20_bridge.py` P3). -/
theorem not_opDrive_of_moved (hsat : UnitaryRaySaturated 𝓘) {K : Set (W 3)}
    (hT : BridgeDictionary.TransferClause 𝓘 K) {ω : W 3} (hω : ω ∈ K)
    (hmoved : actT (BridgeDictionary.rotZ (3 / 5) (4 / 5)) ω ∉ K) : ¬ OpDrive 𝓘 arch :=
  fun hD => hmoved (transfer_of_opDrive arch hsat hD hT hω)

theorem not_jDatum_of_moved (hsat : UnitaryRaySaturated 𝓘) {K : Set (W 3)}
    (hT : BridgeDictionary.TransferClause 𝓘 K) {ω : W 3} (hω : ω ∈ K)
    (hmoved : actT (KInfFoundations.cycEquiv : (Fin 3 → ℝ) →ₗ[ℝ] (Fin 3 → ℝ)) ω ∉ K) :
    ¬ JDatum 𝓘 arch :=
  fun hJ => hmoved (transfer_of_jDatum arch hsat hJ hT hω)

