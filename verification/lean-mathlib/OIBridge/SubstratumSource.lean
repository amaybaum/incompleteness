/-! ### Section A — elementary drivability and quantum architectures -/

section Architecture

/-- **ELEMENTARY DRIVABILITY**: at every carrier the transition flows, the state exchanges,
and the quarter phases are admissible implementations. -/
def DrivesElementary (𝓘 : ImplementationClass) : Prop :=
  (∀ (S : Type) [Fintype S] [DecidableEq S] (a b : S) (t : ℝ),
    𝓘 S (flow (transition a b) t))
  ∧ (∀ (S : Type) [Fintype S] [DecidableEq S] (a b : S),
    𝓘 S (permMatrix (Equiv.swap a b)))
  ∧ (∀ (S : Type) [Fintype S] [DecidableEq S] (a : S), 𝓘 S (phaseGate a))

/-- **A QUANTUM ARCHITECTURE**: an implementation architecture that is context-, label- and
dagger-stable and drives the elementary transitions. -/
structure QuantumArchitecture (𝓘 : ImplementationClass) : Prop where
  arch : Architecture 𝓘
  context : ContextStable 𝓘
  label : LabelInvariant 𝓘
  dagger : DaggerStable 𝓘
  drives : DrivesElementary 𝓘

end Architecture

/-! ### Section B — the generated theory drives the elementary transitions -/

section Elementary

variable {𝓘 : ImplementationClass} (arch : Architecture 𝓘)
variable {A : Type} [Fintype A] [DecidableEq A]

/-- A one-outcome conjugation by an admissible isometry is available in the generated theory. -/
theorem genTheory_avail_conj {n : ℕ} {V : Matrix (A × Fin n) (A × Fin n) ℂ}
    (hV : 𝓘 (A × Fin n) V) (hiso : Vᴴ * V = 1) :
    (genTheory 𝓘 arch A).availExt n Unit (fun _ => conjChannel V) :=
  ⟨fun _ => realized_conj hV, fun X => by rw [Fintype.sum_unique]; exact conjChannel_trace V hiso X⟩

/-- **THE GENERATED THEORY DRIVES THE ELEMENTARY TRANSITIONS** when the class does. -/
theorem genTheory_elementary (hd : DrivesElementary 𝓘) :
    ElementaryTransitionRichness (genTheory 𝓘 arch A) := by
  intro n
  refine ⟨fun a b _ t => ?_, fun a b => ?_, fun a => ?_⟩
  · exact genTheory_avail_conj arch (hd.1 _ a b t)
      (flow_isometry _ (transition_hermitian a b) t)
  · exact genTheory_avail_conj arch (hd.2.1 _ a b) (permMatrix_isometry _)
  · exact genTheory_avail_conj arch (hd.2.2 _ a) (phaseGate_unitary a)

end Elementary

/-! ### Section C — the collapse: one object supplies all three principles -/

section Collapse

variable {𝓘 : ImplementationClass} {A : Type} [Fintype A] [DecidableEq A]

/-- **ONE SUBSTRATUM OBJECT SUPPLIES ALL THREE PRIMITIVE-SOURCE PRINCIPLES.** -/
theorem quantumArchitecture_supplies_all (hq : QuantumArchitecture 𝓘) :
    ReversibleImplementationLocality (genTheory 𝓘 hq.arch A)
      ∧ ElementaryTransitionRichness (genTheory 𝓘 hq.arch A)
      ∧ EmbeddedObservation (genTheory 𝓘 hq.arch A) :=
  ⟨genTheory_reversibleImplementationLocality 𝓘 hq.arch hq.context hq.label hq.dagger,
    genTheory_elementary hq.arch hq.drives,
    genTheory_embeddedObservation 𝓘 hq.arch hq.label⟩

/-- **A THEORY GENERATED BY A QUANTUM ARCHITECTURE IS FINITE OPERATIONAL QM.** -/
theorem genTheory_qm_of_quantumArchitecture [Nonempty A] (hq : QuantumArchitecture 𝓘) :
    ExactAllFiniteEndomorphicQuantumOps (genTheory 𝓘 hq.arch A) := by
  obtain ⟨hril, hetr, heo⟩ := quantumArchitecture_supplies_all (A := A) hq
  exact qm_of_oiPlusElem _ ⟨hril, hetr, heo⟩

end Collapse

/-! ### Section D — the full class is a quantum architecture; QM is generated -/

section Full

/-- The full class is an architecture. -/
theorem fullClass_arch : Architecture fullClass where
  one := fun _ _ _ => trivial
  mul := fun _ _ _ _ _ _ _ => trivial
  smul := fun _ _ _ _ _ _ => trivial
  proj := fun _ _ _ _ _ => trivial
  block := fun _ _ _ _ _ _ _ _ => trivial

theorem fullClass_drivesElementary : DrivesElementary fullClass :=
  ⟨fun _ _ _ _ _ _ => trivial, fun _ _ _ _ _ => trivial, fun _ _ _ _ => trivial⟩

/-- **THE FULL CLASS IS A QUANTUM ARCHITECTURE.** -/
theorem fullClass_quantumArchitecture : QuantumArchitecture fullClass where
  arch := fullClass_arch
  context := fullClass_contextStable
  label := fullClass_labelInvariant
  dagger := fullClass_daggerStable
  drives := fullClass_drivesElementary

variable {A : Type} [Fintype A] [DecidableEq A]

/-- **FINITE OPERATIONAL QM IS GENERATED BY A QUANTUM ARCHITECTURE.** -/
theorem qm_generated_by_quantumArchitecture [Nonempty A] (T : FiniteOperationalTheory A)
    (h : ExactAllFiniteEndomorphicQuantumOps T) :
    ∃ 𝓘 : ImplementationClass, QuantumArchitecture 𝓘 ∧ ImplementationGenerated T 𝓘 :=
  ⟨fullClass, fullClass_quantumArchitecture, generated_of_qm T h⟩

end Full

/-! ### Section E — the decisive property: the diagonal architecture is stable but not driving -/

section Decisive

/-- **THE DIAGONAL CLASS DOES NOT DRIVE THE ELEMENTARY TRANSITIONS**: the exchange of two
distinguishable states is off-diagonal. -/
theorem diagClass_not_drivesElementary : ¬ DrivesElementary diagClass := by
  intro h
  have hswap := h.2.1 (Fin 2) 0 1
  have h01 : permMatrix (Equiv.swap (0 : Fin 2) 1) 0 1 = 1 := by
    simp [permMatrix, Equiv.swap_apply_right]
  have := hswap 0 1 (by decide)
  rw [h01] at this
  exact one_ne_zero this

/-- **THE DIAGONAL ARCHITECTURE IS STABLE BUT NOT QUANTUM.** It is context-, label- and
dagger-stable, yet its generated theory is not finite operational QM — so elementary
drivability carries content the three stabilities do not. -/
theorem diagGen_not_quantumArchitectureGenerated :
    ContextStable diagClass ∧ LabelInvariant diagClass ∧ DaggerStable diagClass
      ∧ ¬ DrivesElementary diagClass
      ∧ ¬ ExactAllFiniteEndomorphicQuantumOps (genTheory diagClass diagClass_arch (Fin 2)) :=
  ⟨diagClass_contextStable, diagClass_labelInvariant, diagClass_daggerStable,
    diagClass_not_drivesElementary,
    fun h => diagGen_not_control (physical_of_exactAll _ h).2.2.1⟩

end Decisive

