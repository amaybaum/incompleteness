/-! #### The seventy-two ordered non-coincidences: `C_r ⊄ C_{r'}` for distinct representatives -/

theorem nc_0 : ∃ z : ℂ, star z * z = 1 ∧ ∀ z' : ℂ, star z' * z' = 1 →
    ¬ GramPhaseEquiv (fun i => (FibreGram (0 : Fin 1) (Matrix.of (fun p q : Fin 4 × Fin 1 =>
        (1 / 2 : ℂ) * !![1, 1, 1, 1; 1, z, -1, -z; 1, -1, 1, -1; 1, -z, -1, z] p.1 q.1))
          ((1 : Equiv.Perm (Fin 4)) i)).submatrix ⇑(1 : Equiv.Perm (Fin 4)) ⇑(1 : Equiv.Perm (Fin 4)))
      (fun i => (FibreGram (0 : Fin 1) (Matrix.of (fun p q : Fin 4 × Fin 1 =>
        (1 / 2 : ℂ) * !![1, 1, 1, 1; 1, z', -1, -z'; 1, -1, 1, -1; 1, -z', -1, z'] p.1 q.1))
          ((1 : Equiv.Perm (Fin 4)) i)).submatrix ⇑(Equiv.swap (2 : Fin 4) 3) ⇑(Equiv.swap (2 : Fin 4) 3)) := by
  refine ⟨Complex.I, by simp, fun z' hz' h => ?_⟩
  have hc := congrFun (mixedTriple_gauge h) ((0, 0, 1), (0, 0, 3))
  rw [core_const_3 z' hz', core_val_1] at hc
  norm_num [Complex.ext_iff] at hc

