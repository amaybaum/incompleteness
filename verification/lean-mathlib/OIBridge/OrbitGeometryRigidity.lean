/-- **`(swap 1 3, 1)` fixes the Fourier circle as a set of classes**, by `stab_row_swap13`. -/
theorem pred_row_swap13 :
    (∀ z : ℂ, star z * z = 1 → ∃ z' : ℂ, star z' * z' = 1 ∧
        GramPhaseEquiv (fun i => (FibreGram (0 : Fin 1) (Matrix.of (fun p q : Fin 4 × Fin 1 =>
        (1 / 2 : ℂ) * !![1, 1, 1, 1; 1, z, -1, -z; 1, -1, 1, -1; 1, -z, -1, z] p.1 q.1))
          ((Equiv.swap (1 : Fin 4) 3) i)).submatrix ⇑(1 : Equiv.Perm (Fin 4)) ⇑(1 : Equiv.Perm (Fin 4))) (FibreGram (0 : Fin 1) (Matrix.of (fun p q : Fin 4 × Fin 1 =>
        (1 / 2 : ℂ) * !![1, 1, 1, 1; 1, z', -1, -z'; 1, -1, 1, -1; 1, -z', -1, z'] p.1 q.1))))
      ∧ (∀ z' : ℂ, star z' * z' = 1 → ∃ z : ℂ, star z * z = 1 ∧
        GramPhaseEquiv (fun i => (FibreGram (0 : Fin 1) (Matrix.of (fun p q : Fin 4 × Fin 1 =>
        (1 / 2 : ℂ) * !![1, 1, 1, 1; 1, z, -1, -z; 1, -1, 1, -1; 1, -z, -1, z] p.1 q.1))
          ((Equiv.swap (1 : Fin 4) 3) i)).submatrix ⇑(1 : Equiv.Perm (Fin 4)) ⇑(1 : Equiv.Perm (Fin 4))) (FibreGram (0 : Fin 1) (Matrix.of (fun p q : Fin 4 × Fin 1 =>
        (1 / 2 : ℂ) * !![1, 1, 1, 1; 1, z', -1, -z'; 1, -1, 1, -1; 1, -z', -1, z'] p.1 q.1)))) := by
  constructor
  · intro z hz
    refine ⟨-z, by simpa using hz, ?_⟩
    rw [stab_row_swap13]
    exact gramPhaseEquiv_refl _
  · intro z' hz'
    refine ⟨-z', by simpa using hz', ?_⟩
    have h := stab_row_swap13 (-z')
    simp only [neg_neg] at h ⊢
    rw [h]
    exact gramPhaseEquiv_refl _

