{
  "schema": "oi-obl29-remedy-controls/draft",
  "status": "paper design; not implemented, not adopted; each control becomes an expectation row (runner null) only on adoption",
  "authority": "owner decision, amaybaum, received 2026-11-26T11:44Z, #1169 comment 7191104852, item 2",
  "base": "design r6 amendment 6 r5 at 1f5764572a98b7ae2f306e121e2e410f79c29daf",
  "fixture": "Fixture: H; a configuration K frozen at F (round branch from D on main) whose ledger carries edit e on path p; c0 = main at F's designation. f = an oi-review-record/1 file under verification/audits/r/ carrying a well-formed second-kind finding on e by an independent reviewer (verdict invalidates on <p>:scientific_effect, invalidated naming e, configuration naming K), reviewing reconciliation record q in the same directory. Unless stated, the run is op C execution with M = the last listed main commit and no REV.",
  "expected_vocabulary": {
    "outcome": "FAIL, ERROR, PASS or ANY, as in EXPECTATIONS.json; ERROR means no verdict",
    "classes_include": "result classes that must appear",
    "invariants.not_class": "classes that must not appear",
    "finding": "the category3.findings element for f: present_at_M and witness (R6.OBL29.8); binding run-level where stated",
    "finding_references": "number of distinct references carrying the finding"
  },
  "kinds": {
    "negative": "a removal that must not lift the block",
    "positive": "a legitimate disappearance or a baseline that must behave as stated",
    "countercase": "an adversarial attempt to defeat the remedy",
    "boundary": "documents the edge of R* or the scope point of sec. 5.4",
    "residual": "documents a residual the remedy does not cover"
  },
