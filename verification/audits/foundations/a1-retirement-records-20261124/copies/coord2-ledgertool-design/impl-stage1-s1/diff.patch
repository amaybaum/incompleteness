+                out = []
+                for p, v in sorted(files.items()):
+                    mode, b = _entry_bytes(v)
+                    out.append({'path': p, 'type': 'commit' if mode == '160000' else 'blob', 'mode': mode,
+                                'sha': git_blob(b)})
