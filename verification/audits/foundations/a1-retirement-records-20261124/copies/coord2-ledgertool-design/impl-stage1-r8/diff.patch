+def r7_n5_supersede(t):
+    """A supersession recorded more than once still only revokes, once, and never designates (sec. 6.3, K1)."""
+    def one():
+        w = t.world()
+        F = t.freeze(w)
+        F2 = t.freeze(w, extra={'syn/other.txt': b'2\n'})
+        w.designate(F)
