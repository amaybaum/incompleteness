+
+class Native:
+    """The disposable clones, the checker blobs from F and the run records of one tool run."""
+
+    def __init__(self, repo, repo_path, out, freeze, enabled, host=None, repo_id=None, why_disabled=None,
+                 replay=None):
+        self.repo = repo
+        self.repo_path = repo_path
