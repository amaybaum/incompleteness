+def cfg_field_run(t, cfg):
+    files = {t.p: sf.jb(cfg)}
+    c2 = t.repo.derive(t.c, files, parents=t.repo.parents(t.c))
+    old_c = t.c
+    t.c = c2
+    try:
+        w = t.world()
+        F = t.freeze(w)
+        w.designate(F)
+        code, res = t.run(w, F)
+    finally:
+        t.c = old_c
+    return code, stop(res)
