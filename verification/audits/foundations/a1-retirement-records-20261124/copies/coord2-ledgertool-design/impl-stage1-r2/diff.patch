+                       'created_at': c['created_at'], 'author_id': c['author_id'], 'first_line': first_line(c['body'])})
+    seen = {e['comment_id'] for e in events}
+    for ev in bound:
+        if ev['comment_id'] not in seen:
+            events.append({'kind': ev['kind'], 'commit': ev['commit'], 'by': ev.get('by'),
